---
import Layout from '../layouts/Layout.astro';
import Icon from '../components/Icon.astro';
import { path } from '../i18n';
---

<Layout lang="pt" route="home" title="Nota errada — 404" description="Esta página não existe." noindex>
  <section class="lost">
    <div class="wrap">
      <p class="eyebrow">404 · Wrong note</p>
      <h1>Nota <em>errada</em>.</h1>
      <p class="lead">
        Até os melhores pianistas falham uma de vez em quando. Esta página não existe — mas a música continua.
        <br /><span class="muted" lang="en">This page doesn’t exist — but the music goes on.</span>
      </p>
      <div class="btn-row">
        <a class="btn btn--gold" href={path('home', 'pt')}>Início <Icon name="arrow" /></a>
        <a class="btn" href={path('home', 'en')} lang="en">Home</a>
      </div>
    </div>
  </section>
</Layout>

<style>
  .lost {
    min-height: 90vh;
    display: grid;
    align-items: center;
    padding-top: var(--nav-h);
  }
  h1 em {
    color: var(--gold);
  }
  h1 {
    animation: wobble 2.6s ease-in-out infinite;
    transform-origin: left bottom;
  }
  @keyframes wobble {
    0%,
    70%,
    100% {
      transform: none;
    }
    75% {
      transform: rotate(-2deg) translateX(-4px);
    }
    85% {
      transform: rotate(1.5deg) translateX(3px);
    }
  }
</style>
