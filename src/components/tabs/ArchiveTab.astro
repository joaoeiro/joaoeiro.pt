---
/** Home-page section "Em arquivo": shows that have already happened. */
import Tab from '../Tab.astro';
import Posters from '../Posters.astro';
import { type Lang } from '../../i18n';
import image from '../../assets/joao-eiro-white-suit.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  en: {
    title: 'Archive',
    sub: 'The stages I’ve already played — past recitals, collaborations and concerts.',
  },
  pt: {
    title: 'Em arquivo',
    sub: 'Os palcos por onde já passei — recitais, colaborações e concertos anteriores.',
  },
}[lang];
---

<Tab lang={lang} section="archive" title={copy.title} sub={copy.sub} image={image} side="left" focus="35% 32%" credit={{ name: 'Rodrigo Simas', href: 'https://www.instagram.com/rodrigosimasphoto/' }}>
  <div class="tab-block">
    <Posters lang={lang} />
  </div>
</Tab>
