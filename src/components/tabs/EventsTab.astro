---
/** Home-page section: live piano for events, in short. */
import Tab from '../Tab.astro';
import Steps from '../Steps.astro';
import Icon from '../Icon.astro';
import { path, type Lang } from '../../i18n';

interface Props {
  lang: Lang;
  num: number;
}
const { lang, num } = Astro.props;

const copy = {
  en: {
    title: 'Events',
    sub: 'Live piano for weddings, private parties and corporate events.',
    lead: 'From the first notes of a wedding ceremony to the after-dinner of a company gala, live piano changes the air in the room. Every set is built around your guests and your moment.',
    typesLabel: 'Occasions',
    types: [
      { g: '♡', t: 'Weddings', d: 'Ceremony, cocktail, dinner and that special first-dance song.' },
      { g: '✧', t: 'Private parties', d: 'Birthdays and dinners, from elegant background to sing-along.' },
      { g: '☾', t: 'House concerts', d: 'An intimate recital in your living room for friends and family.' },
      { g: '◆', t: 'Corporate events', d: 'Galas, receptions, awards and launches, polished and discreet.' },
      { g: '⌂', t: 'Hotels & restaurants', d: 'Regular or seasonal piano sessions with a signature atmosphere.' },
      { g: '𝄢', t: 'Accompaniment', d: 'Piano for singers, choirs and instrumentalists.' },
    ],
    howLabel: 'How it works',
    steps: [
      { title: 'Tell me about it', text: 'Date, place, type of event and the atmosphere you imagine.' },
      { title: 'Proposal', text: 'Format, duration, repertoire ideas and technical needs.' },
      { title: 'Your music', text: 'We fine-tune the setlist together, special requests included.' },
      { title: 'The performance', text: 'Early arrival, sound check and music that follows your event.' },
    ],
    note: 'An acoustic piano at the venue, or a digital stage piano with sound system. Indoors and outdoors, from 30 minutes to a full evening.',
    more: 'Tell me about your event',
  },
  pt: {
    title: 'Eventos',
    sub: 'Piano ao vivo para casamentos, festas privadas e eventos corporativos.',
    lead: 'Das primeiras notas de uma cerimónia de casamento ao pós-jantar de uma gala de empresa, o piano ao vivo muda o ar da sala. Cada atuação é construída à volta dos teus convidados e do teu momento.',
    typesLabel: 'Ocasiões',
    types: [
      { g: '♡', t: 'Casamentos', d: 'Cerimónia, cocktail, jantar e aquela música especial para a primeira dança.' },
      { g: '✧', t: 'Festas privadas', d: 'Aniversários e jantares, do ambiente elegante ao momento de cantar em conjunto.' },
      { g: '☾', t: 'Concertos em casa', d: 'Um recital intimista na tua sala para amigos e família.' },
      { g: '◆', t: 'Eventos corporativos', d: 'Galas, receções, prémios e lançamentos, com uma presença cuidada e discreta.' },
      { g: '⌂', t: 'Hotéis & restaurantes', d: 'Sessões de piano regulares ou sazonais, com uma atmosfera única.' },
      { g: '𝄢', t: 'Acompanhamento', d: 'Piano para cantores, coros e instrumentistas.' },
    ],
    howLabel: 'Como funciona',
    steps: [
      { title: 'Conta-me', text: 'Data, local, tipo de evento e o ambiente que imaginas.' },
      { title: 'Proposta', text: 'Formato, duração, ideias de repertório e necessidades técnicas.' },
      { title: 'A tua música', text: 'Afinamos o alinhamento em conjunto, incluindo pedidos especiais.' },
      { title: 'A atuação', text: 'Chegada antecipada, teste de som e música que acompanha o teu evento.' },
    ],
    note: 'Piano acústico no local, ou piano digital de palco com sistema de som. Interior e exterior, de 30 minutos a uma noite inteira.',
    more: 'Fala-me do teu evento',
  },
}[lang];
---

<Tab lang={lang} section="events" num={num} title={copy.title} sub={copy.sub}>
  <p class="tab-lead">{copy.lead}</p>

  <div class="tab-block">
    <p class="eyebrow">{copy.typesLabel}</p>
    <div class="grid grid-3">
      {
        copy.types.map((w) => (
          <article class="card feature">
            <span class="feature__glyph" aria-hidden="true">
              {w.g}
            </span>
            <h3>{w.t}</h3>
            <p>{w.d}</p>
          </article>
        ))
      }
    </div>
  </div>

  <div class="tab-block">
    <p class="eyebrow">{copy.howLabel}</p>
    <Steps steps={copy.steps} />
    <p class="tab-note">{copy.note}</p>
  </div>

  <a class="tab-more" href={path('contact', lang) + '?s=events'}>{copy.more} <Icon name="arrow" size={18} /></a>
</Tab>
