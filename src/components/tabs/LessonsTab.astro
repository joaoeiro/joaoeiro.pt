---
/** Home-page section: piano lessons. */
import Tab from '../Tab.astro';
import Icon from '../Icon.astro';
import Testimonials from '../Testimonials.astro';
import { path, type Lang } from '../../i18n';
import image from '../../assets/joao-eiro-lesson.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  en: {
    title: 'Piano lessons',
    sub: 'The first lesson is always free and with no commitment — perfect for giving it a try!',
    body: [
      'I teach a little of every style, drawing on my experience and training in classical music and jazz, depending on what I find each student needs and on their preferences.',
      'My lessons include recitals with all the students (recommended, but not compulsory).',
      'I like students to choose the music, but I also suggest repertoire I find relevant to each student’s reality, and I teach all the theory they need to understand what they are playing.',
      'I teach people of all ages, with a particular focus on young adults, with whom my musical language can have the most impact, and I give beginner, intermediate and advanced lessons.',
      'I teach fluently in Portuguese and English, and I can also teach in Spanish and French.',
    ],
    expect: {
      title: 'What to expect from the lessons',
      items: [
        'Lessons tailored to you',
        'Learning to play songs quickly and effectively',
        'Learning to read sheet music',
        'Learning theory applied to music you know and love',
        'Building discipline and musicality',
      ],
    },
    notExpect: {
      title: 'What <em>not</em> to expect',
      items: [
        'Generic, one-size-fits-all teaching',
        'A passive process where you just do what I say',
        'Being made to play the repertoire I like',
        'Pressure to take exams or enter competitions',
        'Playing the way you want right from the first lesson — but you’ll walk out playing something!',
      ],
    },
    reviewsTitle: 'What <em>students say</em>',
    more: 'Tell me about the lessons you’re looking for',
  },
  pt: {
    title: 'Aulas de piano',
    sub: 'A primeira aula é sempre grátis e sem compromisso, ideal para experimentar!',
    body: [
      'Ensino um pouco de todos os estilos, baseado na minha experiência e aulas em música clássica e jazz, consoante as necessidades que encontro no aluno e a sua preferência.',
      'As minhas aulas incluem recitais com todos os alunos (recomendadas mas não obrigatórias).',
      'Gosto que sejam os alunos a escolher as músicas, mas também proponho repertório que acho relevante para a realidade do aluno, e ensino toda a teoria necessária para os alunos perceberem o que estão a tocar.',
      'Ensino pessoas de todas as idades, com especial foco em jovens adultos, com quem a minha linguagem musical pode ter mais impacto, e dou aulas de iniciação, nível intermédio e avançado.',
      'Dou aulas em português e em inglês, com fluência, e também posso ensinar em espanhol e em francês.',
    ],
    expect: {
      title: 'O que esperar das aulas?',
      items: [
        'Aulas adaptadas a ti',
        'Aprender a tocar músicas de forma rápida e eficaz',
        'Aprender a ler partituras',
        'Aprender teoria aplicada a músicas que conheces e de que gostas',
        'Desenvolver disciplina e musicalidade',
      ],
    },
    notExpect: {
      title: 'O que <em>não</em> esperar das aulas?',
      items: [
        'Fórmulas de ensino genéricas',
        'Um processo passivo em que só tens de fazer o que eu digo',
        'Teres de tocar o repertório de que eu gosto',
        'Pressão para fazer exames ou concursos',
        'Tocar como queres logo na primeira aula — mas sais de lá a tocar alguma coisa!',
      ],
    },
    reviewsTitle: 'O que dizem <em>os alunos</em>',
    more: 'Fala-me das aulas que procuras',
  },
}[lang];
---

<Tab lang={lang} section="lessons" title={copy.title} sub={copy.sub} image={image} side="right" focus="50% 45%">
  <div class="body">{copy.body.map((p) => <p class="tab-lead">{p}</p>)}</div>

  <div class="expect">
    {
      [
        { ...copy.expect, icon: 'check' as const, kind: 'yes' },
        { ...copy.notExpect, icon: 'cross' as const, kind: 'no' },
      ].map((col) => (
        <section class:list={['expect__col', `expect__col--${col.kind}`]}>
          <h3 set:html={col.title} />
          <ul>
            {col.items.map((item) => (
              <li>
                <Icon name={col.icon} size={20} class="expect__icon" />
                <span>{item}</span>
              </li>
            ))}
          </ul>
        </section>
      ))
    }
  </div>

  <Testimonials lang={lang} title={copy.reviewsTitle} />

  <a class="tab-more" href={path('contact', lang) + '?s=lessons'}>{copy.more} <Icon name="arrow" size={18} /></a>
</Tab>

<style>
  .body {
    display: grid;
    gap: 1.2rem;
  }
  .body p {
    text-align: justify;
    hyphens: auto;
  }
  /* What to expect / what not to expect, side by side (stacked on narrow screens). */
  .expect {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 18rem), 1fr));
    gap: clamp(1.5rem, 1rem + 2vw, 3rem);
    max-width: 62rem;
  }
  .expect__col {
    padding: clamp(1.3rem, 1rem + 1vw, 1.8rem);
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgb(var(--surface-rgb) / calc(0.03 * var(--surface-k)));
    box-shadow: var(--card-shadow);
  }
  .expect__col--yes {
    border-color: rgb(var(--accent-rgb) / 0.35);
  }
  h3 {
    margin: 0 0 1.1rem;
    font-size: clamp(1.3rem, 1.1rem + 0.6vw, 1.6rem);
    color: var(--ivory);
  }
  h3 :global(em) {
    color: var(--gold);
  }
  ul {
    display: grid;
    gap: 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }
  li {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.7rem;
    align-items: start;
    color: var(--ivory-dim);
    font-size: clamp(1rem, 0.95rem + 0.25vw, 1.15rem);
  }
  li :global(.expect__icon) {
    margin-top: 0.15em;
  }
  /* Ticks and crosses: the site's light blue in the dark theme, maroon in the light one. */
  .expect {
    --mark: #a3b8dc;
  }
  :global(:root[data-theme='light']) .expect {
    --mark: #800000;
  }
  li :global(.expect__icon) {
    color: var(--mark);
  }
</style>
