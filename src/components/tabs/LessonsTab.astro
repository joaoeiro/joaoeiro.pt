---
/** Home-page section: piano lessons. */
import Tab from '../Tab.astro';
import Icon from '../Icon.astro';
import { path, type Lang } from '../../i18n';
// Placeholder picture until the section's own photo arrives.
import image from '../../assets/joao-eiro-live.jpg';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  en: {
    title: 'Piano lessons',
    sub: 'The first lesson is always free and with no commitment — perfect for giving it a try!',
    body: [
      'I teach a little of every style, drawing on my experience and training in classical music and jazz, depending on what I find each student needs and on their preferences.',
      'My lessons include recitals with all the students (recommended, but not compulsory).',
      'I like students to choose the music, but I also suggest repertoire I find relevant to each student’s reality, and I teach all the theory they need to understand what they are playing.',
    ],
    more: 'Tell me about the lessons you’re looking for',
  },
  pt: {
    title: 'Aulas de piano',
    sub: 'A primeira aula é sempre grátis e sem compromisso, ideal para experimentar!',
    body: [
      'Ensino um pouco de todos os estilos, baseado na minha experiência e aulas em música clássica e jazz, consoante as necessidades que encontro no aluno e a sua preferência.',
      'As minhas aulas incluem recitais com todos os alunos (recomendadas mas não obrigatórias).',
      'Gosto que sejam os alunos a escolher as músicas, mas também proponho repertório que acho relevante para a realidade do aluno, e ensino toda a teoria necessária para os alunos perceberem o que estão a tocar.',
    ],
    more: 'Fala-me das aulas que procuras',
  },
}[lang];
---

<Tab lang={lang} section="lessons" title={copy.title} sub={copy.sub} image={image} side="right" focus="30% 20%">
  <div class="body">{copy.body.map((p) => <p class="tab-lead">{p}</p>)}</div>

  <a class="tab-more" href={path('contact', lang) + '?s=lessons'}>{copy.more} <Icon name="arrow" size={18} /></a>
</Tab>

<style>
  .body {
    display: grid;
    gap: 1.2rem;
  }
</style>
