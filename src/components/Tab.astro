---
/**
 * One expandable section of the home page. Closed, it is a photo band across the screen with
 * the title over it (on the left or the right, so consecutive sections zigzag) that grows on
 * hover; open, it shows the rest. Links to `#<anchor>` (the menu, old page addresses) open it in
 * place and scroll to it.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { sections, useT, type Lang, type SectionKey } from '../i18n';

interface Props {
  lang: Lang;
  section: SectionKey;
  title: string;
  sub: string;
  image: ImageMetadata;
  /** CSS object-position, to frame the picture. */
  focus?: string;
  /** Which side the picture's subject sits on; the title goes on the other side. */
  side?: 'left' | 'right';
  /** Who took the picture, credited under it on the right once the section is open. */
  credit?: { name: string; href?: string };
}
const { lang, section, title, sub, image, focus = '50% 40%', side = 'left', credit } = Astro.props;
const t = useT(lang);
const { en, pt, legacy = [] } = sections[section];
---

<details class:list={["tab", `tab--${side}`]} id={sections[section][lang]} name="sections" data-section={section} data-aliases={[en, pt, ...legacy].join(' ')}>
  <summary>
    <span class="tab__media">
      <span class="tab__frame">
        <Picture src={image} alt="" formats={['avif', 'webp']} widths={[640, 960, 1280, 1600, 2000]} sizes="100vw" style={`object-position: ${focus}`} />
      </span>
    </span>
    <span class="tab__head">
      <span class="tab__title">{title}</span>
      <span class="tab__sub">{sub}</span>
    </span>
    <span class="tab__icon" aria-hidden="true"></span>
    <span class="tab__probe" aria-hidden="true"></span>
  </summary>
  {
    credit && (
      <p class="tab__credit">
        {t('photo.by')}: {credit.href ? <a href={credit.href} target="_blank" rel="noopener">{credit.name}</a> : credit.name}
      </p>
    )
  }
  <div class="tab__body">
    <button type="button" class="tab__down" aria-label={t('tab.down')} tabindex="-1">
      <svg viewBox="0 0 24 24" width="28" height="28" aria-hidden="true"><path fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round" d="m6 9.5 6 6 6-6" /></svg>
    </button>
    <slot />
  </div>
</details>

<script>
  const tabs = [...document.querySelectorAll<HTMLDetailsElement>('details.tab')];
  const sideTab = document.querySelector<HTMLAnchorElement>('.side-tab');
  const sideHref = sideTab?.href.split('?')[0];
  const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

  const find = (hash: string) => tabs.find((t) => t.id === hash || t.dataset.aliases!.split(' ').includes(hash));

  // Bring an open section into view with the start of what it reveals showing too: the bottom
  // of its band (where the title sits) lands a little past the middle of the screen, so the
  // text below peeks in and it's clear something opened. A band short enough to fit with room
  // to spare just goes to the top (under the menu). The band may still be growing, so its
  // opened height is read off a hidden probe. Wait a frame so a section closing above it has
  // collapsed first, otherwise the page would land off target.
  const REVEAL_AT = 0.6;
  const reveal = (tab: HTMLDetailsElement) =>
    requestAnimationFrame(() => {
      const menu = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      const band = tab.querySelector<HTMLElement>('.tab__probe')!.offsetHeight;
      const at = Math.min(menu, innerHeight * REVEAL_AT - band);
      scrollTo({ top: scrollY + tab.getBoundingClientRect().top - at, behavior: smooth });
    });

  // While an open section's text is mostly still below the screen, a small arrow bounces just
  // under its band (on larger screens, see the CSS); it goes once the reader scrolls into the
  // text, and clicking it scrolls there.
  const hint = (tab: HTMLDetailsElement) => {
    const body = tab.querySelector<HTMLElement>('.tab__body')!;
    const r = body.getBoundingClientRect();
    tab.classList.toggle('tab--hint', tab.open && r.top > innerHeight * 0.35 && r.bottom > innerHeight);
  };
  addEventListener('scroll', () => tabs.forEach((t) => t.classList.contains('tab--hint') && hint(t)), { passive: true });
  tabs.forEach((tab) =>
    tab.querySelector('.tab__down')!.addEventListener('click', () => {
      const menu = parseFloat(getComputedStyle(document.documentElement).scrollPaddingTop) || 0;
      scrollTo({ top: scrollY + tab.querySelector('.tab__body')!.getBoundingClientRect().top - menu, behavior: smooth });
    }),
  );

  // Open a section. One open further up the page closes at once, and the page is shifted by
  // what it took up so the chosen section stays where it was on screen; from there it glides
  // to the top. (Left to the browser, the section would jump up by the closed one's height
  // and only then start scrolling, towards a target still moving as the old band shrinks.)
  const show = (tab: HTMLDetailsElement) => {
    const others = tabs.filter((t) => t !== tab && t.open);
    if (others.length) {
      const root = document.documentElement;
      const before = tab.getBoundingClientRect().top;
      root.style.overflowAnchor = 'none';
      others.forEach((t) => {
        t.classList.add('tab--snap');
        t.open = false;
      });
      scrollBy({ top: tab.getBoundingClientRect().top - before, behavior: 'instant' });
      requestAnimationFrame(() => {
        root.style.overflowAnchor = '';
        others.forEach((t) => t.classList.remove('tab--snap'));
      });
    }
    tab.open = true; // the toggle handler below scrolls it into place
  };

  const open = (tab: HTMLDetailsElement) => {
    if (tab.open) reveal(tab);
    else show(tab);
  };

  // Clicking a closed section's band opens it through show(), before the browser's own
  // one-open-at-a-time rule (name="sections") would close the other one abruptly.
  tabs.forEach((tab) =>
    tab.querySelector('summary')!.addEventListener('click', (e) => {
      if (tab.open) return;
      e.preventDefault();
      show(tab);
    }),
  );

  // Opening one section closes the others and brings it into view; the address and the
  // contact tab follow the open one.
  tabs.forEach((tab) =>
    tab.addEventListener('toggle', () => {
      if (tab.open) {
        tabs.forEach((t) => t !== tab && (t.open = false));
        reveal(tab);
        hint(tab);
        history.replaceState(null, '', `#${tab.id}`);
      } else {
        tab.classList.remove('tab--hint');
        if (location.hash === `#${tab.id}`) history.replaceState(null, '', location.pathname + location.search);
      }
      const current = tabs.find((t) => t.open)?.dataset.section;
      if (sideTab && sideHref) {
        sideTab.href = current === 'lessons' ? `${sideHref}?s=lessons` : sideHref;
      }
    }),
  );

  // Same-page links to a section (menu, cards): open it instead of jumping.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
    if (!link) return;
    const url = new URL(link.href);
    const tab = url.pathname === location.pathname && find(decodeURIComponent(url.hash.slice(1)));
    if (!tab) return;
    e.preventDefault();
    open(tab);
  });

  const fromHash = () => {
    const tab = find(decodeURIComponent(location.hash.slice(1)));
    if (tab) open(tab);
  };
  addEventListener('hashchange', fromHash);
  fromHash();
</script>

<style>
  /* Each section is a photo band across the whole screen, title over it; it grows on hover. */
  summary {
    --closed: clamp(240px, 9rem + 16vw, 440px);
    --opened: clamp(440px, 72vh, 780px);
    /* Lines the text up with the page's content column. */
    --inset: max(1.25rem, (100vw - 1200px) / 2);
    position: relative;
    isolation: isolate;
    display: flex;
    align-items: flex-end;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    height: var(--closed);
    margin-inline: calc(50% - 50vw);
    padding: clamp(1.5rem, 1rem + 2.5vw, 3.5rem) var(--inset);
    overflow: hidden;
    list-style: none;
    cursor: pointer;
    transition: height 0.9s var(--ease);
  }
  .tab {
    margin-bottom: 6px;
  }
  .tab--left summary {
    justify-content: flex-end;
  }
  .tab[open] summary {
    height: var(--opened);
  }
  @media (hover: hover) {
    summary:hover {
      height: var(--opened);
    }
  }
  /* As tall as the open band, for the script to measure while the band is still growing. */
  .tab__probe {
    position: absolute;
    top: 0;
    width: 0;
    height: var(--opened);
    visibility: hidden;
  }
  .tab__media {
    position: absolute;
    inset: 0;
    z-index: -2;
    background: #18151f;
  }
  .tab__media :global(picture) {
    display: contents;
  }
  .tab__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transform: scale(1.02);
    transition: transform 1.2s var(--ease);
  }
  summary:hover .tab__media :global(img),
  .tab[open] .tab__media :global(img) {
    transform: scale(1.07);
  }
  /* Shade on the text's side, so the title reads over any photo. */
  summary::after {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background:
      linear-gradient(to top, rgb(7 6 10 / 0.7), transparent 55%),
      linear-gradient(to right, rgb(7 6 10 / 0.75), transparent 65%);
    transition: opacity 0.6s;
  }
  .tab--left summary::after {
    background:
      linear-gradient(to top, rgb(7 6 10 / 0.7), transparent 55%),
      linear-gradient(to left, rgb(7 6 10 / 0.75), transparent 65%);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid #f3d79a;
    outline-offset: -6px;
  }
  .tab__head {
    display: grid;
    gap: 0.5rem;
    max-width: 38rem;
  }
  .tab--left .tab__head {
    text-align: right;
  }
  /* Same type as the home page's intro line (the body font), just large. */
  .tab__title {
    font-family: var(--font-body);
    font-weight: 400;
    letter-spacing: -0.02em;
    font-size: clamp(2.2rem, 1.3rem + 3.6vw, 5rem);
    line-height: 1;
    color: #f4ecdc;
    text-shadow: 0 2px 24px rgb(0 0 0 / 0.35);
    transition: color 0.3s;
  }
  /* The site's sand background colour. */
  summary:hover .tab__title,
  .tab[open] .tab__title {
    color: #d7cfc4;
  }
  .tab__sub {
    color: rgb(244 236 220 / 0.85);
    font-size: 1rem;
  }
  /* A plus that turns into a minus. */
  .tab__icon {
    position: relative;
    flex: none;
    width: 3rem;
    height: 3rem;
    border: 1px solid rgb(244 236 220 / 0.45);
    border-radius: 50%;
    backdrop-filter: blur(4px);
    transition: border-color 0.3s, background-color 0.3s;
  }
  /* The + sits in the bottom corner across from the title. */
  .tab--right .tab__icon {
    margin-left: auto;
  }
  .tab--left .tab__icon {
    order: -1;
    margin-right: auto;
  }
  .tab__icon::before,
  .tab__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 1rem;
    height: 1.5px;
    background: #f3d79a;
    translate: -50% -50%;
    transition: transform 0.4s var(--ease);
  }
  .tab__icon::after {
    transform: rotate(90deg);
  }
  .tab[open] .tab__icon::after {
    transform: rotate(0deg);
  }
  summary:hover .tab__icon {
    border-color: #f3d79a;
    background: rgb(7 6 10 / 0.3);
  }
  .tab__body {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-block: clamp(2.5rem, 2rem + 2vw, 4rem) clamp(3rem, 2rem + 3vw, 5rem);
  }
  .tab[open] .tab__body {
    animation: tabIn 0.6s var(--ease);
  }
  /* The arrow that says there's more below (see hint() above): only on larger screens, where
     the open band takes up most of the screen; it fades in once the section has settled. */
  .tab__body {
    position: relative;
  }
  .tab__down {
    display: none;
  }
  @media (min-width: 601px) {
    .tab__down {
      position: absolute;
      top: 0.4rem;
      left: 50%;
      display: grid;
      place-items: center;
      width: 2.6rem;
      height: 2.6rem;
      padding: 0;
      border: 0;
      background: none;
      color: var(--gold);
      cursor: pointer;
      opacity: 0;
      pointer-events: none;
      translate: -50% 0;
      transition: opacity 0.4s;
    }
    .tab--hint .tab__down {
      opacity: 0.85;
      pointer-events: auto;
      transition-delay: 0.9s;
      animation: tabDown 1.8s ease-in-out infinite;
    }
    .tab__down:hover {
      opacity: 1;
    }
  }
  @keyframes tabDown {
    50% {
      transform: translateY(6px);
    }
  }
  @keyframes tabIn {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  /* Credit under the open picture, small, on the right. */
  .tab__credit {
    margin: 0.5rem 0 0;
    text-align: right;
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
  }
  .tab[open] .tab__credit {
    animation: tabIn 0.6s var(--ease);
  }
  .tab__credit a {
    color: var(--ivory-dim);
    text-decoration: underline;
    text-decoration-color: var(--gold-2);
    text-underline-offset: 0.2em;
    transition: color 0.3s;
  }
  .tab__credit a:hover {
    color: var(--gold-2);
  }
  /* A section closed to make way for another snaps shut (see show() above). */
  .tab--snap summary,
  .tab--snap .tab__media :global(img) {
    transition: none;
  }
  @media (prefers-reduced-motion: reduce) {
    summary,
    .tab__media :global(img) {
      transition: none;
    }
    .tab--hint .tab__down {
      animation: none;
    }
  }
  /* Shared building blocks for the sections' content. */
  .tab__body :global(.tab-lead) {
    max-width: 60ch;
    margin: 0;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    color: var(--ivory-dim);
  }
  .tab__body :global(.tab-block > .eyebrow) {
    margin-bottom: 1.4rem;
  }
  .tab__body :global(.tab-more) {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold);
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.15rem;
  }
  .tab__body :global(.tab-note) {
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 600px) {
    summary {
      --closed: clamp(220px, 64vw, 320px);
      --opened: clamp(300px, 90vw, 440px);
      gap: 0.9rem;
      /* Keep the + clear of the contact tab on the screen's edge. */
      padding-right: 2.6rem;
    }
    .tab__icon {
      width: 2.4rem;
      height: 2.4rem;
    }
    .tab__title {
      font-size: 2.3rem;
    }
    .tab__sub {
      font-size: 0.9rem;
    }
    /* Narrow bands: title always bottom left, shade from below. */
    .tab--left summary {
      justify-content: flex-start;
    }
    .tab--left .tab__head {
      text-align: left;
    }
    .tab--left .tab__icon {
      order: 0;
      margin: 0 0 0 auto;
    }
    summary::after,
    .tab--left summary::after {
      background: linear-gradient(to top, rgb(7 6 10 / 0.85), rgb(7 6 10 / 0.35) 55%, transparent 80%);
    }
    .tab__credit {
      font-size: 0.65rem;
    }
  }
</style>
