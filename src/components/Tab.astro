---
/**
 * One expandable section of the home page. Closed, it shows a picture beside a short text
 * (on the left or the right, so consecutive sections zigzag); open, it shows the rest. Links to `#<anchor>` (the menu, old page addresses) open it in
 * place and scroll to it.
 */
import { Picture } from 'astro:assets';
import type { ImageMetadata } from 'astro';
import { sections, useT, type Lang, type SectionKey } from '../i18n';

interface Props {
  lang: Lang;
  section: SectionKey;
  title: string;
  sub: string;
  image: ImageMetadata;
  /** CSS object-position, to frame the picture. */
  focus?: string;
  /** Which side the picture sits on. */
  side?: 'left' | 'right';
  /** Who took the picture, credited at the end of the open section. */
  credit?: { name: string; href?: string };
}
const { lang, section, title, sub, image, focus = '50% 40%', side = 'left', credit } = Astro.props;
const t = useT(lang);
const { en, pt, legacy = [] } = sections[section];
---

<details class:list={["tab", `tab--${side}`]} id={sections[section][lang]} name="sections" data-section={section} data-aliases={[en, pt, ...legacy].join(' ')}>
  <summary>
    <span class="tab__media">
      <Picture src={image} alt="" formats={['avif', 'webp']} widths={[320, 640, 960]} sizes="(max-width: 600px) 110px, 320px" style={`object-position: ${focus}`} />
    </span>
    <span class="tab__head">
      <span class="tab__title">{title}</span>
      <span class="tab__sub">{sub}</span>
    </span>
    <span class="tab__icon" aria-hidden="true"></span>
  </summary>
  <div class="tab__body">
    <slot />
    {
      credit && (
        <p class="tab__credit">
          {t('photo.by')}: {credit.href ? <a href={credit.href} target="_blank" rel="noopener">{credit.name}</a> : credit.name}
        </p>
      )
    }
  </div>
</details>

<script>
  const tabs = [...document.querySelectorAll<HTMLDetailsElement>('details.tab')];
  const sideTab = document.querySelector<HTMLAnchorElement>('.side-tab');
  const sideHref = sideTab?.href.split('?')[0];
  const smooth = matchMedia('(prefers-reduced-motion: reduce)').matches ? 'auto' : 'smooth';

  const find = (hash: string) => tabs.find((t) => t.id === hash || t.dataset.aliases!.split(' ').includes(hash));

  // Bring a section's title to the top of the page (just under the menu). Wait a frame so a
  // section closing above it has collapsed first, otherwise the page would land off target.
  const toTop = (tab: HTMLDetailsElement) =>
    requestAnimationFrame(() => tab.scrollIntoView({ behavior: smooth, block: 'start' }));

  const open = (tab: HTMLDetailsElement) => {
    if (tab.open) toTop(tab);
    else tab.open = true; // the toggle handler below scrolls it into place
  };

  // Opening one section closes the others and lines it up at the top; the address and the
  // contact tab follow the open one.
  tabs.forEach((tab) =>
    tab.addEventListener('toggle', () => {
      if (tab.open) {
        tabs.forEach((t) => t !== tab && (t.open = false));
        toTop(tab);
        history.replaceState(null, '', `#${tab.id}`);
      } else if (location.hash === `#${tab.id}`) {
        history.replaceState(null, '', location.pathname + location.search);
      }
      const current = tabs.find((t) => t.open)?.dataset.section;
      if (sideTab && sideHref) {
        sideTab.href = current === 'lessons' ? `${sideHref}?s=lessons` : sideHref;
      }
    }),
  );

  // Same-page links to a section (menu, cards): open it instead of jumping.
  document.addEventListener('click', (e) => {
    const link = (e.target as Element).closest<HTMLAnchorElement>('a[href*="#"]');
    if (!link) return;
    const url = new URL(link.href);
    const tab = url.pathname === location.pathname && find(decodeURIComponent(url.hash.slice(1)));
    if (!tab) return;
    e.preventDefault();
    open(tab);
  });

  const fromHash = () => {
    const tab = find(decodeURIComponent(location.hash.slice(1)));
    if (tab) open(tab);
  };
  addEventListener('hashchange', fromHash);
  fromHash();
</script>

<style>
  summary {
    --media: clamp(140px, 100px + 14vw, 320px);
    display: grid;
    grid-template-columns: var(--media) 1fr auto;
    grid-template-areas: 'media head icon';
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2.5vw, 3rem);
    padding-block: clamp(1.5rem, 1rem + 2vw, 3rem);
    list-style: none;
    cursor: pointer;
  }
  .tab--right summary {
    grid-template-columns: 1fr auto var(--media);
    grid-template-areas: 'head icon media';
  }
  .tab__media {
    grid-area: media;
    display: block;
    aspect-ratio: 4 / 3;
    overflow: hidden;
    border-radius: 14px;
    background: var(--ink-3);
  }
  .tab__media :global(picture) {
    display: contents;
  }
  .tab__media :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.8s var(--ease);
  }
  summary:hover .tab__media :global(img) {
    transform: scale(1.05);
  }
  summary::-webkit-details-marker {
    display: none;
  }
  summary:focus-visible {
    outline: 2px solid var(--gold-2);
    outline-offset: 4px;
    border-radius: 6px;
  }
  .tab__head {
    grid-area: head;
    display: grid;
    gap: 0.4rem;
  }
  .tab__title {
    font-family: var(--font-display);
    font-size: clamp(2rem, 1.3rem + 2.8vw, 3.8rem);
    line-height: 1.05;
    color: var(--ivory);
    transition: color 0.3s;
  }
  summary:hover .tab__title,
  .tab[open] .tab__title {
    color: var(--gold);
  }
  .tab__sub {
    max-width: 52ch;
    color: var(--muted);
    font-size: 0.98rem;
  }
  /* A plus that turns into a minus. */
  .tab__icon {
    grid-area: icon;
    position: relative;
    width: 2.6rem;
    height: 2.6rem;
    border: 1px solid var(--line);
    border-radius: 50%;
    transition: border-color 0.3s, background-color 0.3s;
  }
  .tab__icon::before,
  .tab__icon::after {
    content: '';
    position: absolute;
    inset: 50% auto auto 50%;
    width: 0.9rem;
    height: 1.5px;
    background: var(--gold);
    translate: -50% -50%;
    transition: transform 0.4s var(--ease);
  }
  .tab__icon::after {
    transform: rotate(90deg);
  }
  .tab[open] .tab__icon::after {
    transform: rotate(0deg);
  }
  summary:hover .tab__icon {
    border-color: var(--gold);
  }
  .tab__body {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
    padding-bottom: clamp(3rem, 2rem + 3vw, 5rem);
  }
  .tab[open] .tab__body {
    animation: tabIn 0.6s var(--ease);
  }
  @keyframes tabIn {
    from {
      opacity: 0;
      transform: translateY(-12px);
    }
  }
  .tab__credit {
    /* Sits closer to the content than the body's gap would put it. */
    margin: calc(-1 * clamp(1.5rem, 1rem + 1.5vw, 2.5rem)) 0 0;
    font-size: 0.8rem;
    color: var(--muted);
  }
  .tab__credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 0.15em;
  }
  .tab__credit a:hover {
    color: var(--gold-2);
  }
  /* Shared building blocks for the sections' content. */
  .tab__body :global(.tab-lead) {
    max-width: 60ch;
    margin: 0;
    font-size: clamp(1.1rem, 1rem + 0.4vw, 1.3rem);
    color: var(--ivory-dim);
  }
  .tab__body :global(.tab-block > .eyebrow) {
    margin-bottom: 1.4rem;
  }
  .tab__body :global(.tab-more) {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold);
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.15rem;
  }
  .tab__body :global(.tab-note) {
    margin: 1.2rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  @media (max-width: 600px) {
    summary {
      --media: 88px;
      gap: 0.9rem;
      /* Keep the + clear of the contact tab on the screen's edge. */
      padding-right: 1.6rem;
    }
    .tab__icon {
      width: 2rem;
      height: 2rem;
    }
    .tab__title {
      font-size: 1.7rem;
    }
    .tab__sub {
      font-size: 0.9rem;
    }
  }
</style>
