---
/** Review cards: stars, the review, and who wrote it (with an initial in a circle). */
import { pick, type Lang } from '../i18n';
import { testimonials } from '../data/testimonials';
import { published } from '../lib/drafts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const items = published(testimonials);
const outOf = lang === 'pt' ? 'de 5 estrelas' : 'out of 5 stars';
---

{
  items.length > 0 && (
    <div class="quotes">
      {items.map((q, i) => (
        <figure class="quote card reveal" style={`--i:${i}`}>
          {q.rating && (
            <p class="stars" aria-label={`${q.rating} ${outOf}`}>
              {Array.from({ length: 5 }, (_, s) => (
                <span aria-hidden="true" class:list={{ off: s >= q.rating! }}>
                  ★
                </span>
              ))}
            </p>
          )}
          <blockquote>“{pick(q.quote, lang)}”</blockquote>
          <figcaption>
            <span class="avatar" aria-hidden="true">
              {q.author.charAt(0)}
            </span>
            <span class="who">
              <strong>{q.author}</strong>
              <span>{pick(q.role, lang)}</span>
            </span>
          </figcaption>
        </figure>
      ))}
    </div>
  )
}

<style>
  .quotes {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 340px), 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .quote {
    display: grid;
    gap: 1.2rem;
    margin: 0;
  }
  .stars {
    margin: 0;
    font-size: 1.15rem;
    letter-spacing: 0.15em;
    color: #c99a2e;
  }
  .stars .off {
    color: var(--line);
  }
  blockquote {
    margin: 0;
    font-size: 1.02rem;
    line-height: 1.65;
    color: var(--ivory-dim);
  }
  figcaption {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    padding-top: 1.1rem;
    border-top: 1px solid var(--line);
  }
  .avatar {
    display: grid;
    place-items: center;
    flex: none;
    width: 2.6rem;
    height: 2.6rem;
    border-radius: 50%;
    background: #800000;
    color: #f6efe6;
    font-family: var(--font-display);
    font-size: 1.3rem;
  }
  .who {
    display: grid;
    gap: 0.1rem;
    font-size: 0.95rem;
  }
  .who span {
    color: var(--muted);
    font-size: 0.85rem;
  }
</style>
