---
/**
 * Student reviews on a full-width maroon band inside the piano-lessons section:
 * stars, the review, and who wrote it. On the English site the reviews are
 * translations, and a note says so.
 */
import { pick, type Lang } from '../i18n';
import { testimonials } from '../data/testimonials';
import { published } from '../lib/drafts';

interface Props {
  lang: Lang;
  /** Heading; `<em>` marks the highlighted words. */
  title: string;
}
const { lang, title } = Astro.props;
const items = published(testimonials);
const outOf = lang === 'pt' ? 'de 5 estrelas' : 'out of 5 stars';
---

{
  items.length > 0 && (
    <div class="reviews">
      <div class="inner">
      <h3 set:html={title} />
      <div class="list">
        {items.map((q) => (
          <figure class="review">
            {q.rating && (
              <p class="stars" aria-label={`${q.rating} ${outOf}`}>
                {Array.from({ length: 5 }, (_, s) => (
                  <span aria-hidden="true" class:list={{ off: s >= q.rating! }}>
                    ★
                  </span>
                ))}
              </p>
            )}
            <blockquote>“{pick(q.quote, lang)}”</blockquote>
            <figcaption>
              <strong>{q.author}</strong>
              <span>{pick(q.role, lang)}</span>
            </figcaption>
          </figure>
        ))}
      </div>
      {lang === 'en' && <p class="note">Reviews translated from Portuguese.</p>}
      </div>
    </div>
  )
}

<style>
  /* A full-width maroon band, breaking out of the section's column; fixed brand colours. */
  .reviews {
    --band-text: #d7cfc4;
    --band-accent: #a3b8dc;
    margin-inline: calc(50% - 50vw);
    padding: clamp(3.5rem, 2.5rem + 4vw, 6rem) calc(50vw - 50%);
    background: #800000;
    color: var(--band-text);
  }
  .inner {
    display: grid;
    gap: clamp(1.5rem, 1.2rem + 1vw, 2.2rem);
    max-width: 62rem;
  }
  h3 {
    margin: 0;
    font-size: clamp(1.8rem, 1.4rem + 1.4vw, 2.6rem);
    color: var(--band-text);
  }
  h3 :global(em) {
    font-style: italic;
    color: var(--band-accent);
  }
  .list {
    display: grid;
    gap: clamp(2rem, 1.6rem + 1.5vw, 3rem);
  }
  .review {
    display: grid;
    gap: 0.8rem;
    margin: 0;
  }
  .stars {
    margin: 0;
    font-size: 1rem;
    letter-spacing: 0.18em;
    color: var(--band-accent);
  }
  .stars .off {
    opacity: 0.3;
  }
  blockquote {
    margin: 0;
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 1.1rem + 0.6vw, 1.6rem);
    font-style: italic;
    line-height: 1.45;
  }
  figcaption {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.3rem 0.8rem;
    font-size: 0.95rem;
  }
  figcaption strong {
    font-weight: 600;
  }
  figcaption span {
    font-size: 0.78rem;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    opacity: 0.75;
  }
  .note {
    margin: 0;
    font-size: 0.85rem;
    opacity: 0.75;
  }
</style>
