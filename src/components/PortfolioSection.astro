---
/**
 * Home-page videos (the old Portfolio): an inviting title and the Instagram videos on a full-width
 * maroon band (like the student reviews), then photos. Each video shows its cover; a click plays it in place. Always open, unlike the
 * expandable sections above it.
 */
import Icon from './Icon.astro';
import { asset, pick, sections, useT, type Lang } from '../i18n';
import { instagram } from '../data/media';
import { gallery } from '../data/gallery';
import { published } from '../lib/drafts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const videos = published(instagram);
/** Instagram's own player for a post, used when there is no local video file. */
const embed = (url: string) => url.split('?')[0].replace(/\/?$/, '/') + 'embed/';

const copy = {
  en: {
    title: 'Hear me play',
    photosLabel: 'Gallery',
  },
  pt: {
    title: 'Ouve-me a tocar',
    photosLabel: 'Galeria',
  },
}[lang];
---

<div class="portfolio" id={sections.portfolio[lang]}>
  {/* Older links to this band (e.g. /pt/#portfolio) still land here. */}
  {sections.portfolio.legacy?.filter((a) => a !== sections.portfolio[lang]).map((a) => <span id={a} />)}
  {
    videos.length > 0 && (
      <div class="band">
        <h2 class="band__title">{copy.title}</h2>
        <div class="reels">
          {videos.map((v) => (
            <figure class="reel-item">
              <button
                type="button"
                class="reel"
                data-video={v.video && asset(v.video)}
                data-embed={v.video ? undefined : embed(v.url)}
                aria-label={`${t('media.play')}: ${v.title}${v.artist ? `, ${v.artist}` : ''}`}
              >
                <img src={asset(v.cover)} alt={pick(v.caption, lang)} loading="lazy" decoding="async" />
                <span class="reel__play">
                  <Icon name="play" size={26} />
                </span>
              </button>
              <figcaption>
                <span class="reel__text">
                  <span class="reel__title">{v.title}</span>
                  {v.artist && <span class="reel__artist">{v.artist}</span>}
                </span>
                <a class="reel__link" href={v.url} target="_blank" rel="noopener" aria-label={`${t('media.instagram')}: ${v.title}`}>
                  <Icon name="instagram" size={20} />
                </a>
              </figcaption>
            </figure>
          ))}
        </div>
      </div>
    )
  }

  {
    gallery.length > 0 && (
      <div class="tab-block">
        <p class="eyebrow">{copy.photosLabel}</p>
        <div class="photos">
          {gallery.map((g) => (
            <figure class:list={[{ wide: g.wide }]}>
              <img src={asset(g.src)} alt={g.alt} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </div>
    )
  }
</div>

<script>
  // Cover first; the video (or Instagram's player) only after a click.
  document.querySelectorAll<HTMLButtonElement>('.reel').forEach((btn) =>
    btn.addEventListener('click', () => {
      const wrap = document.createElement('div');
      wrap.className = 'reel is-playing';
      const { video, embed } = btn.dataset;
      if (video) {
        const el = document.createElement('video');
        el.src = video;
        el.controls = true;
        el.autoplay = true;
        el.playsInline = true;
        wrap.appendChild(el);
      } else if (embed) {
        const el = document.createElement('iframe');
        el.src = embed;
        el.title = btn.getAttribute('aria-label') ?? 'Instagram';
        el.allow = 'autoplay; encrypted-media; picture-in-picture';
        el.allowFullscreen = true;
        wrap.appendChild(el);
      }
      btn.replaceWith(wrap);
      wrap.querySelector('video')?.play().catch(() => {});
    }),
  );
</script>

<style>
  .portfolio {
    position: relative;
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  /* The old-link anchors sit at the top without taking up a row (and the gap after it). */
  .portfolio > span {
    position: absolute;
    top: 0;
  }
  .tab-block > .eyebrow {
    margin-bottom: 1.4rem;
  }
  /* A full-width maroon band, breaking out of the section's column; same colour as the reviews band. */
  .band {
    margin-inline: calc(50% - 50vw);
    padding: clamp(3rem, 2rem + 4vw, 5.5rem) calc(50vw - 50%);
    background: #800000;
  }
  .band__title {
    margin: 0 0 clamp(1.5rem, 1rem + 2vw, 2.5rem);
    /* The body font, in wide-tracked capitals. */
    font-family: var(--font-body);
    font-size: clamp(1.8rem, 1.2rem + 2.2vw, 3rem);
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.1em;
    line-height: 1.05;
    color: #f4ecdc;
  }
  .band :global(.reels) {
    display: grid;
    /* Six videos: one row of six on wide screens, two rows of three in between, three rows of two on phones. */
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 0.8rem + 1vw, 1.5rem);
  }
  @media (min-width: 1000px) {
    .band :global(.reels) {
      grid-template-columns: repeat(6, minmax(0, 1fr));
    }
  }
  .reel-item {
    margin: 0;
    display: grid;
    gap: 0.75rem;
    align-content: start;
  }
  .reel-item figcaption {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 0.5rem;
    line-height: 1.3;
    color: #f4ecdc;
  }
  .reel__text {
    display: grid;
    gap: 0.15rem;
    min-width: 0;
  }
  /* The post on Instagram: the icon alone, with a comfortable tap area. */
  .reel__link {
    flex: none;
    display: grid;
    place-items: center;
    width: 36px;
    height: 36px;
    margin: -6px -8px 0 0;
    border-radius: 50%;
    opacity: 0.8;
    transition: opacity 0.3s, background-color 0.3s;
  }
  .reel__link:hover,
  .reel__link:focus-visible {
    opacity: 1;
    background: rgb(255 255 255 / 0.12);
  }
  .reel__title {
    font-weight: 600;
  }
  .reel__artist {
    font-size: 0.875em;
    opacity: 0.75;
  }
  .band :global(.reel) {
    position: relative;
    aspect-ratio: 9 / 16;
    overflow: hidden;
    padding: 0;
    border: 0;
    border-radius: var(--radius);
    background: #000;
    cursor: pointer;
  }
  .band :global(.reel) img,
  .band :global(.reel video),
  .band :global(.reel iframe) {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
    object-fit: cover;
  }
  .band :global(.reel) img {
    transition: transform 1.2s var(--ease);
  }
  .band :global(.reel:hover) img {
    transform: scale(1.06);
  }
  .band :global(.reel video) {
    object-fit: contain;
  }
  .band :global(.reel__play) {
    position: absolute;
    left: 50%;
    top: 50%;
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    translate: -50% -50%;
    border-radius: 50%;
    background: rgb(0 0 0 / 0.55);
    color: #fff;
    border: 2px solid rgb(255 255 255 / 0.85);
    transition: transform 0.4s var(--ease), background 0.4s;
  }
  .band :global(.reel:hover) .reel__play,
  .band :global(.reel:focus-visible) .reel__play {
    transform: scale(1.1);
    background: #800000;
  }
  /* On phones, two videos across: four fill a screen. */
  @media (max-width: 600px) {
    .band :global(.reels) {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 0.75rem;
    }
    .reel-item figcaption {
      font-size: 0.875rem;
    }
    .band :global(.reel__play) {
      width: 48px;
      height: 48px;
    }
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    grid-auto-flow: dense;
    gap: 1rem;
  }
  .photos figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
  }
  .photos .wide {
    grid-column: span 2;
    aspect-ratio: auto;
  }
  .photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
