---
/** Home-page Portfolio: videos and photos. Always open, unlike the expandable sections above it. */
import SectionHead from './SectionHead.astro';
import VideoGallery from './VideoGallery.astro';
import { asset, sections, useT, type Lang } from '../i18n';
import { site } from '../config/site';
import { instagram, tiktok } from '../data/media';
import { gallery } from '../data/gallery';
import { getYouTubeVideos } from '../lib/youtube';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const youtube = await getYouTubeVideos();
const featured = <T extends { featured?: boolean }>(list: T[]) => [
  ...list.filter((v) => v.featured),
  ...list.filter((v) => !v.featured),
];

const copy = {
  en: {
    title: 'Portfolio',
    videosLabel: 'Videos',
    photosLabel: 'Gallery',
  },
  pt: {
    title: 'Portfólio',
    videosLabel: 'Vídeos',
    photosLabel: 'Galeria',
  },
}[lang];
---

<div class="portfolio" id={sections.portfolio[lang]}>
  <SectionHead title={copy.title} />
  <div class="tab-block">
    <p class="eyebrow">{copy.videosLabel}</p>
    <VideoGallery lang={lang} youtube={featured(youtube)} tiktok={featured(tiktok)} instagram={featured(instagram)} limit={6} />
    <a class="tab-more videos-more" href={site.socials.youtube} target="_blank" rel="noopener">{t('media.more')} →</a>
  </div>

  {
    gallery.length > 0 && (
      <div class="tab-block">
        <p class="eyebrow">{copy.photosLabel}</p>
        <div class="photos">
          {gallery.map((g) => (
            <figure class:list={[{ wide: g.wide }]}>
              <img src={asset(g.src)} alt={g.alt} loading="lazy" decoding="async" />
            </figure>
          ))}
        </div>
      </div>
    )
  }
</div>

<style>
  .portfolio {
    display: grid;
    gap: clamp(2.5rem, 2rem + 2vw, 4rem);
  }
  .portfolio :global(.head) {
    margin-bottom: 0;
  }
  /* Same colour as an open section's title above. */
  .portfolio :global(.head h2) {
    color: var(--gold);
  }
  .tab-block > .eyebrow {
    margin-bottom: 1.4rem;
  }
  .tab-more {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--gold);
    font-weight: 600;
    border-bottom: 1px solid currentColor;
    padding-bottom: 0.15rem;
  }
  .videos-more {
    margin-top: 1.6rem;
    display: inline-flex;
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    grid-auto-flow: dense;
    gap: 1rem;
  }
  .photos figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
  }
  .photos .wide {
    grid-column: span 2;
    aspect-ratio: auto;
  }
  .photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
</style>
