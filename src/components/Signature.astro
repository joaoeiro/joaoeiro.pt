---
/**
 * João's handwritten signature, drawn in the text colour of the current theme (the PNG is only
 * used as a mask). It writes itself in from left to right: on load, or with `onView` once it
 * scrolls into view.
 */
interface Props {
  class?: string;
  /** Delay before it starts writing, e.g. '0.3s'. */
  delay?: string;
  /** Wait until it scrolls into view (uses the site's `.reveal` observer). */
  onView?: boolean;
}
const { class: className, delay = '0s', onView = false } = Astro.props;
---

{
  onView ? (
    // The observer can't see a fully clipped element, so it watches a wrapper instead.
    <span class:list={['reveal', className]} aria-hidden="true">
      <span class="signature signature--on-view" style={`--sig-delay:${delay}`} />
    </span>
  ) : (
    <span class:list={['signature', className]} style={`--sig-delay:${delay}`} aria-hidden="true" />
  )
}

<style>
  .signature {
    display: block;
    aspect-ratio: 1400 / 975;
    background: var(--ivory);
    -webkit-mask: url('/images/assinatura.png') center / contain no-repeat;
    mask: url('/images/assinatura.png') center / contain no-repeat;
    clip-path: inset(0 100% 0 0);
    animation: sigWrite 2.2s cubic-bezier(0.45, 0.05, 0.25, 1) forwards;
    animation-delay: var(--sig-delay);
  }
  .signature--on-view {
    animation-play-state: paused;
  }
  :global(.is-visible) > .signature--on-view {
    animation-play-state: running;
  }
  @keyframes sigWrite {
    to {
      clip-path: inset(0 0 0 0);
    }
  }
  :global(.no-js) .signature {
    clip-path: none;
    animation: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .signature {
      clip-path: none;
      animation: none;
    }
  }
</style>
