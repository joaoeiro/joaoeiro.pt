---
import { asset } from '../i18n';
import { signatureStrokes } from '../data/signature';

/**
 * João's handwritten signature, drawn in the text colour of the current theme (the SVG is only
 * used as a mask). It writes itself stroke by stroke, as if by hand: on load, or with `onView`
 * once it scrolls into view.
 */
interface Props {
  class?: string;
  /** Delay before it starts writing, e.g. '0.3s'. */
  delay?: string;
  /** Wait until it scrolls into view (uses the site's `.reveal` observer). */
  onView?: boolean;
}
const { class: className, delay = '0s', onView = false } = Astro.props;
// Through asset() so it still loads when the site is served from a sub-path.
const vars = `--sig-delay:${delay};--sig-url:url('${asset('/images/assinatura.svg')}')`;
// The page can hold more than one signature, so each one's masks get their own ids.
const uid = `sig-${Math.random().toString(36).slice(2, 8)}`;
---

<span class:list={['sig', { reveal: onView }, className]} aria-hidden="true">
  <span class:list={['signature', { 'signature--on-view': onView }]} style={vars}>
    <svg viewBox="0 0 1400 975">
      {
        signatureStrokes.map(
          (s, i) =>
            s.core && (
              // Where later letters touch this stroke (the J's long line), their ink waits for them.
              <mask id={`${uid}-${i}`} maskUnits="userSpaceOnUse" x="0" y="0" width="1400" height="975">
                <rect width="1400" height="975" fill="#fff" />
                {signatureStrokes.slice(i + 1).map((l) => (
                  <path d={l.d} stroke="#000" stroke-width={l.width} />
                ))}
                <path d={s.d} stroke="#fff" stroke-width={s.core} />
              </mask>
            ),
        )
      }
      {
        signatureStrokes.map((s, i) => (
          <path
            class="stroke"
            d={s.d}
            pathLength="1"
            mask={s.core ? `url(#${uid}-${i})` : undefined}
            style={`--d:${s.delay}s;--t:${s.dur}s;--w:${s.width}`}
          />
        ))
      }
    </svg>
  </span>
</span>

<style>
  /* With `onView`, the site's `.reveal` observer watches this wrapper. */
  .sig {
    display: block;
  }
  /* The real ink is the mask; thick pen strokes along its centre lines fill it in, in writing order. */
  .signature {
    display: block;
    aspect-ratio: 1400 / 975;
    -webkit-mask: var(--sig-url) center / contain no-repeat;
    mask: var(--sig-url) center / contain no-repeat;
  }
  svg {
    display: block;
    width: 100%;
    height: 100%;
  }
  mask path {
    fill: none;
    stroke-linecap: round;
    stroke-linejoin: round;
  }
  .stroke {
    fill: none;
    stroke: var(--ivory);
    stroke-width: var(--w);
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1 2;
    animation: sigStroke var(--t) cubic-bezier(0.4, 0, 0.6, 1) both;
    animation-delay: calc(var(--sig-delay) + var(--d));
  }
  .signature--on-view .stroke {
    animation-play-state: paused;
  }
  :global(.is-visible) > .signature--on-view .stroke {
    animation-play-state: running;
  }
  /* Hidden until the pen lands, so the round cap doesn't leave a dot before its stroke starts. */
  @keyframes sigStroke {
    from {
      stroke-dashoffset: 1;
      opacity: 0;
    }
    1% {
      opacity: 1;
    }
    to {
      stroke-dashoffset: 0;
      opacity: 1;
    }
  }
  /* Without the animation, show the whole signature straight from the ink. */
  :global(.no-js) .signature {
    background: var(--ivory);
  }
  :global(.no-js) .signature svg {
    display: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .signature {
      background: var(--ivory);
    }
    .signature svg {
      display: none;
    }
  }
</style>
