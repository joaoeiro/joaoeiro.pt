---
/** Endless ribbon of words on a maroon band, separated by quarter notes. */
interface Props {
  items: string[];
  reverse?: boolean;
}
const { items, reverse = false } = Astro.props;
const row = [...items, ...items];
---

<div class:list={['marquee', { reverse }]} aria-hidden="true">
  <div class="track">
    {
      row.map((w) => (
        <span class="word">
          {w}
          <i>♩</i>
        </span>
      ))
    }
  </div>
</div>

<style>
  /* Fixed brand colours. */
  .marquee {
    --band: #800000;
    --band-text: #d7cfc4;
    --band-note: #a3b8dc;
    overflow: hidden;
    padding-block: 1.4rem;
    background: var(--band);
  }
  .track {
    display: flex;
    width: max-content;
    animation: slide 40s linear infinite;
  }
  .reverse .track {
    animation-direction: reverse;
  }
  /* Same lettering as the hero eyebrow: uppercase, wide tracking, semibold. */
  .word {
    display: inline-flex;
    align-items: center;
    gap: 2rem;
    padding-right: 2rem;
    font-family: var(--font-body);
    font-size: clamp(1rem, 0.75rem + 1vw, 1.5rem);
    font-weight: 600;
    letter-spacing: 0.32em;
    text-transform: uppercase;
    white-space: nowrap;
    color: var(--band-text);
  }
  .word i {
    font-style: normal;
    font-size: 1.4em;
    letter-spacing: 0;
    color: var(--band-note);
  }
  @keyframes slide {
    to {
      transform: translateX(-50%);
    }
  }
</style>
