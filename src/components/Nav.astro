---
import { path, sectionHref, useT, type Lang, type RouteKey } from '../i18n';
import { site } from '../config/site';

interface Props {
  lang: Lang;
  route: RouteKey;
}
const { lang, route } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'pt' : 'en';
// Everything but the contact page is a section of the home page.
const links: { href: string; label: string; current?: boolean }[] = [
  { href: sectionHref('bio', lang), label: t('nav.bio') },
  { href: sectionHref('current', lang), label: t('nav.current') },
  { href: sectionHref('archive', lang), label: t('nav.archive') },
  { href: sectionHref('lessons', lang), label: t('nav.lessons') },
  { href: sectionHref('portfolio', lang), label: t('nav.portfolio') },
  { href: path('contact', lang), label: t('nav.contact'), current: route === 'contact' },
];
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="brand" href={path('home', lang)} aria-label={`${site.name} — ${t('nav.home')}`}>
      <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="brand__name">João <em>Eiró</em></span>
    </a>

    <nav class="links" aria-label="Main">
      {
        links.map((l) => (
          <a href={l.href} aria-current={l.current ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <a
        class="lang"
        href={path(route, other)}
        hreflang={other}
        data-lang-choice={other}
        lang={other}
        title={t('lang.switch')}
      >
        <span class:list={{ on: lang === 'pt' }}>PT</span><span class="sep">/</span><span
          class:list={{ on: lang === 'en' }}>EN</span
        >
      </a>
      <button class="burger" aria-expanded="false" aria-controls="drawer" data-burger>
        <span class="sr-only">{t('nav.menu')}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <div class="drawer" id="drawer" data-drawer hidden>
    <div class="drawer__panel">
      <nav aria-label="Mobile">
        <a href={path('home', lang)} style="--i:0">{t('nav.home')}</a>
        {
          links.map((l, i) => (
            <a href={l.href} style={`--i:${i + 1}`} aria-current={l.current ? 'page' : undefined}>
              {l.label}
            </a>
          ))
        }
      </nav>
      <a class="drawer__lang" href={path(route, other)} hreflang={other} data-lang-choice={other}>{t('lang.switch')}</a>
    </div>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
  const drawer = nav.querySelector<HTMLElement>('[data-drawer]')!;

  const onScroll = () => nav.classList.toggle('is-scrolled', scrollY > 24);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    burger.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) drawer.hidden = false;
    else setTimeout(() => !nav.classList.contains('is-open') && (drawer.hidden = true), 500);
  };
  burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));
  // Links to home-page sections stay on the page, so close the menu ourselves.
  drawer.querySelectorAll('a').forEach((a) => a.addEventListener('click', () => setOpen(false)));
  // A tap on the dimmed page below the band closes it too.
  drawer.addEventListener('click', (e) => e.target === drawer && setOpen(false));

  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));

  // On the home page, the note sits over the menu link of the section on screen: the one that
  // crosses a line a little above the middle of the screen. None at the very top (the hero) or
  // at the very end (the footer). The same goes for the mobile menu's links.
  const spots = [...nav.querySelectorAll<HTMLAnchorElement>('.links a[href*="#"], .drawer nav a[href*="#"]')]
    .map((a) => ({ a, el: document.getElementById(decodeURIComponent(new URL(a.href).hash.slice(1))) }))
    .filter((s): s is { a: HTMLAnchorElement; el: HTMLElement } => !!s.el && new URL(s.a.href).pathname === location.pathname);
  if (spots.length) {
    let queued = false;
    const mark = () => {
      queued = false;
      const line = innerHeight * 0.45;
      const atEnd = scrollY + innerHeight >= document.documentElement.scrollHeight - 2;
      const here = atEnd ? undefined : spots.find(({ el }) => {
        const r = el.getBoundingClientRect();
        return r.top <= line && r.bottom > line;
      });
      spots.forEach(({ a, el }) => (el === here?.el ? a.setAttribute('aria-current', 'location') : a.removeAttribute('aria-current')));
    };
    const queue = () => !queued && (queued = true) && requestAnimationFrame(mark);
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    new ResizeObserver(queue).observe(document.body);
    mark();
  }
</script>

<style>
  /* A maroon band with sand lettering: the site's colours turned around. The colour tokens are
     redefined here so everything inside, the mobile menu included, follows. */
  .nav {
    --ivory: #f4ecdc;
    --ivory-dim: rgb(244 236 220 / 0.82);
    --muted: rgb(244 236 220 / 0.7);
    --gold: #f4ecdc;
    --gold-grad: linear-gradient(#f4ecdc, #d9c7ad);
    --line: rgb(244 236 220 / 0.22);
    --ink: #800000;
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    background: #800000;
    color: var(--ivory);
    transition: box-shadow 0.5s;
  }
  .nav.is-scrolled {
    box-shadow: 0 10px 30px -18px rgb(40 10 10 / 0.7);
  }
  .nav__inner {
    width: min(1320px, 100% - 2.5rem);
    height: 100%;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    z-index: 2;
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .brand__name em {
    color: var(--gold);
  }
  .eq {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 20px;
  }
  .eq i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: var(--gold-grad);
    transform-origin: bottom;
    animation: eq 1.1s ease-in-out infinite alternate;
  }
  .eq i:nth-child(2) {
    animation-delay: -0.4s;
    animation-duration: 0.8s;
  }
  .eq i:nth-child(3) {
    animation-delay: -0.7s;
    animation-duration: 1.3s;
  }
  .eq i:nth-child(4) {
    animation-delay: -0.2s;
    animation-duration: 0.95s;
  }
  @keyframes eq {
    from {
      transform: scaleY(0.2);
    }
    to {
      transform: scaleY(1);
    }
  }
  .links {
    display: flex;
    gap: clamp(1rem, 0.2rem + 1.6vw, 2.2rem);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }
  .links a {
    position: relative;
    padding: 0.4rem 0;
    color: var(--ivory-dim);
    transition: color 0.3s;
  }
  .links a::after {
    content: '♪';
    position: absolute;
    left: 50%;
    top: -0.9rem;
    font-size: 0.8rem;
    color: var(--gold);
    opacity: 0;
    transform: translate(-50%, 6px);
    transition: 0.4s var(--ease);
  }
  .links a:hover,
  .links a[aria-current] {
    color: var(--ivory);
  }
  .links a:hover::after,
  .links a[aria-current]::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    z-index: 2;
  }
  .lang {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    transition: border-color 0.3s;
  }
  .lang:hover {
    border-color: var(--gold);
  }
  .lang .on {
    color: var(--gold);
  }
  .lang .sep {
    margin-inline: 0.3rem;
    opacity: 0.4;
  }
  .burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .burger i {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1.5px;
    background: var(--ivory);
    transition: transform 0.45s var(--ease);
  }
  .burger i:first-of-type {
    top: 18px;
  }
  .burger i:last-of-type {
    top: 24px;
  }
  .is-open .burger i:first-of-type {
    transform: translateY(3px) rotate(45deg);
  }
  .is-open .burger i:last-of-type {
    transform: translateY(-3px) rotate(-45deg);
  }
  /* Mobile menu: a band dropping from under the header, over the page, which dims below it. */
  .drawer {
    position: absolute;
    top: 100%;
    left: 0;
    right: 0;
    height: calc(100dvh - var(--nav-h));
    background: rgb(0 0 0 / 0);
    transition: background 0.5s;
  }
  /* The sand page needs a deep shade to read as dimmed. */
  .is-open .drawer {
    background: rgb(40 10 10 / 0.6);
  }
  .drawer__panel {
    max-height: 100%;
    overflow-y: auto;
    overscroll-behavior: contain;
    padding: 1.25rem 1.25rem 1.75rem;
    background: var(--ink);
    border-bottom: 1px solid var(--line);
    box-shadow: 0 24px 40px -20px rgb(0 0 0 / 0.6);
    clip-path: inset(0 0 100% 0);
    transition: clip-path 0.55s var(--ease);
  }
  .is-open .drawer__panel {
    clip-path: inset(0 0 -60px 0);
  }
  .drawer nav {
    display: grid;
  }
  /* Same type as the footer's "Let's make music together?" line. */
  .drawer nav a {
    position: relative;
    padding: 0.7rem 0 0.7rem 1.6rem;
    font-family: var(--font-body);
    font-size: clamp(1.1rem, 1rem + 0.5vw, 1.35rem);
    color: var(--ivory-dim);
    border-bottom: 1px solid var(--line);
    opacity: 0;
    transform: translateY(-8px);
    transition: 0.5s var(--ease), color 0.3s;
    transition-delay: calc(0.1s + var(--i) * 40ms);
  }
  /* The note marks where you are, as on the desktop menu. */
  .drawer nav a::before {
    content: '♪';
    position: absolute;
    left: 0.15rem;
    top: 50%;
    color: var(--gold);
    opacity: 0;
    transform: translate(-6px, -50%);
    transition: 0.4s var(--ease);
  }
  .drawer nav a[aria-current] {
    color: var(--ivory);
  }
  .drawer nav a[aria-current]::before {
    opacity: 1;
    transform: translate(0, -50%);
  }
  .is-open .drawer nav a {
    opacity: 1;
    transform: none;
  }
  .drawer__lang {
    display: inline-block;
    margin-top: 1.25rem;
    color: var(--gold);
    font-size: 0.85rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (prefers-reduced-motion: reduce) {
    .drawer__panel,
    .drawer nav a {
      transition: none;
    }
  }
  @media (max-width: 960px) {
    .links {
      display: none;
    }
    .burger {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .eq {
      display: none;
    }
    .brand__name {
      font-size: 1.4rem;
    }
    .actions {
      gap: 0.45rem;
    }
    .lang {
      padding: 0.5rem 0.7rem;
    }
  }
</style>
