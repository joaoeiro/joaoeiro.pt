---
import { path, useT, type Lang, type RouteKey } from '../i18n';
import { site } from '../config/site';

interface Props {
  lang: Lang;
  route: RouteKey;
}
const { lang, route } = Astro.props;
const t = useT(lang);
const other: Lang = lang === 'en' ? 'pt' : 'en';
const links: { key: RouteKey; label: string }[] = [
  { key: 'lessons', label: t('nav.lessons') },
  { key: 'portfolio', label: t('nav.portfolio') },
  { key: 'shows', label: t('nav.shows') },
  { key: 'events', label: t('nav.events') },
  { key: 'contact', label: t('nav.contact') },
];
---

<header class="nav" data-nav>
  <div class="nav__inner">
    <a class="brand" href={path('home', lang)} aria-label={`${site.name} — ${t('nav.home')}`}>
      <span class="eq" aria-hidden="true"><i></i><i></i><i></i><i></i></span>
      <span class="brand__name">João <em>Eiró</em></span>
    </a>

    <nav class="links" aria-label="Main">
      {
        links.map((l) => (
          <a href={path(l.key, lang)} aria-current={route === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
    </nav>

    <div class="actions">
      <button
        class="theme"
        type="button"
        data-theme-toggle
        data-label-light={t('theme.light')}
        data-label-dark={t('theme.dark')}
        aria-label={t('theme.light')}
      >
        <svg class="sun" viewBox="0 0 24 24" aria-hidden="true">
          <circle cx="12" cy="12" r="4.2" fill="currentColor" />
          <g stroke="currentColor" stroke-width="1.8" stroke-linecap="round">
            <path d="M12 2.5v2.2M12 19.3v2.2M2.5 12h2.2M19.3 12h2.2M5.3 5.3l1.6 1.6M17.1 17.1l1.6 1.6M5.3 18.7l1.6-1.6M17.1 6.9l1.6-1.6" />
          </g>
        </svg>
        <svg class="moon" viewBox="0 0 24 24" aria-hidden="true">
          <path fill="currentColor" d="M20.2 14.6A8.5 8.5 0 0 1 9.4 3.8a8.5 8.5 0 1 0 10.8 10.8Z" />
          <text x="15.5" y="9.5" font-size="7" fill="currentColor">♪</text>
        </svg>
      </button>
      <a
        class="lang"
        href={path(route, other)}
        hreflang={other}
        lang={other}
        data-lang-choice={other}
        title={t('lang.switch')}
      >
        <span class:list={{ on: lang === 'en' }}>EN</span><span class="sep">/</span><span
          class:list={{ on: lang === 'pt' }}>PT</span
        >
      </a>
      <button class="burger" aria-expanded="false" aria-controls="drawer" data-burger>
        <span class="sr-only">{t('nav.menu')}</span>
        <i></i><i></i>
      </button>
    </div>
  </div>

  <div class="drawer" id="drawer" data-drawer hidden>
    <nav aria-label="Mobile">
      <a href={path('home', lang)} style="--i:0">{t('nav.home')}</a>
      {
        links.map((l, i) => (
          <a href={path(l.key, lang)} style={`--i:${i + 1}`} aria-current={route === l.key ? 'page' : undefined}>
            {l.label}
          </a>
        ))
      }
      <a href={path('press', lang)} style={`--i:${links.length + 1}`}>{t('nav.press')}</a>
    </nav>
    <a class="drawer__lang" href={path(route, other)} hreflang={other} data-lang-choice={other}>{t('lang.switch')}</a>
  </div>
</header>

<script>
  const nav = document.querySelector<HTMLElement>('[data-nav]')!;
  const burger = nav.querySelector<HTMLButtonElement>('[data-burger]')!;
  const drawer = nav.querySelector<HTMLElement>('[data-drawer]')!;

  const onScroll = () => nav.classList.toggle('is-scrolled', scrollY > 24);
  onScroll();
  addEventListener('scroll', onScroll, { passive: true });

  const setOpen = (open: boolean) => {
    burger.setAttribute('aria-expanded', String(open));
    nav.classList.toggle('is-open', open);
    document.body.style.overflow = open ? 'hidden' : '';
    if (open) drawer.hidden = false;
    else setTimeout(() => !nav.classList.contains('is-open') && (drawer.hidden = true), 500);
  };
  burger.addEventListener('click', () => setOpen(burger.getAttribute('aria-expanded') !== 'true'));

  // Light / dark theme: follows the system until the visitor picks one.
  const root = document.documentElement;
  const toggle = nav.querySelector<HTMLButtonElement>('[data-theme-toggle]')!;
  const meta = document.querySelector<HTMLMetaElement>('meta[name=theme-color]');
  const apply = (theme: string) => {
    root.dataset.theme = theme;
    if (meta) meta.content = theme === 'light' ? '#fdf8f1' : '#07060a';
    toggle.setAttribute('aria-label', toggle.dataset[theme === 'light' ? 'labelDark' : 'labelLight']!);
  };
  apply(root.dataset.theme ?? 'dark');

  toggle.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    try {
      localStorage.setItem('theme', next);
    } catch {}
    const calm = matchMedia('(prefers-reduced-motion: reduce)').matches;
    if (!document.startViewTransition || calm) return apply(next);

    const r = toggle.getBoundingClientRect();
    const x = r.left + r.width / 2;
    const y = r.top + r.height / 2;
    const radius = Math.hypot(Math.max(x, innerWidth - x), Math.max(y, innerHeight - y));
    root.classList.add('theme-switching');
    const vt = document.startViewTransition(() => apply(next));
    vt.ready.then(() =>
      root.animate(
        { clipPath: [`circle(0 at ${x}px ${y}px)`, `circle(${radius}px at ${x}px ${y}px)`] },
        { duration: 700, easing: 'cubic-bezier(0.22, 1, 0.36, 1)', pseudoElement: '::view-transition-new(root)' },
      ),
    );
    vt.finished.finally(() => root.classList.remove('theme-switching'));
  });

  matchMedia('(prefers-color-scheme: light)').addEventListener('change', (e) => {
    try {
      if (localStorage.getItem('theme')) return;
    } catch {}
    apply(e.matches ? 'light' : 'dark');
  });
  addEventListener('keydown', (e) => e.key === 'Escape' && setOpen(false));
</script>

<style>
  .nav {
    position: fixed;
    inset: 0 0 auto;
    z-index: 50;
    height: var(--nav-h);
    transition: background 0.5s, backdrop-filter 0.5s, border-color 0.5s;
    border-bottom: 1px solid transparent;
  }
  .nav.is-scrolled {
    background: rgb(var(--bg-rgb) / 0.75);
    backdrop-filter: blur(16px) saturate(1.4);
    border-color: var(--line);
  }
  .nav__inner {
    width: min(1320px, 100% - 2.5rem);
    height: 100%;
    margin-inline: auto;
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
  }
  .brand {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    z-index: 2;
  }
  .brand__name {
    font-family: var(--font-display);
    font-size: 1.65rem;
    letter-spacing: 0.01em;
    white-space: nowrap;
  }
  .brand__name em {
    color: var(--gold);
  }
  .eq {
    display: flex;
    align-items: flex-end;
    gap: 3px;
    height: 20px;
  }
  .eq i {
    width: 3px;
    height: 100%;
    border-radius: 2px;
    background: var(--gold-grad);
    transform-origin: bottom;
    animation: eq 1.1s ease-in-out infinite alternate;
  }
  .eq i:nth-child(2) {
    animation-delay: -0.4s;
    animation-duration: 0.8s;
  }
  .eq i:nth-child(3) {
    animation-delay: -0.7s;
    animation-duration: 1.3s;
  }
  .eq i:nth-child(4) {
    animation-delay: -0.2s;
    animation-duration: 0.95s;
  }
  @keyframes eq {
    from {
      transform: scaleY(0.2);
    }
    to {
      transform: scaleY(1);
    }
  }
  .links {
    display: flex;
    gap: clamp(1rem, 0.2rem + 1.6vw, 2.2rem);
    font-size: 0.9rem;
    font-weight: 500;
    letter-spacing: 0.03em;
  }
  .links a {
    position: relative;
    padding: 0.4rem 0;
    color: var(--ivory-dim);
    transition: color 0.3s;
  }
  .links a::after {
    content: '♪';
    position: absolute;
    left: 50%;
    top: -0.9rem;
    font-size: 0.8rem;
    color: var(--gold);
    opacity: 0;
    transform: translate(-50%, 6px);
    transition: 0.4s var(--ease);
  }
  .links a:hover,
  .links a[aria-current='page'] {
    color: var(--ivory);
  }
  .links a:hover::after,
  .links a[aria-current='page']::after {
    opacity: 1;
    transform: translate(-50%, 0);
  }
  .actions {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    position: relative;
    z-index: 2;
  }
  .lang {
    font-size: 0.78rem;
    font-weight: 600;
    letter-spacing: 0.12em;
    padding: 0.5rem 0.85rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    color: var(--muted);
    transition: border-color 0.3s;
  }
  .lang:hover {
    border-color: var(--gold);
  }
  .lang .on {
    color: var(--gold);
  }
  .lang .sep {
    margin-inline: 0.3rem;
    opacity: 0.4;
  }
  .theme {
    position: relative;
    display: grid;
    place-items: center;
    width: 40px;
    height: 40px;
    padding: 0;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    color: var(--gold);
    cursor: pointer;
    overflow: hidden;
    transition: border-color 0.3s;
  }
  .theme:hover {
    border-color: var(--gold);
  }
  .theme svg {
    position: absolute;
    width: 19px;
    height: 19px;
    transition:
      transform 0.6s var(--ease),
      opacity 0.4s;
  }
  /* Show the icon of the theme you would switch to. */
  .theme .sun {
    transform: translateY(0) rotate(0);
  }
  .theme .moon {
    opacity: 0;
    transform: translateY(120%) rotate(-60deg);
  }
  :global([data-theme='light']) .theme .sun {
    opacity: 0;
    transform: translateY(-120%) rotate(90deg);
  }
  :global([data-theme='light']) .theme .moon {
    opacity: 1;
    transform: none;
  }
  .burger {
    display: none;
    width: 44px;
    height: 44px;
    border: 1px solid var(--line);
    border-radius: 50%;
    background: transparent;
    cursor: pointer;
    position: relative;
  }
  .burger i {
    position: absolute;
    left: 13px;
    right: 13px;
    height: 1.5px;
    background: var(--ivory);
    transition: transform 0.45s var(--ease);
  }
  .burger i:first-of-type {
    top: 18px;
  }
  .burger i:last-of-type {
    top: 24px;
  }
  .is-open .burger i:first-of-type {
    transform: translateY(3px) rotate(45deg);
  }
  .is-open .burger i:last-of-type {
    transform: translateY(-3px) rotate(-45deg);
  }
  .drawer {
    position: fixed;
    inset: 0;
    z-index: 1;
    display: flex;
    flex-direction: column;
    justify-content: center;
    padding: calc(var(--nav-h) + 1rem) 2rem 2rem;
    background:
      radial-gradient(circle at 80% 10%, rgb(var(--wine-rgb) / 0.5), transparent 50%),
      rgb(var(--bg-rgb) / 0.97);
    clip-path: circle(0 at calc(100% - 3rem) 2.25rem);
    transition: clip-path 0.7s var(--ease);
  }
  .is-open .drawer {
    clip-path: circle(150% at calc(100% - 3rem) 2.25rem);
  }
  .drawer nav {
    display: grid;
    gap: 0.25rem;
  }
  .drawer nav a {
    font-family: var(--font-display);
    font-size: clamp(2.2rem, 9vw, 3.2rem);
    line-height: 1.2;
    opacity: 0;
    transform: translateX(-30px);
    transition: 0.6s var(--ease);
    transition-delay: calc(0.15s + var(--i) * 60ms);
  }
  .drawer nav a[aria-current='page'] {
    color: var(--gold);
  }
  .is-open .drawer nav a {
    opacity: 1;
    transform: none;
  }
  .drawer__lang {
    margin-top: 2.5rem;
    color: var(--gold);
    font-size: 0.9rem;
    letter-spacing: 0.1em;
    text-transform: uppercase;
  }
  @media (max-width: 960px) {
    .links {
      display: none;
    }
    .burger {
      display: block;
    }
  }
  @media (max-width: 480px) {
    .eq {
      display: none;
    }
    .brand__name {
      font-size: 1.4rem;
    }
    .actions {
      gap: 0.45rem;
    }
    .lang {
      padding: 0.5rem 0.7rem;
    }
  }
</style>
