---
/**
 * The one contact form. "Em que te posso ajudar?" picks a set of questions (lessons, events or other);
 * the page can preselect it with ?s=lessons|events|other. Field names are the questions
 * themselves, so the email João receives reads as plain question → answer.
 */
import Icon from './Icon.astro';
import Req from './Req.astro';
import { site } from '../config/site';
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const c = {
  en: {
    mailSubject: 'Website enquiry',
    subject: 'How can I help?',
    subjects: { lessons: 'Lessons', events: 'Events', other: 'Other' },
    firstFree: 'The first lesson is always free and with no commitment. Perfect for giving it a try!',
    lessonType: 'Piano lessons, music theory or something else?',
    lessonTypes: ['Piano lessons', 'Music theory', 'Other'],
    age: 'Student’s age',
    agePh: 'e.g. 18',
    guardian: 'Parent or guardian’s name',
    experience: 'Experience playing the piano',
    experiencePh: 'e.g. never played, or two years of lessons as a child…',
    where: 'Where would the lessons be?',
    whereOpts: ['At the student’s home', 'At the teacher’s home (Benfica)'],
    whereHint: 'Tick one or both.',
    whereRequired: 'Please choose at least one option.',
    area: 'Area or town',
    areaPh: 'e.g. Benfica, Amadora, Telheiras…',
    pianoHome: 'Is there a piano at home?',
    pianoHomeOpts: ['Yes, an acoustic piano', 'Yes, a keyboard or digital piano', 'Not yet'],
    goal: 'Goal',
    goalOpts: ['For fun', 'Exams or conservatoire', 'Playing the songs I love', 'Accompanying myself singing', 'Other'],
    schedule: 'Preferred days and times',
    schedulePh: 'e.g. weekday evenings after 6pm, Saturday mornings…',
    more: 'Anything else you’d like to share?',
    eventType: 'Type of event',
    eventTypes: ['Wedding', 'Corporate event', 'Private event', 'Other'],
    eventDate: 'Event date',
    dateKinds: { single: 'One day', range: 'A range of dates', open: 'Not decided yet' },
    day: 'Day',
    from: 'From',
    to: 'To',
    dateRange: (a: string, b: string) => `${a} to ${b}`,
    music: 'Type of music you’re looking for',
    musicPh: 'e.g. jazz, classical, pop on piano…',
    duration: 'Approximate duration',
    durationPh: 'e.g. 2 hours',
    venue: 'Event location',
    venuePh: 'e.g. a quinta in Sintra, a hotel in Lisbon…',
    venuePiano: 'Does the venue have a piano?',
    venuePianoOpts: ['Yes', 'No', 'I don’t know'],
    songs: 'Special songs',
    songsPh: 'e.g. the bride’s entrance, the first dance…',
    guests: 'Number of guests',
    sound: 'Sound system',
    soundOpts: ['I have my own', 'I need you to bring one'],
    details: 'Any other relevant details?',
    message: 'Your message',
    you: 'About you',
    name: 'Name',
    prefer: 'Preferred way to reach you',
    preferOpts: { whatsapp: 'WhatsApp', phone: 'Phone call', email: 'Email', other: 'Other' },
    preferOther: 'Which one?',
    preferOtherPh: 'e.g. Signal, Telegram, a text message…',
    contact: 'Your contact',
    contactPh: { none: 'Phone number or email', whatsapp: 'WhatsApp number', phone: 'Phone number', email: 'Email address', other: 'Your contact there' },
    required: 'Required',
  },
  pt: {
    mailSubject: 'Contacto pelo site',
    subject: 'Em que te posso ajudar?',
    subjects: { lessons: 'Aulas', events: 'Eventos', other: 'Outro' },
    firstFree: 'A primeira aula é sempre grátis e sem compromisso. Ideal para experimentar!',
    lessonType: 'Aulas de piano, formação musical ou outro?',
    lessonTypes: ['Aulas de piano', 'Formação musical', 'Outro'],
    age: 'Idade do aluno',
    agePh: 'Ex.: 18',
    guardian: 'Nome do encarregado de educação',
    experience: 'Experiência a tocar piano',
    experiencePh: 'Ex.: nunca toquei, ou tive dois anos de aulas em criança…',
    where: 'Onde são as aulas?',
    whereOpts: ['Em casa do aluno', 'Em casa do professor (Benfica)'],
    whereHint: 'Podes escolher uma ou as duas.',
    whereRequired: 'Escolhe pelo menos uma opção.',
    area: 'Zona ou localidade',
    areaPh: 'Ex.: Benfica, Amadora, Telheiras…',
    pianoHome: 'Tens piano em casa?',
    pianoHomeOpts: ['Sim, piano acústico', 'Sim, teclado ou piano digital', 'Ainda não'],
    goal: 'Objetivo',
    goalOpts: ['Lazer', 'Exames ou conservatório', 'Tocar as músicas de que gosto', 'Acompanhar-me a cantar', 'Outro'],
    schedule: 'Preferências de horário e dias da semana',
    schedulePh: 'Ex.: dias úteis depois das 18h, sábados de manhã…',
    more: 'Mais alguma coisa que queiras partilhar?',
    eventType: 'Tipo de evento',
    eventTypes: ['Casamento', 'Evento corporativo', 'Evento privado', 'Outro'],
    eventDate: 'Data do evento',
    dateKinds: { single: 'Um dia', range: 'Intervalo de datas', open: 'Ainda não está definida' },
    day: 'Dia',
    from: 'De',
    to: 'Até',
    dateRange: (a: string, b: string) => `de ${a} a ${b}`,
    music: 'Tipo de música que procuras',
    musicPh: 'Ex.: jazz, clássico, pop ao piano…',
    duration: 'Duração aproximada do evento',
    durationPh: 'Ex.: 2 horas',
    venue: 'Local do evento',
    venuePh: 'Ex.: quinta em Sintra, hotel em Lisboa…',
    venuePiano: 'O espaço tem piano?',
    venuePianoOpts: ['Sim', 'Não', 'Não sei'],
    songs: 'Músicas especiais',
    songsPh: 'Ex.: entrada da noiva, primeira dança…',
    guests: 'Número de pessoas',
    sound: 'Sistema de som',
    soundOpts: ['Tenho o meu', 'Preciso que leve'],
    details: 'Mais algum detalhe relevante?',
    message: 'A tua mensagem',
    you: 'Sobre ti',
    name: 'Nome',
    prefer: 'Como preferes que te contacte?',
    preferOpts: { whatsapp: 'WhatsApp', phone: 'Chamada', email: 'Email', other: 'Outro' },
    preferOther: 'Qual?',
    preferOtherPh: 'Ex.: Signal, Telegram, SMS…',
    contact: 'O teu contacto',
    contactPh: { none: 'Número de telefone ou email', whatsapp: 'Número de WhatsApp', phone: 'Número de telefone', email: 'Endereço de email', other: 'O teu contacto nesse meio' },
    required: 'Resposta obrigatória',
  },
}[lang];

const subjectKeys = ['lessons', 'events', 'other'] as const;
const dateKinds = ['single', 'range', 'open'] as const;
---

<form
  class="form"
  data-form
  data-endpoint={site.formEndpoint}
  data-subject={c.mailSubject}
  data-sending={t('form.sending')}
  data-sent={t('form.sent')}
  data-instagram={site.socials.instagram}
  data-error={t('form.error')}
  data-ph={JSON.stringify(c.contactPh)}
  data-where-required={c.whereRequired}
  data-date-question={c.eventDate}
  data-date-kinds={JSON.stringify(c.dateKinds)}
  data-date-range={c.dateRange('{a}', '{b}')}
  method="post"
  action={site.formEndpoint || undefined}
>
  <input type="hidden" name="_subject" value={c.mailSubject} />

  <fieldset class="group">
    <legend>{c.subject}<Req /></legend>
    <div class="pills">
      {
        subjectKeys.map((k) => (
          <label class="pill">
            <input type="radio" name={c.subject} value={c.subjects[k]} data-topic={k} required />
            <span>{c.subjects[k]}</span>
          </label>
        ))
      }
    </div>
  </fieldset>

  <fieldset class="topic" data-for="lessons" disabled hidden>
    <p class="note">{c.firstFree}</p>
    <fieldset class="group">
      <legend>{c.lessonType}<Req /></legend>
      <div class="pills">
        {
          c.lessonTypes.map((o) => (
            <label class="pill">
              <input type="radio" name={c.lessonType} value={o} required />
              <span>{o}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <div class="row">
      <label>
        <span>{c.age}<Req /></span>
        <input name={c.age} inputmode="numeric" placeholder={c.agePh} data-age required />
      </label>
      <fieldset class="sub" data-when="minor" disabled hidden>
        <label>
          <span>{c.guardian}<Req /></span>
          <input name={c.guardian} autocomplete="off" required />
        </label>
      </fieldset>
    </div>
    <label>
      <span>{c.experience}</span>
      <textarea name={c.experience} rows="3" placeholder={c.experiencePh}></textarea>
    </label>
    <fieldset class="group">
      <legend>{c.pianoHome}</legend>
      <div class="pills">
        {
          c.pianoHomeOpts.map((o) => (
            <label class="pill">
              <input type="radio" name={c.pianoHome} value={o} />
              <span>{o}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset class="group">
      <legend>{c.goal}</legend>
      <div class="checks">
        {
          c.goalOpts.map((o) => (
            <label class="check">
              <input type="checkbox" name={c.goal} value={o} />
              <span>{o}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset class="group" data-where>
      <legend>{c.where}<Req /></legend>
      <div class="checks">
        {
          c.whereOpts.map((o, i) => (
            <label class="check">
              <input type="checkbox" name={c.where} value={o} data-at-home={i === 0 ? '' : undefined} />
              <span>{o}</span>
            </label>
          ))
        }
      </div>
      <p class="hint">{c.whereHint}</p>
    </fieldset>
    <fieldset class="sub" data-when="home" disabled hidden>
      <label>
        <span>{c.area}<Req /></span>
        <input name={c.area} placeholder={c.areaPh} required />
      </label>
    </fieldset>
    <label>
      <span>{c.schedule}</span>
      <textarea name={c.schedule} rows="3" placeholder={c.schedulePh}></textarea>
    </label>
    <label>
      <span>{c.more}</span>
      <textarea name={c.more} rows="3"></textarea>
    </label>
  </fieldset>

  <fieldset class="topic" data-for="events" disabled hidden>
    <div class="row">
      <label>
        <span>{c.eventType}<Req /></span>
        <select name={c.eventType} required>
          <option value="" disabled selected>—</option>
          {c.eventTypes.map((o) => <option>{o}</option>)}
        </select>
      </label>
    </div>
    <fieldset class="group" data-date>
      <legend>{c.eventDate}<Req /></legend>
      <div class="pills">
        {
          dateKinds.map((k) => (
            <label class="pill">
              <input type="radio" name="_dateKind" value={k} required />
              <span>{c.dateKinds[k]}</span>
            </label>
          ))
        }
      </div>
      <fieldset class="sub dates" data-when="date-single" disabled hidden>
        <label>
          <span>{c.day}<Req /></span>
          <input name="_dateDay" type="date" required />
        </label>
      </fieldset>
      <fieldset class="sub dates row" data-when="date-range" disabled hidden>
        <label>
          <span>{c.from}<Req /></span>
          <input name="_dateFrom" type="date" required data-date-from />
        </label>
        <label>
          <span>{c.to}<Req /></span>
          <input name="_dateTo" type="date" required data-date-to />
        </label>
      </fieldset>
    </fieldset>
    <label>
      <span>{c.venue}<Req /></span>
      <input name={c.venue} placeholder={c.venuePh} required />
    </label>
    <fieldset class="group">
      <legend>{c.venuePiano}<Req /></legend>
      <div class="pills">
        {
          c.venuePianoOpts.map((o) => (
            <label class="pill">
              <input type="radio" name={c.venuePiano} value={o} required />
              <span>{o}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <label>
      <span>{c.music}<Req /></span>
      <input name={c.music} placeholder={c.musicPh} required />
    </label>
    <div class="row">
      <label>
        <span>{c.duration}<Req /></span>
        <input name={c.duration} placeholder={c.durationPh} required />
      </label>
      <label>
        <span>{c.guests}<Req /></span>
        <input name={c.guests} type="number" min="1" inputmode="numeric" required />
      </label>
    </div>
    <fieldset class="group">
      <legend>{c.sound}<Req /></legend>
      <div class="pills">
        {
          c.soundOpts.map((o) => (
            <label class="pill">
              <input type="radio" name={c.sound} value={o} required />
              <span>{o}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <label>
      <span>{c.songs}</span>
      <textarea name={c.songs} rows="3" placeholder={c.songsPh}></textarea>
    </label>
    <label>
      <span>{c.details}</span>
      <textarea name={c.details} rows="3"></textarea>
    </label>
  </fieldset>

  <fieldset class="topic" data-for="other" disabled hidden>
    <label>
      <span>{c.message}<Req /></span>
      <textarea name={c.message} rows="6" required></textarea>
    </label>
  </fieldset>

  <fieldset class="topic you" data-for="any" disabled hidden>
    <p class="you__title">{c.you}</p>
    <label>
      <span>{c.name}<Req /></span>
      <input name={c.name} autocomplete="name" required />
    </label>
    <fieldset class="group">
      <legend>{c.prefer}<Req /></legend>
      <div class="pills">
        {
          (['whatsapp', 'phone', 'email', 'other'] as const).map((k) => (
            <label class="pill">
              <input type="radio" name={c.prefer} value={c.preferOpts[k]} data-via={k} required />
              <span>{c.preferOpts[k]}</span>
            </label>
          ))
        }
      </div>
    </fieldset>
    <fieldset class="sub" data-when="via-other" disabled hidden>
      <label>
        <span>{c.preferOther}<Req /></span>
        <input name={c.preferOther} placeholder={c.preferOtherPh} required />
      </label>
    </fieldset>
    <label>
      <span>{c.contact}<Req /></span>
      <input name={c.contact} data-contact placeholder={c.contactPh.none} required />
    </label>
  </fieldset>

  <div class="actions" data-actions hidden>
    <p class="req-note"><span aria-hidden="true">*</span> {c.required}</p>
    <button class="btn btn--gold" type="submit">
      <span data-label>{t('form.send')}</span>
      <Icon name="arrow" size={18} />
    </button>
    <p class="status" data-status aria-live="polite"></p>
  </div>

</form>

<script>

  document.querySelectorAll<HTMLFormElement>('[data-form]').forEach((form) => {
    const status = form.querySelector<HTMLElement>('[data-status]')!;
    const label = form.querySelector<HTMLElement>('[data-label]')!;
    const actions = form.querySelector<HTMLElement>('[data-actions]')!;
    const contact = form.querySelector<HTMLInputElement>('[data-contact]')!;
    const where = form.querySelector<HTMLFieldSetElement>('[data-where]')!;
    const original = label.textContent;
    const { endpoint, subject, sending, sent, error, instagram, whereRequired, dateQuestion, dateRange } = form.dataset;
    const dateKinds = JSON.parse(form.dataset.dateKinds!) as Record<string, string>;
    const ph = JSON.parse(form.dataset.ph!) as Record<string, string>;

    // Show only the questions for the chosen subject; hidden ones are disabled so they are neither required nor sent.
    const show = (topic: string) => {
      form.querySelectorAll<HTMLFieldSetElement>('.topic').forEach((f) => {
        const on = f.dataset.for === topic || f.dataset.for === 'any';
        f.hidden = !on;
        f.disabled = !on;
      });
      actions.hidden = false;
    };
    form.querySelectorAll<HTMLInputElement>('[data-topic]').forEach((r) => {
      r.addEventListener('change', () => show(r.dataset.topic!));
    });
    const wanted = new URLSearchParams(location.search).get('s');
    const preset = form.querySelector<HTMLInputElement>(`[data-topic="${wanted}"]`);
    if (preset) {
      preset.checked = true;
      show(wanted!);
    }

    // The contact field follows the preferred channel.
    form.querySelectorAll<HTMLInputElement>('[data-via]').forEach((r) => {
      r.addEventListener('change', () => {
        const via = r.dataset.via!;
        contact.type = via === 'email' ? 'email' : via === 'other' ? 'text' : 'tel';
        contact.autocomplete = via === 'email' ? 'email' : via === 'other' ? 'off' : 'tel';
        contact.placeholder = ph[via];
        sync();
      });
    });

    // Follow-up questions: the area when lessons are at the student's home, a guardian when the student is a minor,
    // the event's day or range of days, and which channel when the visitor prefers "other".
    const age = form.querySelector<HTMLInputElement>('[data-age]')!;
    const atHome = form.querySelector<HTMLInputElement>('[data-at-home]')!;
    const checked = (name: string) => form.querySelector<HTMLInputElement>(`input[name="${name}"]:checked`)?.value;
    const conditions: Record<string, () => boolean> = {
      home: () => atHome.checked,
      minor: () => {
        const n = parseInt(age.value, 10);
        return n > 0 && n < 18;
      },
      'date-single': () => checked('_dateKind') === 'single',
      'date-range': () => checked('_dateKind') === 'range',
      'via-other': () => form.querySelector<HTMLInputElement>('[data-via="other"]')!.checked,
    };
    const sync = () =>
      form.querySelectorAll<HTMLFieldSetElement>('[data-when]').forEach((f) => {
        const on = conditions[f.dataset.when!]();
        f.hidden = !on;
        f.disabled = !on;
      });
    age.addEventListener('input', sync);
    atHome.addEventListener('change', sync);
    form.querySelectorAll('input[name="_dateKind"]').forEach((r) => r.addEventListener('change', sync));

    // A range can't end before it starts.
    const from = form.querySelector<HTMLInputElement>('[data-date-from]')!;
    const to = form.querySelector<HTMLInputElement>('[data-date-to]')!;
    from.addEventListener('change', () => (to.min = from.value));

    // The event date reaches the email as one answer: a day, "from … to …", or "not decided yet".
    const day = (v: FormDataEntryValue | null) => String(v ?? '').split('-').reverse().join('/');
    const tidy = (raw: FormData) => {
      const out = new FormData();
      for (const [k, v] of raw.entries()) {
        if (k === '_dateKind') {
          const when =
            v === 'single'
              ? day(raw.get('_dateDay'))
              : v === 'range'
                ? dateRange!.replace('{a}', day(raw.get('_dateFrom'))).replace('{b}', day(raw.get('_dateTo')))
                : dateKinds.open;
          out.append(dateQuestion!, when);
        } else if (!k.startsWith('_date')) out.append(k, v);
      }
      return out;
    };

    // "Where" accepts one or both boxes, but at least one.
    const boxes = [...where.querySelectorAll<HTMLInputElement>('input[type=checkbox]')];
    const checkWhere = () => boxes[0].setCustomValidity(boxes.some((b) => b.checked) ? '' : whereRequired!);
    boxes.forEach((b) => b.addEventListener('change', checkWhere));
    checkWhere();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const data = tidy(new FormData(form));
      const topic = form.querySelector<HTMLInputElement>('[data-topic]:checked')?.value ?? '';
      const name = form.querySelector<HTMLInputElement>('input[autocomplete="name"]')?.value.trim();
      const title = [subject, topic, name].filter(Boolean).join(' — ');

      // Formspree: a clear subject line, and replying goes straight to the visitor when they chose email.
      data.set('_subject', title);
      if (contact.type === 'email') data.set('_replyto', contact.value);

      label.textContent = sending!;
      form.classList.add('is-busy');
      try {
        const res = await fetch(endpoint!, { method: 'POST', body: data, headers: { Accept: 'application/json' } });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        sync();
        form.classList.add('is-sent');
        status.textContent = sent!;
      } catch {
        status.innerHTML = `${error} <a href="${instagram}" target="_blank" rel="noopener">Instagram</a>.`;
      } finally {
        label.textContent = original;
        form.classList.remove('is-busy');
      }
    });
  });
</script>

<style>
  .form,
  .topic {
    display: grid;
    gap: 1.3rem;
  }
  fieldset {
    margin: 0;
    padding: 0;
    border: 0;
    min-width: 0;
  }
  .sub[hidden],
  .topic[hidden],
  .actions[hidden] {
    display: none;
  }
  .row {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 220px), 1fr));
    gap: 1.1rem;
  }
  label {
    display: grid;
    gap: 0.45rem;
  }
  label > span,
  legend,
  .you__title {
    font-size: 0.75rem;
    font-weight: 600;
    letter-spacing: 0.16em;
    text-transform: uppercase;
    color: var(--muted);
  }
  legend {
    margin-bottom: 0.6rem;
    padding: 0;
  }
  .you {
    padding-top: 1.4rem;
    border-top: 1px solid var(--line);
  }
  .you__title {
    margin: 0;
    color: var(--gold);
  }
  .note {
    margin: 0;
    padding: 0.8rem 1.1rem;
    border: 1px solid var(--line);
    border-radius: 12px;
    color: var(--ivory);
    font-size: 0.95rem;
  }
  .hint {
    margin: 0.5rem 0 0;
    font-size: 0.85rem;
    color: var(--muted);
  }

  /* Radio choices as pills; checkboxes as a simple list. */
  .pills {
    display: flex;
    flex-wrap: wrap;
    gap: 0.6rem;
  }
  .pill {
    position: relative;
    display: block;
    cursor: pointer;
  }
  .pill input,
  .check input {
    position: absolute;
    opacity: 0;
    width: 1px;
    height: 1px;
  }
  .pill span {
    display: block;
    padding: 0.7rem 1.2rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: var(--field-bg);
    color: var(--ivory);
    font-size: 0.95rem;
    letter-spacing: normal;
    text-transform: none;
    font-weight: 500;
    transition: border-color 0.3s, background 0.3s, color 0.3s;
  }
  .pill:hover span {
    border-color: var(--gold);
  }
  /* Plain brand colours for the chosen option and the send button: maroon with white lettering. */
  .pill input:checked + span {
    border-color: transparent;
    background: #800000;
    color: #f6efe6;
    font-weight: 600;
  }
  .actions :global(.btn--gold),
  .actions :global(.btn--gold:hover) {
    background: #800000;
    color: #f6efe6;
    box-shadow: none;
  }
  .actions :global(.btn--gold::after) {
    display: none;
  }
  .pill input:focus-visible + span,
  .check input:focus-visible + span::before {
    outline: 2px solid var(--gold-2);
    outline-offset: 3px;
  }
  .checks {
    display: grid;
    gap: 0.6rem;
  }
  .check {
    position: relative;
    display: flex;
    align-items: center;
    cursor: pointer;
  }
  .check span {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    color: var(--ivory);
    font-size: 1rem;
    font-weight: 400;
    letter-spacing: normal;
    text-transform: none;
  }
  .check span::before {
