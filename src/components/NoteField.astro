---
/** Ambient stage: soft spotlights behind everything. */
---

<div class="stage" aria-hidden="true">
  <div class="spot spot-a"></div>
  <div class="spot spot-b"></div>
  <div class="spot spot-c"></div>
</div>

<style>
  .stage {
    position: fixed;
    inset: 0;
    z-index: -1;
    overflow: hidden;
    pointer-events: none;
    background: radial-gradient(ellipse 120% 80% at 50% -10%, var(--stage-top) 0%, var(--ink) 60%);
  }
  .spot {
    position: absolute;
    border-radius: 50%;
    filter: blur(90px);
    opacity: 0.5;
    animation: float 26s ease-in-out infinite alternate;
  }
  .spot-a {
    width: 46vmax;
    height: 46vmax;
    left: -12vmax;
    top: -8vmax;
    background: radial-gradient(circle, rgb(var(--wine-rgb) / 0.55), transparent 65%);
  }
  .spot-b {
    width: 40vmax;
    height: 40vmax;
    right: -14vmax;
    top: 30vh;
    background: radial-gradient(circle, rgb(var(--violet-rgb) / 0.55), transparent 65%);
    animation-duration: 32s;
    animation-delay: -10s;
  }
  .spot-c {
    width: 30vmax;
    height: 30vmax;
    left: 30vw;
    bottom: -14vmax;
    background: radial-gradient(circle, rgb(var(--accent-rgb) / 0.22), transparent 65%);
    animation-duration: 22s;
    animation-delay: -4s;
  }
  @keyframes float {
    to {
      transform: translate(6vw, 5vh) scale(1.12);
    }
  }
</style>
