---
/**
 * An email or phone link that only appears in the browser: the HTML holds an encoded value
 * and the generic label (the slot) until the script below fills in the real address.
 */
import { encode } from '../lib/obfuscate';

interface Props {
  kind: 'email' | 'phone';
  value: string;
  subject?: string;
  class?: string;
}
const { kind, value, subject, class: cls } = Astro.props;
---

<a class={cls} data-protected={encode(value)} data-kind={kind} data-subject={subject}>
  <slot name="icon" /> <span data-protected-text><slot /></span>
</a>

<script>
  import { decode } from '../lib/obfuscate';

  document.querySelectorAll<HTMLAnchorElement>('[data-protected]').forEach((a) => {
    const value = decode(a.dataset.protected!);
    const { kind, subject } = a.dataset;
    a.href =
      kind === 'phone'
        ? `tel:${value.replace(/\s/g, '')}`
        : `mailto:${value}${subject ? `?subject=${encodeURIComponent(subject)}` : ''}`;
    a.querySelector('[data-protected-text]')!.textContent = value;
    a.removeAttribute('data-protected');
  });
</script>
