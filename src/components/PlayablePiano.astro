---
import { asset, useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

// C3 … E5: 17 white keys, 12 black keys. MIDI 48 = C3.
const NAMES = ['C', 'C#', 'D', 'D#', 'E', 'F', 'F#', 'G', 'G#', 'A', 'A#', 'B'];
const KEYMAP: Record<number, string> = {
  60: 'a', 61: 'w', 62: 's', 63: 'e', 64: 'd', 65: 'f', 66: 't', 67: 'g',
  68: 'y', 69: 'h', 70: 'u', 71: 'j', 72: 'k', 73: 'o', 74: 'l', 75: 'p', 76: ';',
};
type Key = { midi: number; name: string; black: boolean; wi: number; kb?: string };
const keys: Key[] = [];
let wi = -1;
for (let midi = 48; midi <= 76; midi++) {
  const name = NAMES[midi % 12] + (Math.floor(midi / 12) - 1);
  const black = name.includes('#');
  if (!black) wi++;
  keys.push({ midi, name, black, wi, kb: KEYMAP[midi] });
}
const whites = keys.filter((k) => !k.black);
const blacks = keys.filter((k) => k.black);
---

<div class="piano" data-piano data-samples={asset('/audio/piano/')}>
  <div class="piano__bar">
    <p class="hint">{t('piano.hint')}</p>
  </div>

  <div class="board">
    <div class="sparks" data-sparks aria-hidden="true"></div>
    <div class="keys" role="group" aria-label="Piano">
      {
        whites.map((k) => (
          <button
            type="button"
            class:list={['key', 'white', { low: k.midi < 60 }]}
            data-midi={k.midi}
            aria-label={k.name}
            style={`--wi:${k.wi}`}
          >
            {k.kb && <span class="kb">{k.kb.toUpperCase()}</span>}
          </button>
        ))
      }
      {
        blacks.map((k) => (
          <button
            type="button"
            class:list={['key', 'black', { low: k.midi < 60 }]}
            data-midi={k.midi}
            aria-label={k.name}
            style={`--wi:${k.wi}`}
            tabindex="-1"
          >
            {k.kb && <span class="kb">{k.kb.toUpperCase()}</span>}
          </button>
        ))
      }
    </div>
    <div class="felt" aria-hidden="true"></div>
  </div>
  <p class="credit">
    {t('piano.credit')}{' '}
    <a href="https://archive.org/details/SalamanderGrandPianoV3" target="_blank" rel="noopener">Salamander Grand Piano</a>,
    Alexander Holm (<a href="https://creativecommons.org/licenses/by/3.0/" target="_blank" rel="noopener">CC BY 3.0</a>)
  </p>
</div>

<script>
  const root = document.querySelector<HTMLElement>('[data-piano]');
  if (root) {
    const sparks = root.querySelector<HTMLElement>('[data-sparks]')!;
    const keyEls = new Map<number, HTMLElement>();
    root.querySelectorAll<HTMLElement>('[data-midi]').forEach((el) => keyEls.set(Number(el.dataset.midi), el));

    // ---------- Sound: a real grand piano (Salamander Grand Piano, Alexander Holm, CC BY 3.0) ----------
    // One recording every three semitones; the notes in between are the nearest recording, retuned.
    // If the recordings cannot load, a small synth stands in so the piano is never silent.
    const SAMPLES: Record<number, string> = {
      48: 'C3', 51: 'Ds3', 54: 'Fs3', 57: 'A3', 60: 'C4', 63: 'Ds4', 66: 'Fs4', 69: 'A4', 72: 'C5', 75: 'Ds5',
    };
    let ctx: AudioContext | undefined;
    let master: GainNode;
    const voices = new Map<number, GainNode>();
    const buffers = new Map<number, AudioBuffer>();

    // Recordings are decoded ahead of time, so even the very first touch sounds like the real piano.
    let loading = false;
    const load = () => {
      if (loading) return;
      loading = true;
      const decoder = new OfflineAudioContext(2, 1, 44100);
      Promise.all(
        Object.entries(SAMPLES).map(([m, name]) =>
          fetch(root.dataset.samples + name + '.mp3')
            .then((r) => (r.ok ? r.arrayBuffer() : Promise.reject(r.status)))
            .then((data) => decoder.decodeAudioData(data))
            .then((b) => void buffers.set(Number(m), b)),
        ),
      ).catch(() => {});
    };

    // Fetch the recordings as the piano comes into view, so they are ready before the first touch.
    const io = new IntersectionObserver(
      (entries) => {
        if (entries.some((e) => e.isIntersecting)) {
          io.disconnect();
          load();
        }
      },
      { rootMargin: '300px' },
    );
    io.observe(root);

    const audio = () => {
      if (ctx) return ctx;
      ctx = new AudioContext();
      const comp = ctx.createDynamicsCompressor();
      comp.threshold.value = -18;
      comp.ratio.value = 4;
      master = ctx.createGain();
      master.gain.value = 0.9;

      // Small synthetic hall: decaying stereo noise impulse.
      const len = ctx.sampleRate * 2.4;
      const ir = ctx.createBuffer(2, len, ctx.sampleRate);
      for (let c = 0; c < 2; c++) {
        const d = ir.getChannelData(c);
        for (let i = 0; i < len; i++) d[i] = (Math.random() * 2 - 1) * Math.pow(1 - i / len, 3.2);
      }
      const verb = ctx.createConvolver();
      verb.buffer = ir;
      const wet = ctx.createGain();
      wet.gain.value = 0.16;

      master.connect(comp);
      master.connect(verb).connect(wet).connect(comp);
      comp.connect(ctx.destination);

      load();
      return ctx;
    };

    const freq = (m: number) => 440 * Math.pow(2, (m - 69) / 12);

    const nearest = (midi: number) => {
      let best: number | undefined;
      for (const m of buffers.keys()) if (best === undefined || Math.abs(m - midi) < Math.abs(best - midi)) best = m;
      return best;
    };

    const strike = (midi: number, velocity = 0.8) => {
      const ac = audio();
      if (ac.state === 'suspended') ac.resume();
      const now = ac.currentTime;
      const out = ac.createGain();
      const base = nearest(midi);

      if (base !== undefined) {
        const src = ac.createBufferSource();
        src.buffer = buffers.get(base)!;
        src.playbackRate.value = Math.pow(2, (midi - base) / 12);
        // Softer touch: quieter and a little darker, as on a real instrument.
        const tone = ac.createBiquadFilter();
        tone.type = 'lowpass';
        tone.frequency.value = 1800 + velocity * velocity * 14000;
        out.gain.value = 1.1 * Math.pow(velocity, 1.4);
        src.connect(tone).connect(out).connect(master);
        src.start(now);
      } else {
        const f = freq(midi);
        const peak = 0.22 * velocity;
        out.gain.setValueAtTime(0.0001, now);
        out.gain.exponentialRampToValueAtTime(peak, now + 0.006);
        out.gain.exponentialRampToValueAtTime(peak * 0.35, now + 0.4);
        out.gain.exponentialRampToValueAtTime(0.0001, now + 3.2 - (midi - 48) * 0.03);

        const lp = ac.createBiquadFilter();
        lp.type = 'lowpass';
        lp.frequency.setValueAtTime(Math.min(f * 9, 12000), now);
        lp.frequency.exponentialRampToValueAtTime(Math.max(f * 2, 400), now + 1.2);
        lp.connect(out).connect(master);

        [
          [1, 1],
          [2, 0.42],
          [3, 0.18],
          [4, 0.09],
          [5, 0.05],
        ].forEach(([h, amp], i) => {
          const o = ac.createOscillator();
          const g = ac.createGain();
          o.type = i === 0 ? 'triangle' : 'sine';
          o.frequency.value = f * h * (1 + (i ? 0.0007 * h : 0));
          g.gain.value = amp;
          o.connect(g).connect(lp);
          o.start(now);
          o.stop(now + 3.4);
        });
      }

      voices.get(midi)?.gain.setTargetAtTime(0.0001, now, 0.05);
      voices.set(midi, out);
    };

    const release = (midi: number) => {
      const v = voices.get(midi);
      if (!v || !ctx) return;
      v.gain.cancelScheduledValues(ctx.currentTime);
      v.gain.setTargetAtTime(0.0001, ctx.currentTime, 0.35);
      voices.delete(midi);
    };

    // ---------- Visuals ----------
    const glyphs = ['♪', '♫', '♩', '♬'];
    const glow = (midi: number, ms = 260) => {
      const el = keyEls.get(midi);
      if (!el) return;
      el.classList.add('down');
      if (ms) setTimeout(() => el.classList.remove('down'), ms);
      if (el.offsetParent === null) return; // hidden on small screens
      const r = el.getBoundingClientRect();
      const b = sparks.getBoundingClientRect();
      const x = r.left + r.width / 2 - b.left;
      const s = document.createElement('span');
      s.className = 'spark';
      s.textContent = glyphs[(Math.random() * glyphs.length) | 0];
      s.style.left = x + 'px';
      s.style.setProperty('--dx', (Math.random() * 60 - 30).toFixed(0) + 'px');
      s.style.setProperty('--hue', String((midi * 7) % 30));
      const beam = document.createElement('span');
      beam.className = 'beam';
      beam.style.left = x + 'px';
      beam.style.width = r.width + 'px';
      sparks.append(beam, s);
      s.addEventListener('animationend', () => s.remove());
      beam.addEventListener('animationend', () => beam.remove());
    };

    const press = (midi: number, hold = false) => {
      strike(midi);
      glow(midi, hold ? 0 : 260);
    };
    const lift = (midi: number) => {
      release(midi);
      keyEls.get(midi)?.classList.remove('down');
    };

    // Pointer: press, glide across keys, release.
    let pointerDown = false;
    let current: number | undefined;
    root.querySelectorAll<HTMLElement>('[data-midi]').forEach((el) => {
      const midi = Number(el.dataset.midi);
      el.addEventListener('pointerdown', (e) => {
        e.preventDefault();
        pointerDown = true;
        current = midi;
        press(midi, true);
      });
      el.addEventListener('pointerenter', () => {
        if (!pointerDown || current === midi) return;
        if (current !== undefined) lift(current);
        current = midi;
        press(midi, true);
      });
      el.addEventListener('keydown', (e) => {
        if ((e.key === 'Enter' || e.key === ' ') && !e.repeat) {
          e.preventDefault();
          press(midi);
        }
      });
    });
    addEventListener('pointerup', () => {
      pointerDown = false;
      if (current !== undefined) lift(current);
      current = undefined;
    });

    // Computer keyboard.
    const kbMap = new Map<string, number>();
    root.querySelectorAll<HTMLElement>('[data-midi]').forEach((el) => {
      const kb = el.querySelector('.kb')?.textContent?.toLowerCase();
      if (kb) kbMap.set(kb, Number(el.dataset.midi));
    });
    const typing = (e: KeyboardEvent) =>
      e.target instanceof HTMLElement && e.target.closest('input, textarea, select, [contenteditable]');
    addEventListener('keydown', (e) => {
      if (e.repeat || e.metaKey || e.ctrlKey || e.altKey || typing(e)) return;
      const midi = kbMap.get(e.key.toLowerCase());
      if (midi === undefined) return;
      const r = root.getBoundingClientRect();
      if (r.bottom < 0 || r.top > innerHeight) return; // only while the piano is on screen
      press(midi, true);
    });
    addEventListener('keyup', (e) => {
      const midi = kbMap.get(e.key.toLowerCase());
      if (midi !== undefined) lift(midi);
    });

    // ---------- Silent golden glissando when the piano first appears ----------
    if (!matchMedia('(prefers-reduced-motion: reduce)').matches) {
      const io = new IntersectionObserver((entries) => {
        if (!entries[0].isIntersecting) return;
        io.disconnect();
        [...keyEls.keys()].forEach((midi, i) => setTimeout(() => keyEls.get(midi)?.classList.add('gliss'), 400 + i * 45));
        setTimeout(() => keyEls.forEach((el) => el.classList.remove('gliss')), 400 + keyEls.size * 45 + 900);
      });
      io.observe(root);
    }
  }
</script>

<style>
  .piano {
    --n: 17;
    --off: 0;
    position: relative;
    width: 100%;
  }
  .piano__bar {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 0.6rem 1.2rem;
    margin-bottom: 1rem;
  }
  .hint {
    padding: 0.35rem 0.85rem;
    border-radius: 99px;
    background: rgb(var(--bg-rgb) / 0.72);
    backdrop-filter: blur(8px);
  }
  .credit {
    margin: 0.6rem 0 0;
    font-size: 0.7rem;
    color: var(--ivory-dim);
    opacity: 0.75;
  }
  .credit a {
    color: inherit;
    text-decoration: underline;
    text-underline-offset: 2px;
    white-space: nowrap;
  }
  .hint {
    margin: 0;
    font-size: 0.8rem;
    color: var(--ivory-dim);
  }
  .board {
    position: relative;
    padding: 14px 14px 0;
    border-radius: 20px 20px 10px 10px;
    background: linear-gradient(180deg, #19161f, #08070b);
    box-shadow:
      0 40px 80px -30px rgba(0, 0, 0, 0.9),
      0 0 0 1px rgba(255, 255, 255, 0.06) inset,
      0 0 90px -20px rgb(var(--accent-rgb) / 0.25);
  }
  .felt {
    position: absolute;
    left: 14px;
    right: 14px;
    top: 10px;
    height: 4px;
    border-radius: 2px;
    background: linear-gradient(90deg, #6d1f35, #8c2a46, #6d1f35);
  }
  .keys {
    position: relative;
    display: flex;
    height: clamp(150px, 12vw + 80px, 230px);
    touch-action: none;
    user-select: none;
    -webkit-user-select: none;
  }
  .key {
    border: 0;
    padding: 0;
    cursor: pointer;
    -webkit-tap-highlight-color: transparent;
    font: inherit;
  }
  .white {
    flex: 1;
    position: relative;
    margin: 0 1px;
    border-radius: 0 0 8px 8px;
    background: linear-gradient(180deg, #d8cfbd 0%, #f6efe1 12%, #fffaf0 85%, #e2d8c4 100%);
    box-shadow:
      0 6px 0 #b7ac96,
      0 8px 12px rgba(0, 0, 0, 0.5);
    transform-origin: top;
    transition: transform 0.08s, box-shadow 0.08s, background 0.2s;
  }
  .black {
    position: absolute;
    top: 0;
    z-index: 2;
    left: calc((var(--wi) + 1 - var(--off)) * 100% / var(--n));
    width: calc(100% / var(--n) * 0.62);
    height: 62%;
    translate: -50% 0;
    border-radius: 0 0 6px 6px;
    background: linear-gradient(180deg, #050407 0%, #26222c 70%, #3a3442 92%, #121016 100%);
    box-shadow:
      0 5px 0 #000,
      0 8px 10px rgba(0, 0, 0, 0.6),
      inset 0 -3px 2px rgba(255, 255, 255, 0.12);
    transition: transform 0.08s, box-shadow 0.08s, background 0.2s;
  }
  .kb {
    position: absolute;
    left: 50%;
    bottom: 12px;
    translate: -50% 0;
    font-size: 0.65rem;
    font-weight: 700;
    letter-spacing: 0.05em;
    color: rgba(7, 6, 10, 0.32);
    pointer-events: none;
  }
  .black .kb {
    bottom: 8px;
    color: rgba(244, 236, 220, 0.35);
  }
  .white.down,
  .white:active {
    transform: perspective(400px) rotateX(-4deg);
    background: linear-gradient(180deg, var(--key-lit-1) 0%, var(--key-lit-2) 30%, var(--key-lit-3) 100%);
    box-shadow:
      0 2px 0 var(--key-lit-edge),
      0 0 30px rgb(var(--accent-2-rgb) / 0.8);
  }
  .black.down,
  .black:active {
    transform: perspective(400px) rotateX(-6deg);
    background: linear-gradient(180deg, var(--key-lit-black), var(--key-lit-1));
    box-shadow:
      0 2px 0 #000,
      0 0 24px rgb(var(--accent-2-rgb) / 0.8);
  }
  .white.gliss {
    background: linear-gradient(180deg, #d8cfbd, var(--key-lit-3) 50%, var(--key-lit-2));
    box-shadow:
      0 6px 0 #b7ac96,
      0 0 22px rgb(var(--accent-2-rgb) / 0.55);
  }
  .black.gliss {
    background: linear-gradient(180deg, #2a2030, var(--key-lit-edge));
  }
  .sparks {
    position: absolute;
    left: 14px;
    right: 14px;
    bottom: 100%;
    height: 340px;
    pointer-events: none;
    overflow: visible;
  }
  .sparks :global(.spark) {
    position: absolute;
    bottom: 0;
    translate: -50% 0;
    font-size: 1.8rem;
    color: hsl(calc(var(--spark-hue) + var(--hue)) 75% var(--spark-l));
    text-shadow:
      0 0 14px hsl(calc(var(--spark-hue) + var(--hue)) 90% 65% / 0.9),
      0 0 40px hsl(calc(var(--spark-hue) + var(--hue)) 90% 60% / 0.5);
    animation: sparkUp 1.8s var(--ease) forwards;
  }
  .sparks :global(.beam) {
    position: absolute;
    bottom: -14px;
    height: 240px;
    translate: -50% 0;
    background: linear-gradient(0deg, rgb(var(--accent-2-rgb) / 0.5), transparent);
    filter: blur(6px);
    animation: beam 0.9s ease-out forwards;
  }
  @keyframes sparkUp {
    from {
      opacity: 0;
      transform: translateY(0) scale(0.6);
    }
    15% {
      opacity: 1;
    }
    to {
      opacity: 0;
      transform: translate(var(--dx), -280px) scale(1.25) rotate(18deg);
    }
  }
  @keyframes beam {
    from {
      opacity: 0.9;
    }
    to {
      opacity: 0;
      transform: scaleY(1.3);
    }
  }
  @media (max-width: 700px) {
    .piano {
      --n: 10;
      --off: 7;
    }
    .low {
      display: none;
    }
    .piano__bar {
      display: none;
    }
  }
</style>
