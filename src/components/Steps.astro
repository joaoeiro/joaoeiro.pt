---
/** Numbered timeline, each step a "measure" on a staff. */
interface Props {
  steps: { title: string; text: string }[];
}
const { steps } = Astro.props;
---

<ol class="steps">
  {
    steps.map((s, i) => (
      <li class="reveal" style={`--i:${i}`}>
        <span class="num">{String(i + 1).padStart(2, '0')}</span>
        <h3>{s.title}</h3>
        <p>{s.text}</p>
      </li>
    ))
  }
</ol>

<style>
  .steps {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 230px), 1fr));
    gap: 0;
    counter-reset: s;
  }
  li {
    position: relative;
    padding: 2rem 1.6rem 1rem 0;
    border-top: 1px solid rgb(var(--accent-rgb) / 0.4);
  }
  li::before {
    content: '';
    position: absolute;
    top: -6px;
    left: 0;
    width: 11px;
    height: 11px;
    border-radius: 50%;
    background: var(--gold);
    box-shadow: 0 0 18px var(--gold);
  }
  li::after {
    content: '';
    position: absolute;
    top: -14px;
    right: 1.6rem;
    width: 1px;
    height: 28px;
    background: rgb(var(--accent-rgb) / 0.4);
  }
  .num {
    display: block;
    font-family: var(--font-display);
    font-size: 3rem;
    line-height: 1;
    color: transparent;
    -webkit-text-stroke: 1px var(--gold);
    margin-bottom: 0.8rem;
  }
  h3 {
    font-size: 1.55rem;
    margin-bottom: 0.4rem;
  }
  p {
    color: var(--ivory-dim);
    font-size: 0.95rem;
  }
</style>
