---
import Icon from './Icon.astro';
import { site } from '../config/site';
import { useT, type Lang } from '../i18n';
import type { SocialPost, YouTubeVideo } from '../data/media';

interface Props {
  lang: Lang;
  youtube: YouTubeVideo[];
  tiktok: SocialPost[];
  instagram: SocialPost[];
  /** Max items per platform (home page teaser). */
  limit?: number;
}
const { lang, youtube, tiktok, instagram, limit = Infinity } = Astro.props;
const t = useT(lang);

const yt = youtube.slice(0, limit);
const tt = tiktok.slice(0, limit);
const ig = instagram.slice(0, limit);
const tiktokId = (url: string) => url.match(/video\/(\d+)/)?.[1] ?? '';
const handle = (url: string) => '@' + url.replace(/\/$/, '').split('/').pop()!.replace(/^@/, '');

// Order tabs so the platform with content comes first.
const tabs = (
  [
    { key: 'youtube', label: t('media.youtube'), count: yt.length, href: site.socials.youtube },
    { key: 'tiktok', label: t('media.tiktok'), count: tt.length, href: site.socials.tiktok },
    { key: 'instagram', label: t('media.instagram'), count: ig.length, href: site.socials.instagram },
  ] as const
).filter((tab) => tab.href);
const first = tabs.find((tab) => tab.count > 0)?.key ?? tabs[0]?.key;
const uid = `vg-${Math.random().toString(36).slice(2, 8)}`;
---

<div class="gallery" data-gallery>
  <div class="tabs" role="tablist" aria-label="Videos">
    {
      tabs.map((tab) => (
        <button
          type="button"
          role="tab"
          id={`${uid}-tab-${tab.key}`}
          aria-controls={`${uid}-${tab.key}`}
          aria-selected={tab.key === first ? 'true' : 'false'}
          tabindex={tab.key === first ? 0 : -1}
          data-tab={tab.key}
        >
          <Icon name={tab.key} size={18} />
          {tab.label}
          {tab.count > 0 && <span class="count">{tab.count}</span>}
        </button>
      ))
    }
  </div>

  {
    tabs.map((tab) => (
      <div
        class="panel"
        role="tabpanel"
        id={`${uid}-${tab.key}`}
        aria-labelledby={`${uid}-tab-${tab.key}`}
        data-panel={tab.key}
        hidden={tab.key !== first}
      >
        {tab.key === 'youtube' && (
          <div class="yt-grid">
            {yt.map((v, i) => (
              <button
                type="button"
                class:list={['yt reveal', { short: v.short }]}
                style={`--i:${i % 6}`}
                data-yt={v.id}
                aria-label={`${t('media.play')}: ${v.title}`}
              >
                <img
                  src={`https://i.ytimg.com/vi/${v.id}/hqdefault.jpg`}
                  alt=""
                  loading="lazy"
                  decoding="async"
                  width="480"
                  height="360"
                />
                <span class="yt__play">
                  <Icon name="play" size={26} />
                </span>
                <span class="yt__title">{v.title}</span>
              </button>
            ))}
            <a class="channel reveal" href={tab.href} target="_blank" rel="noopener">
              <span class="vinyl" aria-hidden="true"></span>
              <span class="channel__body">
                <Icon name="youtube" size={30} />
                <strong>{handle(tab.href)}</strong>
                <span>{yt.length ? t('media.more') : t('media.empty')}</span>
              </span>
            </a>
          </div>
        )}

        {tab.key === 'tiktok' && (
          <div class="social-grid" data-embed="tiktok">
            {tt.map((p) => (
              <div class="social-item reveal">
                <blockquote class="tiktok-embed" cite={p.url} data-video-id={tiktokId(p.url)}>
                  <section>
                    <a href={p.url} target="_blank" rel="noopener">
                      {p.caption ?? handle(tab.href)}
                    </a>
                  </section>
                </blockquote>
              </div>
            ))}
            <a class="channel channel--tall reveal" href={tab.href} target="_blank" rel="noopener">
              <span class="vinyl" aria-hidden="true"></span>
              <span class="channel__body">
                <Icon name="tiktok" size={30} />
                <strong>{handle(tab.href)}</strong>
                <span>
                  {t('media.follow')} {tab.label}
                </span>
              </span>
            </a>
          </div>
        )}

        {tab.key === 'instagram' && (
          <div class="social-grid" data-embed="instagram">
            {ig.map((p) => (
              <div class="social-item reveal">
                <blockquote class="instagram-media" data-instgrm-permalink={p.url} data-instgrm-version="14">
                  <a href={p.url} target="_blank" rel="noopener">
                    {p.caption ?? handle(tab.href)}
                  </a>
                </blockquote>
              </div>
            ))}
            <a class="channel channel--tall reveal" href={tab.href} target="_blank" rel="noopener">
              <span class="vinyl" aria-hidden="true"></span>
              <span class="channel__body">
                <Icon name="instagram" size={30} />
                <strong>{handle(tab.href)}</strong>
                <span>
                  {t('media.follow')} {tab.label}
                </span>
              </span>
            </a>
          </div>
        )}
      </div>
    ))
  }
</div>

<script>
  const scripts: Record<string, string> = {
    tiktok: 'https://www.tiktok.com/embed.js',
    instagram: 'https://www.instagram.com/embed.js',
  };
  const loaded = new Set<string>();

  /** Third-party embed scripts load only when their panel is visible on screen. */
  const loadEmbeds = (panel: HTMLElement) => {
    const kind = panel.querySelector<HTMLElement>('[data-embed]')?.dataset.embed;
    if (!kind || loaded.has(kind) || !panel.querySelector('blockquote')) return;
    loaded.add(kind);
    const s = document.createElement('script');
    s.src = scripts[kind];
    s.async = true;
    document.body.appendChild(s);
  };

  document.querySelectorAll<HTMLElement>('[data-gallery]').forEach((gallery) => {
    const tabs = [...gallery.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...gallery.querySelectorAll<HTMLElement>('[data-panel]')];

    const select = (key: string, focus = false) => {
      tabs.forEach((tab) => {
        const on = tab.dataset.tab === key;
        tab.setAttribute('aria-selected', String(on));
        tab.tabIndex = on ? 0 : -1;
        if (on && focus) tab.focus();
      });
      panels.forEach((p) => {
        p.hidden = p.dataset.panel !== key;
        if (!p.hidden) {
          p.querySelectorAll('.reveal').forEach((el) => el.classList.add('is-visible'));
          loadEmbeds(p);
        }
      });
    };
    tabs.forEach((tab, i) => {
      tab.addEventListener('click', () => select(tab.dataset.tab!));
      tab.addEventListener('keydown', (e) => {
        const d = e.key === 'ArrowRight' ? 1 : e.key === 'ArrowLeft' ? -1 : 0;
        if (d) select(tabs[(i + d + tabs.length) % tabs.length].dataset.tab!, true);
      });
    });

    new IntersectionObserver((entries, io) => {
      if (!entries[0].isIntersecting) return;
      io.disconnect();
      const open = panels.find((p) => !p.hidden);
      if (open) loadEmbeds(open);
    }, { rootMargin: '200px' }).observe(gallery);

    // YouTube: thumbnail first, the real player only after a click.
    gallery.querySelectorAll<HTMLButtonElement>('[data-yt]').forEach((btn) =>
      btn.addEventListener('click', () => {
        const iframe = document.createElement('iframe');
        iframe.src = `https://www.youtube-nocookie.com/embed/${btn.dataset.yt}?autoplay=1&rel=0`;
        iframe.title = btn.getAttribute('aria-label') ?? 'YouTube';
        iframe.allow = 'accelerometer; autoplay; clipboard-write; encrypted-media; gyroscope; picture-in-picture';
        iframe.allowFullscreen = true;
        const wrap = document.createElement('div');
        wrap.className = btn.className + ' is-playing';
        wrap.appendChild(iframe);
        btn.replaceWith(wrap);
      }),
    );
  });
</script>

<style>
  .tabs {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    padding: 0.4rem;
    margin-bottom: 2rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: rgb(var(--surface-rgb) / calc(0.03 * var(--surface-k)));
  }
  .tabs button {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.7rem 1.2rem;
    border: 0;
    border-radius: 999px;
    background: transparent;
    color: var(--ivory-dim);
    font: 600 0.88rem var(--font-body);
    cursor: pointer;
    transition: 0.35s var(--ease);
  }
  .tabs button[aria-selected='true'] {
    background: var(--gold-grad);
    color: var(--on-accent);
  }
  .count {
    font-size: 0.7rem;
    padding: 0.1rem 0.45rem;
    border-radius: 99px;
    background: rgba(0, 0, 0, 0.18);
  }
  .yt-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 320px), 1fr));
    gap: 1.25rem;
  }
  .yt {
    position: relative;
    aspect-ratio: 16 / 9;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid var(--line);
    background: #000;
    padding: 0;
    cursor: pointer;
    color: #f4ecdc;
    text-align: left;
  }
  .yt.short {
    aspect-ratio: 9 / 16;
    grid-row: span 2;
  }
  .yt img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    opacity: 0.78;
    transform: scale(1.02);
    transition: transform 1.2s var(--ease), opacity 0.6s;
  }
  .yt:hover img {
    transform: scale(1.09);
    opacity: 1;
  }
  .yt::after {
    content: '';
    position: absolute;
    inset: 0;
    background: linear-gradient(180deg, transparent 45%, rgba(7, 6, 10, 0.92));
    pointer-events: none;
  }
  .yt__play {
    position: absolute;
    left: 50%;
    top: 50%;
    z-index: 1;
    display: grid;
    place-items: center;
    width: 68px;
    height: 68px;
    translate: -50% -50%;
    border-radius: 50%;
    background: var(--gold-grad);
    color: var(--on-accent);
    box-shadow: 0 0 0 0 rgb(var(--accent-2-rgb) / 0.6);
    animation: pulse 2.4s infinite;
    transition: transform 0.4s var(--ease);
  }
  .yt:hover .yt__play {
    transform: scale(1.12);
  }
  @keyframes pulse {
    70% {
      box-shadow: 0 0 0 22px rgb(var(--accent-2-rgb) / 0);
    }
    100% {
      box-shadow: 0 0 0 0 rgb(var(--accent-2-rgb) / 0);
    }
  }
  .yt__title {
    position: absolute;
    left: 1.1rem;
    right: 1.1rem;
    bottom: 0.9rem;
    z-index: 1;
    font-family: var(--font-display);
    font-size: 1.25rem;
    line-height: 1.2;
  }
  .yt.is-playing {
    cursor: auto;
  }
  .yt.is-playing::after {
    display: none;
  }
  .yt iframe {
    width: 100%;
    height: 100%;
    border: 0;
  }
  .social-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 325px), 1fr));
    gap: 1.25rem;
    align-items: start;
  }
  .social-item {
    display: flex;
    justify-content: center;
    min-height: 200px;
    border-radius: var(--radius);
    overflow: hidden;
  }
  .social-item :global(blockquote) {
    margin: 0 !important;
    width: 100%;
  }
  .social-item a {
    color: var(--gold-2);
  }
  .channel {
    position: relative;
    display: grid;
    place-items: center;
    min-height: 220px;
    aspect-ratio: 16 / 9;
    overflow: hidden;
    border: 1px dashed rgb(var(--accent-rgb) / 0.4);
    border-radius: var(--radius);
    background: radial-gradient(circle at 30% 20%, rgb(var(--wine-rgb) / 0.4), transparent 60%), rgb(var(--surface-rgb) / calc(0.02 * var(--surface-k)));
    text-align: center;
    transition: border-color 0.4s, transform 0.6s var(--ease);
  }
  .channel--tall {
    aspect-ratio: 9 / 14;
  }
  .channel:hover {
    border-color: var(--gold);
    border-style: solid;
  }
  .channel__body {
    position: relative;
    display: grid;
    justify-items: center;
    gap: 0.5rem;
    padding: 1.5rem;
    color: var(--ivory-dim);
    font-size: 0.92rem;
  }
  .channel__body strong {
    font-family: var(--font-display);
    font-size: 1.6rem;
    font-weight: 500;
    color: var(--ivory);
  }
  .channel__body :global(svg) {
    color: var(--gold);
  }
  .vinyl {
    position: absolute;
    width: 150%;
    aspect-ratio: 1;
    border-radius: 50%;
    right: -95%;
    background:
      radial-gradient(circle, var(--gold) 0 6%, var(--vinyl-label) 6.5% 15%, transparent 15.5%),
      repeating-radial-gradient(circle, var(--vinyl-a) 0 2px, var(--vinyl-b) 3px 5px);
    opacity: 0.55;
    animation: spin 8s linear infinite;
    transition: right 0.9s var(--ease);
  }
  .channel:hover .vinyl {
    right: -70%;
  }
  @keyframes spin {
    to {
      transform: rotate(360deg);
    }
  }
</style>
