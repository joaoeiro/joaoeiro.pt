---
/** Decorative keyboard strip; a golden glissando sweeps across it. */
interface Props {
  octaves?: number;
  height?: number;
}
const { octaves = 7, height = 44 } = Astro.props;
const W = 24;
const whites = Array.from({ length: octaves * 7 + 1 }, (_, i) => i);
// Black keys follow C, D, F, G, A within each octave.
const blacks = whites.filter((i) => i < octaves * 7 && [0, 1, 3, 4, 5].includes(i % 7));
---

<div class="strip" aria-hidden="true" style={`--h:${height}px`}>
  <svg viewBox={`0 0 ${whites.length * W} 100`} preserveAspectRatio="none">
    {
      whites.map((i) => (
        <rect class="w" x={i * W + 0.5} y="0" width={W - 1} height="100" rx="2" style={`--d:${i * 45}ms`} />
      ))
    }
    {
      blacks.map((i) => (
        <rect class="b" x={i * W + W * 0.68} y="0" width={W * 0.64} height="60" rx="2" style={`--d:${i * 45 + 20}ms`} />
      ))
    }
  </svg>
</div>

<style>
  .strip {
    height: var(--h);
    mask: linear-gradient(90deg, transparent, #000 12%, #000 88%, transparent);
    opacity: 0.85;
  }
  svg {
    width: 100%;
    height: 100%;
  }
  .w {
    fill: #e9e0cd;
    animation: lit 7s var(--d) infinite;
  }
  .b {
    fill: #121016;
    animation: litb 7s var(--d) infinite;
  }
  @keyframes lit {
    0%,
    100% {
      fill: #e9e0cd;
    }
    4% {
      fill: var(--key-lit-2);
    }
    10% {
      fill: #e9e0cd;
    }
  }
  @keyframes litb {
    0%,
    100% {
      fill: #121016;
    }
    4% {
      fill: var(--key-lit-edge);
    }
    10% {
      fill: #121016;
    }
  }
</style>
