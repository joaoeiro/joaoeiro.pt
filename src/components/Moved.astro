---
/**
 * Old address of a page that no longer exists: sends visitors (and search engines)
 * to the home-page section that took its place, or to the page's new address.
 */
import { path, sectionHref, type Lang, type RouteKey, type SectionKey } from '../i18n';

interface Props {
  lang: Lang;
  section?: SectionKey;
  /** The page it moved to (the home page by default). */
  route?: RouteKey;
}
const { lang, section, route = 'home' } = Astro.props;
const to = section ? sectionHref(section, lang) : path(route, lang);
const origin = Astro.site ?? 'https://joaoeiro.pt';
---

<!doctype html>
<html lang={lang === 'pt' ? 'pt-PT' : 'en'}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>João Eiró</title>
    <meta name="robots" content="noindex" />
    <link rel="canonical" href={new URL(to, origin).href} />
    <meta http-equiv="refresh" content={`0; url=${to}`} />
    <!-- Keep a section link (/pt/#aulas) when the page itself only moved. -->
    <script is:inline define:vars={{ to }}>location.replace(to.includes('#') ? to : to + location.hash);</script>
  </head>
  <body>
    <a href={to}>João Eiró</a>
  </body>
</html>
