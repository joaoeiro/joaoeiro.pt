---
import Icon from './Icon.astro';
import { site } from '../config/site';
import { useT, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
}
const { lang } = Astro.props;
const t = useT(lang);
// Facebook is left out of the footer on purpose.
const socials = (['youtube', 'instagram', 'tiktok', 'spotify'] as const)
  .filter((k) => site.socials[k])
  .map((k) => ({ key: k, href: site.socials[k] }));
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__follow">
    <h4>{t('footer.follow')}</h4>
    <div class="socials">
      {
        socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.key}>
            <Icon name={s.key} size={26} />
          </a>
        ))
      }
    </div>
    <div class="contacts">
      <a class="mail" href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a>
      {site.phone && <a class="mail" href={`tel:${site.phone.replace(/\s/g, '')}`}><Icon name="phone" size={18} /> {site.phone}</a>}
    </div>
  </div>
  <div class="wrap footer__base">
    <span>© {year} {site.name}. {t('footer.rights')}</span>
    <a href="#main">{t('footer.top')} ↑</a>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: 4rem;
    background: linear-gradient(180deg, transparent, var(--footer-shade));
  }
  .footer__follow {
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    padding-block: 4.5rem 3.5rem;
    text-align: center;
  }
  h4 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin: 0;
  }
  .mail {
    color: var(--ivory-dim);
    transition: color 0.3s;
  }
  .mail:hover {
    color: var(--gold-2);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: 0.4s var(--ease);
  }
  .socials a:hover {
    background: var(--gold-grad);
    color: var(--on-accent);
    transform: translateY(-4px) rotate(-8deg);
    border-color: var(--gold);
  }
  .contacts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 2rem;
  }
  .mail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
  }
  .footer__base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
  }
</style>
