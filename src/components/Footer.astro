---
import Icon from './Icon.astro';
import { site } from '../config/site';
import { path, sectionHref, useT, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
}
const { lang } = Astro.props;
const t = useT(lang);
const socials = (['youtube', 'instagram', 'tiktok', 'spotify', 'facebook'] as const)
  .filter((k) => site.socials[k])
  .map((k) => ({ key: k, href: site.socials[k] }));
const explore = [
  { href: sectionHref('lessons', lang), label: t('nav.lessons') },
  { href: sectionHref('portfolio', lang), label: t('nav.portfolio') },
  { href: sectionHref('shows', lang), label: t('nav.shows') },
  { href: sectionHref('events', lang), label: t('nav.events') },
  { href: sectionHref('press', lang), label: t('nav.press') },
  { href: path('contact', lang), label: t('nav.contact') },
];
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__grid">
    <div>
      <a class="sig" href={path('home', lang)}>João <em>Eiró</em></a>
      <p class="muted">{t('role')}</p>
      <p class="tag">{t('footer.tagline')}</p>
    </div>
    <div>
      <h4>{t('footer.explore')}</h4>
      <ul>
        {
          explore.map((l) => (
            <li>
              <a href={l.href}>{l.label}</a>
            </li>
          ))
        }
      </ul>
    </div>
    <div>
      <h4>{t('footer.follow')}</h4>
      <div class="socials">
        {
          socials.map((s) => (
            <a href={s.href} target="_blank" rel="noopener" aria-label={s.key}>
              <Icon name={s.key} size={20} />
            </a>
          ))
        }
      </div>
      <a class="mail" href={`mailto:${site.email}`}><Icon name="mail" size={16} /> {site.email}</a>
      {site.phone && <a class="mail" href={`tel:${site.phone.replace(/\s/g, '')}`}><Icon name="phone" size={16} /> {site.phone}</a>}
    </div>
  </div>
  <div class="wrap footer__base">
    <span>© {year} {site.name}. {t('footer.rights')}</span>
    <a href="#main">{t('footer.top')} ↑</a>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    margin-top: 4rem;
    background: linear-gradient(180deg, transparent, var(--footer-shade));
  }
  .footer__grid {
    display: grid;
    grid-template-columns: 1.6fr 1fr 1.2fr;
    gap: 2.5rem;
    padding-block: 4rem 2.5rem;
  }
  .sig {
    font-family: var(--font-display);
    font-size: clamp(2.6rem, 2rem + 2vw, 3.8rem);
    line-height: 1;
  }
  .sig em {
    color: var(--gold);
  }
  .tag {
    font-family: var(--font-display);
    font-style: italic;
    font-size: 1.3rem;
    color: var(--ivory-dim);
    max-width: 30ch;
  }
  h4 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin-bottom: 1.2rem;
  }
  ul {
    list-style: none;
    padding: 0;
    margin: 0;
    display: grid;
    gap: 0.55rem;
  }
  ul a,
  .mail {
    color: var(--ivory-dim);
    transition: color 0.3s;
  }
  ul a:hover,
  .mail:hover {
    color: var(--gold-2);
  }
  .socials {
    display: flex;
    gap: 0.6rem;
    margin-bottom: 1.4rem;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 46px;
    height: 46px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: 0.4s var(--ease);
  }
  .socials a:hover {
    background: var(--gold-grad);
    color: var(--on-accent);
    transform: translateY(-4px) rotate(-8deg);
    border-color: var(--gold);
  }
  .mail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.4rem;
    font-size: 0.95rem;
  }
  .footer__base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
  }
  @media (max-width: 760px) {
    .footer__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
