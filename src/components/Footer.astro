---
import Icon from './Icon.astro';
import Signature from './Signature.astro';
import { site } from '../config/site';
import { path, useT, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
}
const { lang, route } = Astro.props;
const t = useT(lang);
// Facebook is left out of the footer on purpose.
const socials = (['instagram', 'tiktok', 'youtube', 'spotify'] as const)
  .filter((k) => site.socials[k])
  .map((k) => ({ key: k, href: site.socials[k] }));
const year = new Date().getFullYear();
---

<footer class="footer">
  <div class="wrap footer__follow">
    <Signature class="footer__sig" onView />
    {
      // Invitation to write; left out on the contact page, which is the form itself.
      route !== 'contact' && (
        <div class="cta">
          <p class="cta__line">{t('footer.ctaLine')}</p>
          <a class="btn btn--gold" href={path('contact', lang)}>
            {t('footer.ctaButton')} <Icon name="arrow" />
          </a>
        </div>
      )
    }
    <h4>{t('footer.follow')}</h4>
    <div class="socials">
      {
        socials.map((s) => (
          <a href={s.href} target="_blank" rel="noopener" aria-label={s.key}>
            <Icon name={s.key} size={26} />
          </a>
        ))
      }
    </div>
    <div class="contacts">
      <a class="mail" href={`mailto:${site.email}`}><Icon name="mail" size={18} /> {site.email}</a>
      {site.phone && <a class="mail" href={`tel:${site.phone.replace(/\s/g, '')}`}><Icon name="phone" size={18} /> {site.phone}</a>}
    </div>
  </div>
  <div class="wrap footer__base">
    <span>© {year} {site.name}. {t('footer.rights')}</span>
    <a class="photo-ask" href={path('contact', lang)}>{t('photo.ask')}</a>
    <a href="#main">{t('footer.top')} ↑</a>
  </div>
</footer>

<style>
  .footer {
    position: relative;
    background: linear-gradient(180deg, transparent, var(--footer-shade));
  }
  .footer__follow {
    display: grid;
    justify-items: center;
    gap: 1.6rem;
    padding-block: 4rem 3.5rem;
    text-align: center;
  }
  .cta {
    display: grid;
    justify-items: center;
    gap: 1.1rem;
    margin-bottom: 1.4rem;
  }
  .cta__line {
    margin: 0;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.6rem, 1.2rem + 1.4vw, 2.4rem);
    line-height: 1.15;
    color: var(--ivory);
  }
  .footer__follow :global(.footer__sig) {
    display: block;
    width: clamp(180px, 8rem + 10vw, 280px);
    margin-bottom: -0.4rem;
  }
  h4 {
    font-family: var(--font-body);
    font-size: 0.75rem;
    letter-spacing: 0.3em;
    text-transform: uppercase;
    color: var(--gold);
    font-weight: 600;
    margin: 0;
  }
  .mail {
    color: var(--ivory-dim);
    transition: color 0.3s;
  }
  .mail:hover {
    color: var(--gold-2);
  }
  .socials {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1rem;
  }
  .socials a {
    display: grid;
    place-items: center;
    width: 64px;
    height: 64px;
    border-radius: 50%;
    border: 1px solid var(--line);
    transition: 0.4s var(--ease);
  }
  /* The site's maroon, flat. */
  .socials a:hover {
    background: #800000;
    color: #f4ecdc;
    transform: translateY(-4px) rotate(-8deg);
    border-color: #800000;
  }
  .contacts {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 0.6rem 2rem;
  }
  .mail {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1rem;
  }
  .photo-ask {
    transition: color 0.3s;
  }
  .photo-ask:hover {
    color: var(--gold-2);
  }
  .footer__base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 1rem;
    padding-block: 1.5rem 2rem;
    border-top: 1px solid var(--line);
    font-size: 0.82rem;
    color: var(--muted);
  }
</style>
