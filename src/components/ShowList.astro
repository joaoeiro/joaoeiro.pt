---
import Icon from './Icon.astro';
import { formatDate, parseLocalDate, pick, useT, type Lang } from '../i18n';
import { shows as allShows, type Show } from '../data/shows';
import { published } from '../lib/drafts';

interface Props {
  lang: Lang;
  /** Which shows to list. */
  when: 'upcoming' | 'past';
  limit?: number;
  /** Text shown when the list is empty (defaults to the standard message). */
  empty?: string;
}
const { lang, when, limit = Infinity, empty } = Astro.props;
const t = useT(lang);

// A show stays "upcoming" until the end of its day.
const endOfDay = (s: Show) => parseLocalDate(s.date.slice(0, 10)).getTime() + 86_400_000;
const now = Date.now();
const sorted = published(allShows)
  .slice()
  .sort((a, b) => a.date.localeCompare(b.date));
const items =
  when === 'upcoming'
    ? sorted.filter((s) => endOfDay(s) > now).slice(0, limit)
    : sorted.filter((s) => endOfDay(s) <= now).reverse().slice(0, limit);

const gcal = (s: Show) => {
  const start = s.date.length > 10 ? s.date : `${s.date}T20:00`;
  const fmt = (d: Date) => d.toISOString().replace(/[-:]/g, '').slice(0, 15);
  const a = parseLocalDate(start);
  const b = new Date(a.getTime() + 2 * 3600_000);
  const q = new URLSearchParams({
    action: 'TEMPLATE',
    text: `${pick(s.title, lang)} — João Eiró`,
    dates: `${fmt(a)}/${fmt(b)}`,
    ctz: 'Europe/Lisbon',
    location: `${s.venue}, ${s.city}`,
    details: s.description ? pick(s.description, lang) : '',
  });
  return `https://calendar.google.com/calendar/render?${q}`;
};
---

<div class:list={['shows', when]} data-shows={when}>
  {
    items.map((s, i) => {
      const d = parseLocalDate(s.date);
      return (
        <article class="show reveal" style={`--i:${i % 5}`} data-end={endOfDay(s)}>
          <div class="date">
            <span class="day">{formatDate(d, lang, { day: '2-digit' })}</span>
            <span class="month">{formatDate(d, lang, { month: 'short' }).replace('.', '')}</span>
            <span class="year">{formatDate(d, lang, { year: 'numeric' })}</span>
          </div>
          <div class="body">
            <h3>{pick(s.title, lang)}</h3>
            <p class="meta">
              <Icon name="pin" size={15} />
              {s.venue} · {s.city}
              {s.date.length > 10 && (
                <span class="time">· {formatDate(d, lang, { hour: '2-digit', minute: '2-digit' })}</span>
              )}
            </p>
            {s.description && <p class="desc">{pick(s.description, lang)}</p>}
          </div>
          {when === 'upcoming' && (
            <div class="cta">
              {s.soldOut ? (
                <span class="badge">{t('shows.soldout')}</span>
              ) : s.ticketUrl ? (
                <a class="btn btn--gold" href={s.ticketUrl} target="_blank" rel="noopener">
                  <Icon name="ticket" size={16} /> {t('shows.tickets')}
                </a>
              ) : s.free ? (
                <span class="badge free">{t('shows.free')}</span>
              ) : null}
              {s.infoUrl && (
                <a class="btn" href={s.infoUrl} target="_blank" rel="noopener">
                  {t('shows.info')}
                </a>
              )}
              <a class="cal" href={gcal(s)} target="_blank" rel="noopener">
                <Icon name="calendar" size={15} /> {t('shows.calendar')}
              </a>
            </div>
          )}
        </article>
      );
    })
  }
  <p class="empty" hidden={items.length > 0} data-empty>
    {empty ?? (when === 'upcoming' ? t('shows.none') : t('shows.nonePast'))}
  </p>
</div>

<script>
  // Hide shows that have finished since the site was last built.
  document.querySelectorAll<HTMLElement>('[data-shows="upcoming"]').forEach((list) => {
    const now = Date.now();
    list.querySelectorAll<HTMLElement>('[data-end]').forEach((el) => {
      if (Number(el.dataset.end) <= now) el.remove();
    });
    const empty = list.querySelector<HTMLElement>('[data-empty]');
    if (empty && !list.querySelector('[data-end]')) empty.hidden = false;
  });
</script>

<style>
  .shows {
    display: grid;
    gap: 1rem;
  }
  .show {
    position: relative;
    display: grid;
    grid-template-columns: auto 1fr auto;
    align-items: center;
    gap: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    padding: clamp(1.2rem, 0.8rem + 1.2vw, 1.8rem) clamp(1.2rem, 0.8rem + 1.5vw, 2.2rem);
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(100deg, rgb(var(--surface-rgb) / calc(0.05 * var(--surface-k))), rgb(var(--surface-rgb) / calc(0.01 * var(--surface-k))));
    overflow: hidden;
    transition: border-color 0.4s, transform 0.6s var(--ease);
  }
  .show::before {
    content: '';
    position: absolute;
    inset: 0 auto 0 0;
    width: 3px;
    background: var(--gold-grad);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.6s var(--ease);
  }
  .show:hover {
    border-color: rgb(var(--accent-rgb) / 0.5);
    transform: translateX(6px);
  }
  .show:hover::before {
    transform: scaleY(1);
  }
  .date {
    display: grid;
    justify-items: center;
    min-width: 84px;
    padding-right: clamp(1rem, 0.5rem + 2vw, 2.5rem);
    border-right: 1px dashed rgb(var(--accent-rgb) / 0.4);
    line-height: 1;
  }
  .day {
    font-family: var(--font-display);
    font-size: 3.4rem;
    color: var(--gold);
  }
  .month {
    text-transform: uppercase;
    letter-spacing: 0.25em;
    font-size: 0.78rem;
    font-weight: 600;
    margin-top: 0.3rem;
  }
  .year {
    font-size: 0.75rem;
    color: var(--muted);
    margin-top: 0.35rem;
  }
  h3 {
    margin-bottom: 0.35rem;
  }
  .meta {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.4rem;
    margin: 0;
    color: var(--ivory-dim);
    font-size: 0.92rem;
  }
  .meta :global(svg) {
    color: var(--gold);
  }
  .desc {
    margin: 0.6rem 0 0;
    color: var(--muted);
    font-size: 0.95rem;
  }
  .cta {
    display: grid;
    justify-items: end;
    gap: 0.6rem;
  }
  .cal {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    font-size: 0.8rem;
    color: var(--muted);
    transition: color 0.3s;
  }
  .cal:hover {
    color: var(--gold-2);
  }
  .badge {
    padding: 0.55rem 1rem;
    border-radius: 99px;
    border: 1px solid var(--wine);
    background: rgb(var(--wine-rgb) / 0.35);
    font-size: 0.8rem;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }
  .badge.free {
    border-color: rgb(var(--accent-rgb) / 0.5);
    background: rgb(var(--accent-rgb) / 0.12);
    color: var(--gold-2);
  }
  .past .show {
    opacity: 0.75;
  }
  .past .day {
    color: var(--ivory-dim);
  }
  .empty {
    margin: 0;
    padding: 2rem;
    border: 1px dashed var(--line);
    border-radius: var(--radius);
    color: var(--ivory-dim);
    text-align: center;
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-style: italic;
  }
  .empty[hidden] {
    display: none;
  }
  @media (max-width: 720px) {
    .show {
      grid-template-columns: auto 1fr;
    }
    .cta {
      grid-column: 1 / -1;
      justify-items: start;
      grid-auto-flow: column;
      justify-content: start;
      align-items: center;
    }
    .day {
      font-size: 2.6rem;
    }
    .date {
      min-width: 64px;
    }
  }
</style>
