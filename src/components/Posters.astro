---
/**
 * Past shows as a wall of posters, newest first — images only, each at its own shape.
 * The show's details stay in the image's alt text. Shows without a poster are left out.
 */
import { asset, parseLocalDate, pick, useT, type Lang } from '../i18n';
import { shows, type Show } from '../data/shows';
import { published } from '../lib/drafts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const endOfDay = (s: Show) => parseLocalDate(s.date.slice(0, 10)).getTime() + 86_400_000;
const now = Date.now();
const past = published(shows)
  .filter((s) => s.image && endOfDay(s) <= now)
  .sort((a, b) => b.date.localeCompare(a.date));
const alt = (s: Show) =>
  [pick(s.title, lang), s.with, [s.venue, s.city].filter(Boolean).join(', ')].filter(Boolean).join(' · ');
---

{
  past.length ? (
    <div class="posters">
      {past.map((s) => (
        <img src={asset(s.image!)} alt={alt(s)} loading="lazy" decoding="async" />
      ))}
    </div>
  ) : (
    <p class="tab-note">{t('shows.nonePast')}</p>
  )
}

<style>
  /* Masonry-style columns, so square and tall posters sit together without cropping. */
  .posters {
    columns: 4 220px;
    column-gap: clamp(1rem, 0.8rem + 1vw, 1.5rem);
  }
  .posters img {
    width: 100%;
    height: auto;
    margin-bottom: clamp(1rem, 0.8rem + 1vw, 1.5rem);
    break-inside: avoid;
    border-radius: 14px;
  }
</style>
