---
/** The groups João plays with most: logo (or name), a short summary and a link. */
import Icon from './Icon.astro';
import { asset, pick, type Lang } from '../i18n';
import { groups } from '../data/groups';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const visit = lang === 'pt' ? 'Visitar' : 'Visit';
const siteLabel = lang === 'pt' ? 'site' : 'website';
---

<div class="groups">
  {
    groups.map((g) => (
      <article class:list={['group', { featured: g.featured }]}>
        <a class="logo" href={g.url} target="_blank" rel="noopener" aria-label={g.name}>
          {g.logo ? <img src={asset(g.logo)} alt={g.name} loading="lazy" /> : <span>{g.name}</span>}
        </a>
        <div class="text">
          <h3>{g.name}</h3>
          {g.summary && <p>{pick(g.summary, lang)}</p>}
          <a class="link" href={g.url} target="_blank" rel="noopener">
            {visit} {g.via ?? siteLabel} <Icon name="arrow" size={16} />
          </a>
        </div>
      </article>
    ))
  }
</div>

<style>
  .groups {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 1.25rem;
  }
  .group {
    display: grid;
    grid-template-columns: minmax(0, 1fr);
    align-content: start;
    gap: 1.2rem;
    padding: clamp(1.4rem, 1rem + 1vw, 2rem);
    border-radius: var(--radius);
    background: rgb(var(--surface-rgb) / calc(0.04 * var(--surface-k)));
  }
  /* The less central group: a slimmer, horizontal card across the full width. */
  .group:not(.featured) {
    grid-column: 1 / -1;
    grid-template-columns: 9rem minmax(0, 1fr);
    align-items: center;
  }
  .logo {
    display: grid;
    place-items: center;
    aspect-ratio: 2 / 1;
    padding: 1rem;
    border-radius: 12px;
    background: #800000;
    color: #d7cfc4;
  }
  .group:not(.featured) .logo {
    aspect-ratio: 1;
  }
  .logo img {
    max-width: 80%;
    max-height: 80%;
    object-fit: contain;
  }
  .logo span {
    font-family: var(--font-display);
    font-size: clamp(1.4rem, 1rem + 1.5vw, 2.2rem);
    font-style: italic;
    text-align: center;
    line-height: 1.1;
  }
  .group:not(.featured) .logo span {
    font-size: 1.2rem;
  }
  .text {
    display: grid;
    gap: 0.6rem;
    align-content: start;
  }
  h3 {
    margin: 0;
    font-size: 1.6rem;
  }
  p {
    margin: 0;
    color: var(--ivory-dim);
  }
  .link {
    display: inline-flex;
    align-items: center;
    gap: 0.4rem;
    justify-self: start;
    color: var(--gold);
    font-weight: 600;
    font-size: 0.92rem;
  }
  @media (max-width: 700px) {
    .groups {
      grid-template-columns: minmax(0, 1fr);
    }
    .group:not(.featured) {
      grid-template-columns: 6rem minmax(0, 1fr);
    }
  }
</style>
