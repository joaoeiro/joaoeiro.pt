---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import VideoGallery from '../components/VideoGallery.astro';
import GrandPiano from '../components/GrandPiano.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import photo from '../assets/joao-eiro-live.jpg';
import { asset, path, pick, useT, type Lang } from '../i18n';
import { instagram, tiktok } from '../data/media';
import { repertoire } from '../data/repertoire';
import { gallery } from '../data/gallery';
import { getYouTubeVideos } from '../lib/youtube';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const youtube = await getYouTubeVideos();

const copy = {
  en: {
    title: 'Portfolio',
    description: 'Videos, repertoire and biography of João Eiró — pianist, piano teacher, accompanist, soloist and improviser.',
    eyebrow: 'Portfolio',
    h1: 'The pianist, in <em>sound</em> and image',
    lead: 'Performances, short musical moments, repertoire and a little about the person behind the keys.',
    bioEyebrow: 'Biography',
    bioTitle: 'Between the score <em>and the moment</em>',
    bio: [
      'João Eiró is a Portuguese pianist and piano teacher. His playing moves between the classical repertoire — the depth of a Beethoven sonata, the colour of Debussy — and the freedom of improvisation, where a melody can become a groove and a groove can become something nobody has heard before.',
      'As an accompanist he supports singers and instrumentalists with attentive, breathing harmony; as a soloist he builds programmes that feel like conversations with the audience. Online he shares short musical moments with a growing community on YouTube, Instagram and TikTok.',
      'As a teacher he believes every student has their own sound, and that technique is simply the way to set it free.',
    ],
    pillars: [
      { g: '𝄞', t: 'Pianist & piano teacher', d: 'Performing and passing on the instrument, side by side.' },
      { g: '♫', t: 'Accompanist & soloist', d: 'Listening first — then knowing when to lead.' },
      { g: '✦', t: 'Compulsive improviser', d: 'Any theme, any mood, on the spot.' },
    ],
    videosEyebrow: 'Videos',
    videosTitle: 'Watch, listen, <em>follow</em>',
    repEyebrow: 'Repertoire',
    repTitle: 'Styles & <em>repertoire</em>',
    photosEyebrow: 'Gallery',
    photosTitle: 'Behind the <em>keys</em>',
    ctaTitle: 'Want this music <em>at your event?</em>',
    ctaText: 'Concerts, private events or a press feature — everything you need is one click away.',
    press: 'Press kit',
  },
  pt: {
    title: 'Portfólio',
    description: 'Vídeos, repertório e biografia de João Eiró — pianista, professor de piano, acompanhador, solista e improvisador.',
    eyebrow: 'Portfólio',
    h1: 'O pianista, em <em>som</em> e imagem',
    lead: 'Atuações, pequenos momentos musicais, repertório e um pouco sobre a pessoa por trás das teclas.',
    bioEyebrow: 'Biografia',
    bioTitle: 'Entre a partitura <em>e o momento</em>',
    bio: [
      'João Eiró é pianista e professor de piano. A sua forma de tocar move-se entre o repertório clássico — a profundidade de uma sonata de Beethoven, a cor de Debussy — e a liberdade da improvisação, onde uma melodia pode tornar-se um groove e um groove pode tornar-se algo que ninguém ouviu antes.',
      'Como acompanhador apoia cantores e instrumentistas com uma harmonia atenta, que respira; como solista constrói programas que soam a conversas com o público. Online partilha pequenos momentos musicais com uma comunidade crescente no YouTube, Instagram e TikTok.',
      'Como professor acredita que cada aluno tem o seu próprio som, e que a técnica é apenas a forma de o libertar.',
    ],
    pillars: [
      { g: '𝄞', t: 'Pianista e professor de piano', d: 'Tocar e passar o instrumento, lado a lado.' },
      { g: '♫', t: 'Músico acompanhador e solista', d: 'Ouvir primeiro — e saber quando liderar.' },
      { g: '✦', t: 'Improvisador compulsivo', d: 'Qualquer tema, qualquer ambiente, no momento.' },
    ],
    videosEyebrow: 'Vídeos',
    videosTitle: 'Ver, ouvir, <em>seguir</em>',
    repEyebrow: 'Repertório',
    repTitle: 'Estilos & <em>repertório</em>',
    photosEyebrow: 'Galeria',
    photosTitle: 'Por trás das <em>teclas</em>',
    ctaTitle: 'Queres esta música <em>no teu evento?</em>',
    ctaText: 'Concertos, eventos privados ou um artigo de imprensa — está tudo a um clique.',
    press: 'Kit de imprensa',
  },
}[lang];
---

<Layout lang={lang} route="portfolio" title={copy.title} description={copy.description}>
  <PageHero eyebrow={copy.eyebrow} title={copy.h1} lead={copy.lead}>
    <div class="btn-row">
      <a class="btn btn--gold" href="#videos"><Icon name="play" size={16} /> {t('cta.watch')}</a>
      <a class="btn" href={path('press', lang)}>{copy.press}</a>
    </div>
  </PageHero>

  <section class="section">
    <div class="wrap split">
      <div class="sticky art reveal">
        <Image
          src={photo}
          alt={lang === 'pt' ? 'João Eiró ao vivo, ao teclado' : 'João Eiró live at the keyboard'}
          widths={[480, 760, 1100]}
          sizes="(max-width: 860px) 90vw, 560px"
        />
        <GrandPiano class="art__piano" />
      </div>
      <div>
        <SectionHead eyebrow={copy.bioEyebrow} title={copy.bioTitle} />
        {copy.bio.map((p, i) => <p class="lead reveal" style={`--i:${i}`}>{p}</p>)}
        <div class="pillars">
          {
            copy.pillars.map((p, i) => (
              <div class="pillar reveal" style={`--i:${i}`}>
                <span aria-hidden="true">{p.g}</span>
                <div>
                  <strong>{p.t}</strong>
                  <p>{p.d}</p>
                </div>
              </div>
            ))
          }
        </div>
      </div>
    </div>
  </section>

  <section class="section" id="videos">
    <div class="wrap">
      <SectionHead eyebrow={copy.videosEyebrow} title={copy.videosTitle} />
      <VideoGallery lang={lang} youtube={youtube} tiktok={tiktok} instagram={instagram} />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={copy.repEyebrow} title={copy.repTitle} />
      <div class="grid grid-4">
        {
          repertoire.map((r, i) => (
            <div class="card reveal rep" style={`--i:${i}`}>
              <h3>{pick(r.style, lang)}</h3>
              <ul class="chips">
                {r.items.map((it) => (
                  <li>{pick(it, lang)}</li>
                ))}
              </ul>
            </div>
          ))
        }
      </div>
    </div>
  </section>

  {
    gallery.length > 0 && (
      <section class="section">
        <div class="wrap">
          <SectionHead eyebrow={copy.photosEyebrow} title={copy.photosTitle} />
          <div class="photos">
            {gallery.map((g, i) => (
              <figure class:list={['reveal', { wide: g.wide }]} style={`--i:${i % 4}`}>
                <img src={asset(g.src)} alt={g.alt} loading="lazy" decoding="async" />
              </figure>
            ))}
          </div>
        </div>
      </section>
    )
  }

  <CtaBand title={copy.ctaTitle} text={copy.ctaText}>
    <a class="btn btn--gold" href={path('contact', lang) + '?s=events'}>{t('cta.contact')} <Icon name="arrow" /></a>
    <a class="btn" href={path('press', lang)}>{copy.press}</a>
  </CtaBand>
</Layout>

<style>
  .art :global(img) {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    object-position: 42% 30%;
    border-radius: 999px 999px var(--radius) var(--radius);
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.7);
  }
  .art :global(.art__piano) {
    width: 70%;
    margin: -12% 0 0 auto;
    position: relative;
  }
  .art {
    padding-top: 4rem;
  }
  .pillars {
    display: grid;
    gap: 0.9rem;
    margin-top: 2rem;
  }
  .pillar {
    display: flex;
    gap: 1.1rem;
    align-items: flex-start;
    padding: 1.1rem 1.3rem;
    border: 1px solid var(--line);
    border-radius: 14px;
    background: rgb(var(--surface-rgb) / calc(0.02 * var(--surface-k)));
  }
  .pillar > span {
    font-size: 1.8rem;
    line-height: 1;
    color: var(--gold);
  }
  .pillar strong {
    font-family: var(--font-display);
    font-size: 1.35rem;
    font-weight: 500;
  }
  .pillar p {
    margin: 0;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .rep h3 {
    color: var(--gold-2);
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 260px), 1fr));
    grid-auto-flow: dense;
    gap: 1rem;
  }
  .photos figure {
    margin: 0;
    overflow: hidden;
    border-radius: var(--radius);
    aspect-ratio: 4 / 5;
  }
  .photos .wide {
    grid-column: span 2;
    aspect-ratio: auto;
  }
  .photos img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 1.2s var(--ease);
  }
  .photos figure:hover img {
    transform: scale(1.06);
  }
</style>
