---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import ContactForm from '../components/ContactForm.astro';
import { type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  en: {
    title: 'Contact',
    description: 'Contact João Eiró for piano lessons, concerts, private and corporate events.',
    eyebrow: 'Contact',
    h1: 'Your message is <em>music to my ears</em>.',
    lead: 'Lessons, a concert, an event... the sky’s the limit! Fill in the form below so I can give your request the best possible answer. I’ll reply as soon as I can, within 48 working hours at most.',
  },
  pt: {
    title: 'Contacto',
    description: 'Contacta o João Eiró para aulas de piano, concertos, eventos privados e corporativos.',
    eyebrow: 'Contacto',
    h1: 'A tua mensagem é <em>música para os meus ouvidos</em>.',
    lead: 'Aulas, um concerto, um evento... o céu é o limite! Preenche abaixo o formulário para poder responder da melhor forma ao teu pedido. Respondo assim que conseguir, no máximo até 48h úteis.',
  },
}[lang];

---

<Layout lang={lang} route="contact" title={copy.title} description={copy.description}>
  <PageHero eyebrow={copy.eyebrow} title={copy.h1} lead={copy.lead} staff={false} />

  <section class="section top">
    <div class="wrap">
      <div class="card form-card reveal">
        <ContactForm lang={lang} />
      </div>
    </div>
  </section>
</Layout>

<style>
  .top {
    padding-top: 0;
  }
  .form-card {
    max-width: 760px;
  }
</style>
