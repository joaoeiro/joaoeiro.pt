---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Icon from '../components/Icon.astro';
import { asset, path, useT, type Lang } from '../i18n';
import { site } from '../config/site';
import { gallery } from '../data/gallery';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const copy = {
  en: {
    title: 'Press',
    description: 'Press kit for João Eiró: short and long biographies, photos, technical requirements and contacts.',
    eyebrow: 'Press & promoters',
    h1: 'Press <em>kit</em>',
    lead: 'Everything journalists, programmers and event organisers need — ready to copy and download.',
    shortTitle: 'Short bio',
    short:
      'João Eiró is a Portuguese pianist and piano teacher, accompanist, soloist and self-confessed compulsive improviser, moving freely between the classical repertoire and the groove of the moment.',
    longTitle: 'Long bio',
    long: [
      'João Eiró is a Portuguese pianist and piano teacher. His playing moves between the classical repertoire and the freedom of improvisation, where a melody can become a groove and a groove can become something new.',
      'As an accompanist he supports singers and instrumentalists; as a soloist he builds programmes that feel like conversations with the audience. He shares short musical moments with a growing online community on YouTube, Instagram and TikTok, and teaches students of all ages.',
    ],
    copy: 'Copy',
    copied: 'Copied!',
    photosTitle: 'Photos',
    photosEmpty: 'High-resolution photos are available on request.',
    riderTitle: 'Technical requirements',
    rider: [
      'Acoustic grand or upright piano, tuned on the day — or a digital stage piano (88 weighted keys)',
      'Adjustable piano bench',
      'For amplified events: 2 DI inputs or microphones for the piano, 1 vocal mic for announcements, monitor',
      'Set-up and sound check: 45–60 minutes before doors',
    ],
    contactTitle: 'Bookings & press contact',
  },
  pt: {
    title: 'Imprensa',
    description: 'Kit de imprensa de João Eiró: biografias curta e longa, fotografias, requisitos técnicos e contactos.',
    eyebrow: 'Imprensa & programadores',
    h1: 'Kit de <em>imprensa</em>',
    lead: 'Tudo o que jornalistas, programadores e organizadores de eventos precisam — pronto a copiar e descarregar.',
    shortTitle: 'Biografia curta',
    short:
      'João Eiró é pianista e professor de piano, músico acompanhador, solista e improvisador compulsivo assumido, que se move livremente entre o repertório clássico e o groove do momento.',
    longTitle: 'Biografia longa',
    long: [
      'João Eiró é pianista e professor de piano. A sua forma de tocar move-se entre o repertório clássico e a liberdade da improvisação, onde uma melodia pode tornar-se um groove e um groove pode tornar-se algo novo.',
      'Como acompanhador apoia cantores e instrumentistas; como solista constrói programas que soam a conversas com o público. Partilha pequenos momentos musicais com uma comunidade crescente no YouTube, Instagram e TikTok, e dá aulas a alunos de todas as idades.',
    ],
    copy: 'Copiar',
    copied: 'Copiado!',
    photosTitle: 'Fotografias',
    photosEmpty: 'Fotografias em alta resolução disponíveis mediante pedido.',
    riderTitle: 'Requisitos técnicos',
    rider: [
      'Piano de cauda ou vertical acústico, afinado no dia — ou piano digital de palco (88 teclas pesadas)',
      'Banco de piano regulável',
      'Para eventos amplificados: 2 entradas DI ou microfones para o piano, 1 microfone de voz para anúncios, monitor',
      'Montagem e teste de som: 45–60 minutos antes da abertura de portas',
    ],
    contactTitle: 'Contacto para reservas & imprensa',
  },
}[lang];
---

<Layout lang={lang} route="press" title={copy.title} description={copy.description}>
  <PageHero eyebrow={copy.eyebrow} title={copy.h1} lead={copy.lead} />

  <section class="section">
    <div class="wrap grid grid-2">
      <article class="card reveal bio">
        <header>
          <h2>{copy.shortTitle}</h2>
          <button class="copy" type="button" data-copy="short-bio" data-done={copy.copied}>{copy.copy}</button>
        </header>
        <p id="short-bio" class="lead">{copy.short}</p>
      </article>
      <article class="card reveal bio" style="--i:1">
        <header>
          <h2>{copy.longTitle}</h2>
          <button class="copy" type="button" data-copy="long-bio" data-done={copy.copied}>{copy.copy}</button>
        </header>
        <div id="long-bio">{copy.long.map((p) => <p>{p}</p>)}</div>
      </article>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead title={copy.photosTitle} />
      {
        gallery.length ? (
          <div class="photos">
            {gallery.map((g) => (
              <a class="reveal" href={asset(g.src)} download>
                <img src={asset(g.src)} alt={g.alt} loading="lazy" />
                <span>
                  <Icon name="download" size={16} /> {g.alt}
                </span>
              </a>
            ))}
          </div>
        ) : (
          <p class="muted reveal">{copy.photosEmpty}</p>
        )
      }
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div class="reveal">
        <SectionHead title={copy.riderTitle} />
        <ul class="note-list">{copy.rider.map((r) => <li>{r}</li>)}</ul>
      </div>
      <div class="card reveal contact">
        <h2>{copy.contactTitle}</h2>
        <a href={`mailto:${site.email}`}><Icon name="mail" /> {site.email}</a>
        {site.phone && <a href={`tel:${site.phone.replace(/\s/g, '')}`}><Icon name="phone" /> {site.phone}</a>}
        <a href={site.socials.youtube} target="_blank" rel="noopener"><Icon name="youtube" /> YouTube</a>
        <a href={site.socials.instagram} target="_blank" rel="noopener"><Icon name="instagram" /> Instagram</a>
        <a href={site.socials.tiktok} target="_blank" rel="noopener"><Icon name="tiktok" /> TikTok</a>
        <a class="btn btn--gold" href={path('contact', lang)}>{t('cta.contact')} <Icon name="arrow" /></a>
      </div>
    </div>
  </section>
</Layout>

<script>
  document.querySelectorAll<HTMLButtonElement>('[data-copy]').forEach((btn) =>
    btn.addEventListener('click', async () => {
      const text = document.getElementById(btn.dataset.copy!)?.innerText ?? '';
      try {
        await navigator.clipboard.writeText(text);
        const label = btn.textContent;
        btn.textContent = btn.dataset.done!;
        setTimeout(() => (btn.textContent = label), 1800);
      } catch {}
    }),
  );
</script>

<style>
  .bio header {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }
  .bio h2 {
    font-size: 2rem;
  }
  .bio p {
    color: var(--ivory-dim);
  }
  .copy {
    padding: 0.4rem 0.9rem;
    border: 1px solid var(--line);
    border-radius: 99px;
    background: transparent;
    color: var(--gold-2);
    font: 600 0.78rem var(--font-body);
    letter-spacing: 0.08em;
    cursor: pointer;
  }
  .copy:hover {
    border-color: var(--gold);
  }
  .photos {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 240px), 1fr));
    gap: 1rem;
  }
  .photos a {
    display: grid;
    gap: 0.5rem;
    font-size: 0.85rem;
    color: var(--muted);
  }
  .photos img {
    aspect-ratio: 4 / 5;
    width: 100%;
    object-fit: cover;
    border-radius: 14px;
  }
  .photos span {
    display: flex;
    align-items: center;
    gap: 0.4rem;
  }
  .contact {
    display: grid;
    gap: 0.9rem;
    justify-items: start;
  }
  .contact h2 {
    font-size: 2rem;
  }
  .contact a:not(.btn) {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    color: var(--ivory-dim);
  }
  .contact a:not(.btn):hover {
    color: var(--gold-2);
  }
  .contact :global(svg) {
    color: var(--gold);
  }
  .contact .btn {
    margin-top: 0.8rem;
  }
  .contact .btn :global(svg) {
    color: inherit;
  }
</style>
