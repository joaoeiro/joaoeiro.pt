---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import Steps from '../components/Steps.astro';
import Faq from '../components/Faq.astro';
import ContactForm from '../components/ContactForm.astro';
import Marquee from '../components/Marquee.astro';
import Testimonials from '../components/Testimonials.astro';
import Icon from '../components/Icon.astro';
import { useT, type Lang } from '../i18n';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const copy = {
  en: {
    title: 'Events',
    description:
      'Live piano by João Eiró for weddings, private parties, house concerts and corporate events — gala dinners, launches, conferences and team building.',
    eyebrow: 'Private & corporate events',
    h1: 'Live piano for <em>unforgettable</em> moments',
    lead: 'From the first notes of a wedding ceremony to the after-dinner of a company gala, live piano changes the air in the room. Every set is built around your guests and your moment.',
    marquee: ['Weddings', 'Gala dinners', 'Cocktails', 'Product launches', 'House concerts', 'Birthdays', 'Conferences', 'Hotels'],
    typesEyebrow: 'Occasions',
    typesTitle: 'Music made <em>to measure</em>',
    types: [
      { g: '♡', t: 'Weddings', d: 'Ceremony, cocktail, dinner and that special first-dance song — arranged for piano just for you.' },
      { g: '✧', t: 'Private parties', d: 'Birthdays, anniversaries and dinners at home or at a venue, from elegant background to sing-along.' },
      { g: '☾', t: 'House concerts', d: 'An intimate recital in your living room for friends and family — a concert hall for one night.' },
      { g: '◆', t: 'Corporate events', d: 'Gala dinners, receptions, awards, conferences and launches with a polished, discreet presence.' },
      { g: '⌂', t: 'Hotels & restaurants', d: 'Regular or seasonal piano sessions that give your space a signature atmosphere.' },
      { g: '𝄢', t: 'Accompaniment', d: 'Piano for singers, choirs and instrumentalists at ceremonies, galas and special performances.' },
    ],
    corpEyebrow: 'For companies',
    corpTitle: 'Your brand, <em>in music</em>',
    corpLead: 'Live music that feels designed for your company — not a playlist in the background.',
    corp: [
      { t: 'Ambient or spotlight', d: 'Elegant background for networking, or a short featured concert moment on stage.' },
      { t: 'Improvised on your theme', d: 'An improvised piece built live from your brand, product or a word chosen by the guests.' },
      { t: 'Interactive requests', d: 'Guests request songs and hear them reinvented — the moment everyone remembers.' },
      { t: 'Team-building workshop', d: 'A hands-on session on listening, improvisation and creating together — at the piano.' },
      { t: 'Bilingual presence', d: 'Comfortable presenting and interacting in Portuguese and English with international guests.' },
      { t: 'Smooth logistics', d: 'Clear proposal, technical requirements agreed in advance, punctual set-up and sound check.' },
    ],
    howEyebrow: 'How it works',
    howTitle: 'From the first message <em>to the last note</em>',
    steps: [
      { title: 'Tell me about it', text: 'Date, place, type of event and the atmosphere you imagine.' },
      { title: 'Proposal', text: 'A tailored proposal with format, duration, repertoire ideas and technical needs.' },
      { title: 'Your music', text: 'We fine-tune the setlist together, including special requests and key moments.' },
      { title: 'The performance', text: 'Early arrival, sound check, and live music that follows the flow of your event.' },
    ],
    setupEyebrow: 'Set-up',
    setupTitle: 'Piano <em>anywhere</em>',
    setup: [
      'An acoustic piano at the venue, when available',
      'Or a digital stage piano with sound system, arranged on request',
      'Indoor and outdoor events (with shelter from sun and rain)',
      'Sets from 30 minutes to a full evening, with breaks',
    ],
    faqEyebrow: 'Questions',
    faqTitle: 'Before you <em>book</em>',
    faq: [
      { q: 'How far in advance should I book?', a: 'As early as possible — weekends in wedding season fill up months ahead. For corporate events, 3–4 weeks usually works.' },
      { q: 'Can you learn a specific song for us?', a: 'Yes. Special requests (an entrance, a first dance, a company anthem) can be arranged for piano with enough notice.' },
      { q: 'Do you travel?', a: 'Yes, across Portugal and abroad. Travel costs are included transparently in the proposal.' },
      { q: 'What do you need at the venue?', a: 'A suitable space, a power outlet if a digital piano is used, and access for set-up before guests arrive. Everything is agreed in advance.' },
      { q: 'Can you play with other musicians or a singer?', a: 'Absolutely — I work regularly as an accompanist and can suggest formations from duo upward.' },
    ],
    formEyebrow: 'Quote',
    formTitle: 'Request a <em>quote</em>',
    formLead: 'Share the essentials — I’ll reply with availability and a tailored proposal.',
  },
  pt: {
    title: 'Eventos',
    description:
      'Piano ao vivo com João Eiró para casamentos, festas privadas, concertos em casa e eventos corporativos — jantares de gala, lançamentos, conferências e team building.',
    eyebrow: 'Eventos privados & corporativos',
    h1: 'Piano ao vivo para momentos <em>inesquecíveis</em>',
    lead: 'Das primeiras notas de uma cerimónia de casamento ao pós-jantar de uma gala de empresa, o piano ao vivo muda o ar da sala. Cada atuação é construída à volta dos seus convidados e do seu momento.',
    marquee: ['Casamentos', 'Jantares de gala', 'Cocktails', 'Lançamentos', 'Concertos em casa', 'Aniversários', 'Conferências', 'Hotéis'],
    typesEyebrow: 'Ocasiões',
    typesTitle: 'Música feita <em>à medida</em>',
    types: [
      { g: '♡', t: 'Casamentos', d: 'Cerimónia, cocktail, jantar e aquela música especial para a primeira dança — arranjada para piano só para si.' },
      { g: '✧', t: 'Festas privadas', d: 'Aniversários, celebrações e jantares em casa ou num espaço, do ambiente elegante ao momento de cantar em conjunto.' },
      { g: '☾', t: 'Concertos em casa', d: 'Um recital intimista na sua sala para amigos e família — uma sala de concertos por uma noite.' },
      { g: '◆', t: 'Eventos corporativos', d: 'Jantares de gala, receções, prémios, conferências e lançamentos com uma presença cuidada e discreta.' },
      { g: '⌂', t: 'Hotéis & restaurantes', d: 'Sessões de piano regulares ou sazonais que dão ao seu espaço uma atmosfera única.' },
      { g: '𝄢', t: 'Acompanhamento', d: 'Piano para cantores, coros e instrumentistas em cerimónias, galas e atuações especiais.' },
    ],
    corpEyebrow: 'Para empresas',
    corpTitle: 'A sua marca, <em>em música</em>',
    corpLead: 'Música ao vivo que parece desenhada para a sua empresa — não uma playlist de fundo.',
    corp: [
      { t: 'Ambiente ou destaque', d: 'Fundo elegante para networking, ou um curto momento de concerto em palco.' },
      { t: 'Improviso sobre o seu tema', d: 'Uma peça improvisada ao vivo a partir da sua marca, produto ou de uma palavra escolhida pelos convidados.' },
      { t: 'Pedidos interativos', d: 'Os convidados pedem músicas e ouvem-nas reinventadas — o momento de que todos se lembram.' },
      { t: 'Workshop de team building', d: 'Uma sessão prática sobre escuta, improvisação e criar em conjunto — ao piano.' },
      { t: 'Presença bilingue', d: 'À vontade a apresentar e interagir em português e inglês com convidados internacionais.' },
      { t: 'Logística sem stress', d: 'Proposta clara, requisitos técnicos acordados com antecedência, montagem pontual e teste de som.' },
    ],
    howEyebrow: 'Como funciona',
    howTitle: 'Da primeira mensagem <em>à última nota</em>',
    steps: [
      { title: 'Conte-me', text: 'Data, local, tipo de evento e o ambiente que imagina.' },
      { title: 'Proposta', text: 'Uma proposta à medida com formato, duração, ideias de repertório e necessidades técnicas.' },
      { title: 'A sua música', text: 'Afinamos o alinhamento em conjunto, incluindo pedidos especiais e momentos-chave.' },
      { title: 'A atuação', text: 'Chegada antecipada, teste de som e música ao vivo que acompanha o ritmo do seu evento.' },
    ],
    setupEyebrow: 'Montagem',
    setupTitle: 'Piano <em>em qualquer lugar</em>',
    setup: [
      'Piano acústico no local, quando disponível',
      'Ou piano digital de palco com sistema de som, sob pedido',
      'Eventos interiores e exteriores (com proteção do sol e da chuva)',
      'Atuações de 30 minutos a uma noite inteira, com pausas',
    ],
    faqEyebrow: 'Perguntas',
    faqTitle: 'Antes de <em>reservar</em>',
    faq: [
      { q: 'Com quanta antecedência devo reservar?', a: 'O mais cedo possível — os fins de semana da época de casamentos esgotam com meses de antecedência. Para eventos corporativos, 3 a 4 semanas costumam bastar.' },
      { q: 'Pode aprender uma música específica para nós?', a: 'Sim. Pedidos especiais (uma entrada, uma primeira dança, o hino da empresa) podem ser arranjados para piano com a devida antecedência.' },
      { q: 'Desloca-se?', a: 'Sim, por todo o país e no estrangeiro. Os custos de deslocação são incluídos de forma transparente na proposta.' },
      { q: 'O que é preciso no local?', a: 'Um espaço adequado, uma tomada se for usado piano digital, e acesso para montagem antes da chegada dos convidados. Tudo é acordado previamente.' },
      { q: 'Pode tocar com outros músicos ou com um cantor?', a: 'Sem dúvida — trabalho regularmente como acompanhador e posso sugerir formações a partir do duo.' },
    ],
    formEyebrow: 'Orçamento',
    formTitle: 'Peça um <em>orçamento</em>',
    formLead: 'Partilhe o essencial — respondo com disponibilidade e uma proposta à medida.',
  },
}[lang];
---

<Layout lang={lang} route="events" title={copy.title} description={copy.description}>
  <PageHero eyebrow={copy.eyebrow} title={copy.h1} lead={copy.lead}>
    <div class="btn-row">
      <a class="btn btn--gold" href="#quote">{t('cta.events')} <Icon name="arrow" /></a>
      <a class="btn" href="#companies">{copy.corpEyebrow}</a>
    </div>
  </PageHero>

  <Marquee items={copy.marquee} reverse />

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={copy.typesEyebrow} title={copy.typesTitle} />
      <div class="grid grid-3">
        {
          copy.types.map((w, i) => (
            <article class="card feature reveal" style={`--i:${i % 3}`}>
              <span class="feature__glyph" aria-hidden="true">
                {w.g}
              </span>
              <h3>{w.t}</h3>
              <p>{w.d}</p>
            </article>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section corp" id="companies">
    <div class="wrap">
      <div class="corp__box">
        <SectionHead eyebrow={copy.corpEyebrow} title={copy.corpTitle} lead={copy.corpLead} />
        <div class="corp__grid">
          {
            copy.corp.map((c, i) => (
              <div class="corp__item reveal" style={`--i:${i % 3}`}>
                <span class="corp__n">{String(i + 1).padStart(2, '0')}</span>
                <h3>{c.t}</h3>
                <p>{c.d}</p>
              </div>
            ))
          }
        </div>
        <div class="btn-row reveal">
          <a class="btn btn--gold" href="#quote">{t('cta.events')} <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={copy.howEyebrow} title={copy.howTitle} />
      <Steps steps={copy.steps} />
    </div>
  </section>

  <section class="section">
    <div class="wrap split">
      <div>
        <SectionHead eyebrow={copy.setupEyebrow} title={copy.setupTitle} />
        <ul class="note-list">
          {copy.setup.map((s, i) => <li class="reveal" style={`--i:${i}`}>{s}</li>)}
        </ul>
      </div>
      <div>
        <SectionHead eyebrow={copy.faqEyebrow} title={copy.faqTitle} />
        <Faq items={copy.faq} />
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <Testimonials lang={lang} />
    </div>
  </section>

  <section class="section" id="quote">
    <div class="wrap split">
      <SectionHead eyebrow={copy.formEyebrow} title={copy.formTitle} lead={copy.formLead} />
      <div class="card reveal">
        <ContactForm lang={lang} kind="event" />
      </div>
    </div>
  </section>
</Layout>

<style>
  .corp__box {
    position: relative;
    overflow: hidden;
    padding: clamp(2rem, 1.5rem + 4vw, 5rem);
    border: 1px solid rgba(217, 178, 106, 0.3);
    border-radius: calc(var(--radius) * 1.5);
    background:
      radial-gradient(ellipse at 100% 0%, rgba(217, 178, 106, 0.16), transparent 50%),
      radial-gradient(ellipse at 0% 100%, rgba(59, 42, 107, 0.45), transparent 55%),
      var(--ink-2);
  }
  .corp__box::before {
    content: '';
    position: absolute;
    inset: 0;
    background: repeating-linear-gradient(90deg, rgba(255, 255, 255, 0.025) 0 1px, transparent 1px 64px);
    pointer-events: none;
  }
  .corp__grid {
    position: relative;
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 280px), 1fr));
    gap: 2rem 2.5rem;
    margin-bottom: 2.5rem;
  }
  .corp__n {
    font-size: 0.78rem;
    letter-spacing: 0.25em;
    color: var(--gold);
  }
  .corp__item h3 {
    margin: 0.4rem 0;
    font-size: 1.6rem;
  }
  .corp__item p {
    margin: 0;
    color: var(--ivory-dim);
    font-size: 0.95rem;
  }
</style>
