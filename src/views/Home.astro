---
import Layout from '../layouts/Layout.astro';
import PlayablePiano from '../components/PlayablePiano.astro';
import Marquee from '../components/Marquee.astro';
import CurrentTab from '../components/tabs/CurrentTab.astro';
import ArchiveTab from '../components/tabs/ArchiveTab.astro';
import LessonsTab from '../components/tabs/LessonsTab.astro';
import BioTab from '../components/tabs/BioTab.astro';
import PortfolioSection from '../components/PortfolioSection.astro';
import Signature from '../components/Signature.astro';
import { Image } from 'astro:assets';
import photo from '../assets/joao-eiro-piano.webp';
import { useT, type Lang } from '../i18n';
import { site } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  en: {
    title: 'João Eiró — Pianist & Piano Teacher',
    description:
      'João Eiró is a Portuguese pianist, piano teacher, accompanist and improviser. Piano lessons for all ages, concerts, and live piano for weddings, private and corporate events.',
    hello: 'From Classical to Jazz',
    roles: ['Pianist & piano teacher', 'Accompanist & soloist', 'Compulsive improviser'],
    photoAlt: 'João Eiró smiling as he plays the piano',
    intro:
      'From the discipline of Classical to the freedom of Jazz — music for the stage, for events, or for teaching anyone who has always wanted to learn to play.',
    marquee: [
      'Piano lessons', 'House concerts', 'Composer', 'Weddings', 'Keyboardist', 'Music theory lessons',
      'Corporate events', 'Music producer', 'Improv theatre', 'Accompanist', 'Events',
    ],
  },
  pt: {
    title: 'João Eiró — Pianista & Professor de Piano',
    description:
      'João Eiró é pianista, professor de piano, músico acompanhador e improvisador. Aulas de piano para todas as idades, concertos e piano ao vivo para casamentos, eventos privados e corporativos.',
    hello: 'Do Clássico ao Jazz',
    roles: ['Pianista e professor de piano', 'Músico acompanhador e solista', 'Improvisador compulsivo'],
    photoAlt: 'João Eiró a sorrir enquanto toca piano',
    intro:
      'Da disciplina do Clássico à liberdade do Jazz — música para o palco, para eventos ou para ensinar quem sempre quis aprender a tocar.',
    marquee: [
      'Aulas de piano', 'Concertos em casa', 'Compositor', 'Casamentos', 'Teclista', 'Aulas de formação musical',
      'Eventos corporativos', 'Produtor musical', 'Teatro de improviso', 'Músico acompanhador', 'Eventos',
    ],
  },
}[lang];

const t = useT(lang);
const photoCredit = { name: 'Carolina Galvão', href: 'https://www.instagram.com/_carolgalvao_/' };
---

<Layout lang={lang} route="home" title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow hero__in" style="--d:.1s">{copy.hello}</p>
        <h1 class="name">
          <span class="sr-only">{site.name}</span>
          <Signature class="name__sig" delay=".25s" />
        </h1>
        <div class="roles hero__in" style="--d:.9s" aria-label={copy.roles.join(', ')}>
          {copy.roles.map((r, i) => <span style={`--n:${i}`}>{r}</span>)}
        </div>
        <p class="lead hero__in" style="--d:1.05s">{copy.intro}</p>
      </div>
      <div class="hero__stage">
        <figure class="portrait hero__in" style="--d:.5s">
          <div class="portrait__frame">
            <Image
              src={photo}
              alt={copy.photoAlt}
              widths={[480, 760, 1100]}
              sizes="(max-width: 700px) 80vw, (max-width: 1080px) 60vw, 520px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
          <figcaption class="portrait__credit">
            {t('photo.by')}: <a href={photoCredit.href} target="_blank" rel="noopener">{photoCredit.name}</a>
          </figcaption>
        </figure>
        <div class="hero__piano hero__in" style="--d:1.35s">
          <PlayablePiano lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <Marquee items={copy.marquee} />

  <section class="section section--tabs">
    <div class="wrap tabs">
      <CurrentTab lang={lang} />
      <ArchiveTab lang={lang} />
      <LessonsTab lang={lang} />
      <BioTab lang={lang} />
    </div>
  </section>

  <section class="section section--portfolio">
    <div class="wrap">
      <PortfolioSection lang={lang} />
    </div>
  </section>

</Layout>

<style>
  /* The videos band follows the sections right away, as close as one section is to the next. */
  .section--tabs {
    padding-bottom: 0;
  }
  /* Nor too far from the footer after it. */
  .section--portfolio {
    padding-block: 0;
  }
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-h) + 3rem);
    padding-bottom: 5rem;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    align-items: end;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }
  .hero__in {
    opacity: 0;
    transform: translateY(24px);
    animation: heroIn 1.2s var(--ease) forwards;
    animation-delay: var(--d);
  }
  @keyframes heroIn {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .name {
    margin: 0 0 1.6rem;
  }
  .name :global(.name__sig) {
    width: clamp(300px, 12rem + 24vw, 620px);
    /* The signature's long tail sits low; pull it in a little at the start. */
    margin-left: -0.5rem;
  }
  .roles {
    position: relative;
    height: 1.6em;
    line-height: 1.6em;
    margin-bottom: 1.1rem;
    overflow: hidden;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.8rem);
    color: var(--gold-2);
  }
  .roles span {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: role 9s infinite;
    animation-delay: calc(var(--n) * 3s);
  }
  @keyframes role {
    0% {
      opacity: 0;
      transform: translateY(100%);
      filter: blur(6px);
    }
    5%,
    28% {
      opacity: 1;
      transform: none;
      filter: none;
    }
    33%,
    100% {
      opacity: 0;
      transform: translateY(-100%);
      filter: blur(6px);
    }
  }
  .hero .lead {
    margin-bottom: 2rem;
  }
  .hero__stage {
    position: relative;
    display: grid;
  }
  .portrait {
    position: relative;
    width: min(74%, 500px);
    margin: 0 4% 0 auto;
  }
  /* Credit runs up the portrait's right edge: the piano covers its bottom. */
  .portrait__credit {
    position: absolute;
    bottom: 32%;
    left: 100%;
    margin-left: 0.4rem;
    writing-mode: vertical-rl;
    transform: rotate(180deg);
    font-size: 0.72rem;
    letter-spacing: 0.04em;
    color: var(--muted);
    white-space: nowrap;
  }
  .portrait__credit a {
    color: var(--ivory-dim);
    text-decoration: underline;
    text-decoration-color: var(--gold-2);
    text-underline-offset: 0.2em;
    transition: color 0.3s;
  }
  .portrait__credit a:hover {
    color: var(--gold-2);
  }
  /* Arched "concert hall window". */
  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px 24px 24px;
    background: #111;
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.75);
  }
  .portrait__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 90% 60% at 70% 0%, rgb(var(--accent-2-rgb) / 0.22), transparent 60%),
      linear-gradient(180deg, transparent 55%, rgb(7 6 10 / 0.75));
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .portrait__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42% 30%;
    filter: contrast(1.05);
    animation: kenburns 26s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    from {
      transform: scale(1.04) translate(0, 0);
    }
    to {
      transform: scale(1.16) translate(-2%, 2%);
    }
  }
  .hero__piano {
    position: relative;
    z-index: 2;
    margin-top: -18%;
  }
  @media (max-width: 1080px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      width: min(70%, 420px);
      margin: 1.5rem auto 0;
    }
    .hero__piano {
      margin-top: -14%;
    }
  }
</style>
