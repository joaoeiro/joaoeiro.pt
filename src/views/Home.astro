---
import Layout from '../layouts/Layout.astro';
import PlayablePiano from '../components/PlayablePiano.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import VideoGallery from '../components/VideoGallery.astro';
import ShowList from '../components/ShowList.astro';
import Testimonials from '../components/Testimonials.astro';
import CtaBand from '../components/CtaBand.astro';
import GrandPiano from '../components/GrandPiano.astro';
import Icon from '../components/Icon.astro';
import { Image } from 'astro:assets';
import photo from '../assets/joao-eiro-live.jpg';
import { path, useT, type Lang } from '../i18n';
import { site } from '../config/site';
import { instagram, tiktok } from '../data/media';
import { getYouTubeVideos } from '../lib/youtube';
import { testimonials } from '../data/testimonials';
import { published } from '../lib/drafts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);
const youtube = await getYouTubeVideos();
const featured = <T extends { featured?: boolean }>(list: T[]) => [
  ...list.filter((v) => v.featured),
  ...list.filter((v) => !v.featured),
];

const copy = {
  en: {
    title: 'João Eiró — Pianist & Piano Teacher',
    description:
      'João Eiró is a Portuguese pianist, piano teacher, accompanist and improviser. Piano lessons for all ages, concerts, and live piano for weddings, private and corporate events.',
    hello: 'From Classical to Jazz',
    roles: ['Pianist & piano teacher', 'Accompanist & soloist', 'Compulsive improviser'],
    photoAlt: 'João Eiró playing keyboard and singing live on stage',
    intro:
      'From the discipline of Classical to the freedom of Jazz — music for the stage, for events, or for teaching anyone who has always wanted to learn to play.',
    marquee: ['Concerts', 'Piano lessons', 'Improvisation', 'Weddings', 'Corporate events', 'Accompaniment', 'House concerts', 'Classical', 'Groove'],
    doorsEyebrow: 'What I do',
    doorsTitle: 'Three ways to <em>share the piano</em>',
    doors: [
      {
        glyph: '𝄞',
        key: 'lessons',
        title: 'Piano lessons',
        text: 'Personalised lessons for children, teens and adults — from the very first note to advanced repertoire and improvisation.',
        cta: 'Start learning',
      },
      {
        glyph: '♫',
        key: 'shows',
        title: 'Shows',
        text: 'Solo recitals and collaborations as accompanist and soloist. See where the piano is playing next.',
        cta: 'See dates',
      },
      {
        glyph: '♬',
        key: 'events',
        title: 'Events',
        text: 'Live piano for weddings, private dinners, house concerts and corporate events — tailored to the moment.',
        cta: 'Plan your event',
      },
    ] as const,
    aboutEyebrow: 'Hello, I’m João',
    aboutTitle: 'Classical roots, <em>improviser’s heart</em>',
    about: [
      'I’m a pianist and piano teacher who loves both sides of the instrument: the discipline of the great repertoire and the freedom of making music up on the spot.',
      'On stage I play as a soloist and as an accompanist. In the classroom I help students of every age find their own sound. And on social media I share small musical moments — a phrase of Beethoven, a groove borrowed for a minute and given back.',
    ],
    aboutCta: 'See portfolio',
    videosEyebrow: 'Watch & listen',
    videosTitle: 'Moments at <em>the keys</em>',
    showsEyebrow: 'On stage',
    showsTitle: 'Next <em>shows</em>',
    quotesEyebrow: 'Kind words',
    quotesTitle: 'From students <em>& clients</em>',
    ctaTitle: 'Let’s make <em>music together</em>',
    ctaText: 'Lessons, a concert, or the soundtrack for your celebration — tell me what you are imagining.',
  },
  pt: {
    title: 'João Eiró — Pianista & Professor de Piano',
    description:
      'João Eiró é pianista, professor de piano, músico acompanhador e improvisador. Aulas de piano para todas as idades, concertos e piano ao vivo para casamentos, eventos privados e corporativos.',
    hello: 'Do Clássico ao Jazz',
    roles: ['Pianista e professor de piano', 'Músico acompanhador e solista', 'Improvisador compulsivo'],
    photoAlt: 'João Eiró a tocar teclado e a cantar ao vivo em palco',
    intro:
      'Da disciplina do Clássico à liberdade do Jazz — música para o palco, para eventos ou para ensinar quem sempre quis aprender a tocar.',
    marquee: ['Concertos', 'Aulas de piano', 'Improvisação', 'Casamentos', 'Eventos corporativos', 'Acompanhamento', 'Concertos em casa', 'Clássico', 'Groove'],
    doorsEyebrow: 'O que faço',
    doorsTitle: 'Três formas de <em>partilhar o piano</em>',
    doors: [
      {
        glyph: '𝄞',
        key: 'lessons',
        title: 'Aulas de piano',
        text: 'Aulas personalizadas para crianças, jovens e adultos — da primeira nota ao repertório avançado e à improvisação.',
        cta: 'Começar a aprender',
      },
      {
        glyph: '♫',
        key: 'shows',
        title: 'Espetáculos',
        text: 'Recitais a solo e colaborações como acompanhador e solista. Veja onde o piano toca a seguir.',
        cta: 'Ver datas',
      },
      {
        glyph: '♬',
        key: 'events',
        title: 'Eventos',
        text: 'Piano ao vivo para casamentos, jantares privados, concertos em casa e eventos corporativos — à medida do momento.',
        cta: 'Planear o seu evento',
      },
    ] as const,
    aboutEyebrow: 'Olá, sou o João',
    aboutTitle: 'Raízes clássicas, <em>alma de improvisador</em>',
    about: [
      'Sou pianista e professor de piano e adoro os dois lados do instrumento: a disciplina do grande repertório e a liberdade de inventar música no momento.',
      'Em palco toco como solista e como acompanhador. Nas aulas ajudo alunos de todas as idades a encontrar o seu som. E nas redes sociais partilho pequenos momentos musicais — uma frase de Beethoven, um groove emprestado por um minuto e devolvido.',
    ],
    aboutCta: 'Ver portfólio',
    videosEyebrow: 'Ver & ouvir',
    videosTitle: 'Momentos <em>ao piano</em>',
    showsEyebrow: 'Em palco',
    showsTitle: 'Próximos <em>concertos</em>',
    quotesEyebrow: 'Palavras simpáticas',
    quotesTitle: 'De alunos <em>& clientes</em>',
    ctaTitle: 'Vamos fazer <em>música juntos</em>',
    ctaText: 'Aulas, um concerto ou a banda sonora da sua celebração — conte-me o que está a imaginar.',
  },
}[lang];

const hasQuotes = published(testimonials).length > 0;
---

<Layout lang={lang} route="home" title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow hero__in" style="--d:.1s">{copy.hello}</p>
        <h1 class="name" aria-label={site.name}>
          <span class="line">
            {[...'João'].map((c, i) => <span class="ch" style={`--d:${0.25 + i * 0.07}s`}>{c}</span>)}
          </span>
          <span class="line line--gold italic">
            {[...'Eiró'].map((c, i) => <span class="ch" style={`--d:${0.55 + i * 0.07}s`}>{c}</span>)}
          </span>
        </h1>
        <div class="roles hero__in" style="--d:.9s" aria-label={copy.roles.join(', ')}>
          {copy.roles.map((r, i) => <span style={`--n:${i}`}>{r}</span>)}
        </div>
        <p class="lead hero__in" style="--d:1.05s">{copy.intro}</p>
        <div class="btn-row hero__in" style="--d:1.2s">
          <a class="btn btn--gold" href={path('lessons', lang)}>{t('cta.lessons')} <Icon name="arrow" /></a>
          <a class="btn" href={path('events', lang)}>{t('cta.events')}</a>
        </div>
      </div>
      <div class="hero__stage">
        <figure class="portrait hero__in" style="--d:.5s">
          <div class="portrait__frame">
            <Image
              src={photo}
              alt={copy.photoAlt}
              widths={[480, 760, 1100]}
              sizes="(max-width: 700px) 80vw, (max-width: 1080px) 60vw, 520px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </figure>
        <div class="hero__piano hero__in" style="--d:1.35s">
          <PlayablePiano lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <Marquee items={copy.marquee} />

  <section class="section" id="doors">
    <div class="wrap">
      <SectionHead eyebrow={copy.doorsEyebrow} title={copy.doorsTitle} />
      <div class="doors">
        {
          copy.doors.map((d, i) => (
            <a class="door reveal" href={path(d.key, lang)} style={`--i:${i}`}>
              <span class="door__keys" aria-hidden="true">
                <i />
                <i />
                <i />
                <i />
                <i />
                <i />
                <i />
              </span>
              <span class="door__glyph" aria-hidden="true">
                {d.glyph}
              </span>
              <span class="door__num">0{i + 1}</span>
              <h3>{d.title}</h3>
              <p>{d.text}</p>
              <span class="door__cta">
                {d.cta} <Icon name="arrow" size={18} />
              </span>
            </a>
          ))
        }
      </div>
    </div>
  </section>

  <section class="section about">
    <div class="wrap about__grid">
      <div class="about__art reveal">
        <GrandPiano />
      </div>
      <div>
        <SectionHead eyebrow={copy.aboutEyebrow} title={copy.aboutTitle} />
        {copy.about.map((p, i) => <p class="lead reveal" style={`--i:${i + 1}`}>{p}</p>)}
        <div class="btn-row reveal" style="--i:3">
          <a class="btn" href={path('portfolio', lang)}>{copy.aboutCta} <Icon name="arrow" /></a>
        </div>
      </div>
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={copy.videosEyebrow} title={copy.videosTitle}>
        <a class="link-more" href={path('portfolio', lang) + '#videos'}>{t('media.more')} →</a>
      </SectionHead>
      <VideoGallery
        lang={lang}
        youtube={featured(youtube)}
        tiktok={featured(tiktok)}
        instagram={featured(instagram)}
        limit={6}
      />
    </div>
  </section>

  <section class="section">
    <div class="wrap">
      <SectionHead eyebrow={copy.showsEyebrow} title={copy.showsTitle}>
        <a class="link-more" href={path('shows', lang)}>{t('common.allShows')} →</a>
      </SectionHead>
      <ShowList lang={lang} when="upcoming" limit={3} />
    </div>
  </section>

  {
    hasQuotes && (
      <section class="section">
        <div class="wrap">
          <SectionHead eyebrow={copy.quotesEyebrow} title={copy.quotesTitle} center />
          <Testimonials lang={lang} />
        </div>
      </section>
    )
  }

  <CtaBand title={copy.ctaTitle} text={copy.ctaText}>
    <a class="btn btn--gold" href={path('contact', lang)}>{t('cta.contact')} <Icon name="arrow" /></a>
    <a class="btn" href={site.socials.youtube} target="_blank" rel="noopener"><Icon name="youtube" /> YouTube</a>
  </CtaBand>
</Layout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-h) + 3rem);
    padding-bottom: 5rem;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    align-items: end;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }
  .hero__in {
    opacity: 0;
    transform: translateY(24px);
    animation: heroIn 1.2s var(--ease) forwards;
    animation-delay: var(--d);
  }
  @keyframes heroIn {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .name {
    display: grid;
    font-size: clamp(4.5rem, 2.5rem + 9vw, 10.5rem);
    line-height: 0.86;
    margin-bottom: 1.6rem;
  }
  /* Extra room inside the clip for accents and descenders (the J, the ó); negative margins keep the spacing. */
  .line {
    display: block;
    overflow: hidden;
    padding: 0.12em 0 0.24em;
    margin: -0.12em 0 -0.16em;
  }
  .line--gold {
    padding-left: 0.6em;
  }
  .ch {
    display: inline-block;
    transform: translateY(140%) rotate(8deg);
    animation: chIn 1.1s var(--ease) forwards;
    animation-delay: var(--d);
  }
  .line--gold .ch {
    background: var(--gold-text-grad);
    background-size: 300% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.04em;
    animation:
      chIn 1.1s var(--ease) forwards var(--d),
      shimmer 6s linear infinite;
  }
  @keyframes chIn {
    to {
      transform: none;
    }
  }
  .roles {
    position: relative;
    height: 1.6em;
    line-height: 1.6em;
    margin-bottom: 1.1rem;
    overflow: hidden;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.8rem);
    color: var(--gold-2);
  }
  .roles span {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: role 9s infinite;
    animation-delay: calc(var(--n) * 3s);
  }
  @keyframes role {
    0% {
      opacity: 0;
      transform: translateY(100%);
      filter: blur(6px);
    }
    5%,
    28% {
      opacity: 1;
      transform: none;
      filter: none;
    }
    33%,
    100% {
      opacity: 0;
      transform: translateY(-100%);
      filter: blur(6px);
    }
  }
  .hero .lead {
    margin-bottom: 2rem;
  }
  .hero__stage {
    position: relative;
    display: grid;
  }
  .portrait {
    position: relative;
    width: min(74%, 500px);
    margin: 0 4% 0 auto;
  }
  /* Arched "concert hall window" with a second, floating outline. */
  .portrait::before {
    content: '';
    position: absolute;
    inset: -16px;
    border: 1px solid rgb(var(--accent-rgb) / 0.45);
    border-radius: 999px 999px 34px 34px;
    animation: halo 9s ease-in-out infinite alternate;
  }
  @keyframes halo {
    to {
      transform: translate(10px, -8px) rotate(1.2deg);
    }
  }
  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px 24px 24px;
    background: #111;
    box-shadow:
      0 40px 90px -40px rgb(0 0 0 / 0.75),
      0 0 120px -30px rgb(var(--accent-rgb) / 0.45);
  }
  .portrait__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 90% 60% at 70% 0%, rgb(var(--accent-2-rgb) / 0.22), transparent 60%),
      linear-gradient(180deg, transparent 55%, rgb(7 6 10 / 0.75));
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .portrait__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42% 30%;
    filter: contrast(1.05);
    animation: kenburns 26s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    from {
      transform: scale(1.04) translate(0, 0);
    }
    to {
      transform: scale(1.16) translate(-2%, 2%);
    }
  }
  .hero__piano {
    position: relative;
    z-index: 2;
    margin-top: -28%;
  }
  @media (max-width: 1080px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      width: min(70%, 420px);
      margin: 1.5rem auto 0;
    }
    .hero__piano {
      margin-top: -22%;
    }
  }

  .doors {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(min(100%, 300px), 1fr));
    gap: 1.25rem;
  }
  .door {
    position: relative;
    display: flex;
    flex-direction: column;
    min-height: 430px;
    padding: 2rem;
    overflow: hidden;
    border: 1px solid var(--line);
    border-radius: var(--radius);
    background: linear-gradient(170deg, rgb(var(--surface-rgb) / calc(0.05 * var(--surface-k))), rgb(var(--surface-rgb) / calc(0.005 * var(--surface-k))));
    transition: border-color 0.5s, transform 0.7s var(--ease);
    isolation: isolate;
  }
  .door:hover {
    border-color: rgb(var(--accent-rgb) / 0.6);
    transform: translateY(-8px);
  }
  .door__keys {
    position: absolute;
    inset: 0;
    z-index: -1;
    display: flex;
    gap: 2px;
    opacity: 0;
    transition: opacity 0.6s;
  }
  .door__keys i {
    flex: 1;
    background: linear-gradient(180deg, rgb(var(--accent-2-rgb) / 0.12), transparent 75%);
    transform: scaleY(0);
    transform-origin: top;
    transition: transform 0.7s var(--ease);
  }
  .door__keys i:nth-child(odd) {
    background: linear-gradient(180deg, rgb(var(--wine-rgb) / 0.35), transparent 60%);
  }
  .door:hover .door__keys {
    opacity: 1;
  }
  .door:hover .door__keys i {
    transform: scaleY(1);
  }
  .door__keys i:nth-child(2) {
    transition-delay: 0.05s;
  }
  .door__keys i:nth-child(3) {
    transition-delay: 0.1s;
  }
  .door__keys i:nth-child(4) {
    transition-delay: 0.15s;
  }
  .door__keys i:nth-child(5) {
    transition-delay: 0.2s;
  }
  .door__keys i:nth-child(6) {
    transition-delay: 0.25s;
  }
  .door__keys i:nth-child(7) {
    transition-delay: 0.3s;
  }
  .door__glyph {
    position: absolute;
    right: -0.5rem;
    top: -1.5rem;
    font-size: 11rem;
    line-height: 1;
    color: var(--gold);
    opacity: 0.12;
    transition: transform 1s var(--ease), opacity 0.5s;
  }
  .door:hover .door__glyph {
    opacity: 0.35;
    transform: rotate(-12deg) scale(1.08);
  }
  .door__num {
    font-size: 0.8rem;
    letter-spacing: 0.3em;
    color: var(--gold);
    margin-bottom: auto;
  }
  .door h3 {
    font-size: clamp(2rem, 1.6rem + 1.2vw, 2.6rem);
    margin-top: 6rem;
  }
  .door p {
    color: var(--ivory-dim);
  }
  .door__cta {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    margin-top: 0.5rem;
    font-weight: 600;
    font-size: 0.9rem;
    color: var(--gold-2);
  }
  .door__cta :global(svg) {
    transition: transform 0.4s var(--ease);
  }
  .door:hover .door__cta :global(svg) {
    transform: translateX(6px);
  }

  .about__grid {
    display: grid;
    grid-template-columns: 1fr 1.1fr;
    align-items: center;
    gap: clamp(2rem, 1rem + 5vw, 6rem);
  }
  .about__art {
    position: relative;
  }
  .about__art::before {
    content: '';
    position: absolute;
    inset: 10% 5%;
    border-radius: 50%;
    background: radial-gradient(circle, rgb(var(--wine-rgb) / 0.45), transparent 70%);
    filter: blur(30px);
    z-index: -1;
  }
  .about__art img {
    width: 100%;
    aspect-ratio: 4 / 5;
    object-fit: cover;
    border-radius: var(--radius);
  }
  @media (max-width: 860px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
  }
  .link-more {
    display: inline-block;
    margin-top: 0.5rem;
    color: var(--gold-2);
    font-weight: 600;
    font-size: 0.92rem;
  }
</style>
