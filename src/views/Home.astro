---
import Layout from '../layouts/Layout.astro';
import PlayablePiano from '../components/PlayablePiano.astro';
import Marquee from '../components/Marquee.astro';
import SectionHead from '../components/SectionHead.astro';
import Testimonials from '../components/Testimonials.astro';
import LessonsTab from '../components/tabs/LessonsTab.astro';
import PortfolioTab from '../components/tabs/PortfolioTab.astro';
import ShowsTab from '../components/tabs/ShowsTab.astro';
import EventsTab from '../components/tabs/EventsTab.astro';
import PressTab from '../components/tabs/PressTab.astro';
import { Image } from 'astro:assets';
import photo from '../assets/joao-eiro-live.jpg';
import { type Lang } from '../i18n';
import { site } from '../config/site';
import { testimonials } from '../data/testimonials';
import { published } from '../lib/drafts';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;

const copy = {
  en: {
    title: 'João Eiró — Pianist & Piano Teacher',
    description:
      'João Eiró is a Portuguese pianist, piano teacher, accompanist and improviser. Piano lessons for all ages, concerts, and live piano for weddings, private and corporate events.',
    hello: 'From Classical to Jazz',
    roles: ['Pianist & piano teacher', 'Accompanist & soloist', 'Compulsive improviser'],
    photoAlt: 'João Eiró playing keyboard and singing live on stage',
    intro:
      'From the discipline of Classical to the freedom of Jazz — music for the stage, for events, or for teaching anyone who has always wanted to learn to play.',
    marquee: [
      'Piano lessons', 'House concerts', 'Composer', 'Weddings', 'Keyboardist', 'Music theory lessons',
      'Corporate events', 'Music producer', 'Improv theatre', 'Accompanist', 'Events',
    ],
    quotesEyebrow: 'Kind words',
    quotesTitle: 'From students <em>& clients</em>',
  },
  pt: {
    title: 'João Eiró — Pianista & Professor de Piano',
    description:
      'João Eiró é pianista, professor de piano, músico acompanhador e improvisador. Aulas de piano para todas as idades, concertos e piano ao vivo para casamentos, eventos privados e corporativos.',
    hello: 'Do Clássico ao Jazz',
    roles: ['Pianista e professor de piano', 'Músico acompanhador e solista', 'Improvisador compulsivo'],
    photoAlt: 'João Eiró a tocar teclado e a cantar ao vivo em palco',
    intro:
      'Da disciplina do Clássico à liberdade do Jazz — música para o palco, para eventos ou para ensinar quem sempre quis aprender a tocar.',
    marquee: [
      'Aulas de piano', 'Concertos em casa', 'Compositor', 'Casamentos', 'Teclista', 'Aulas de formação musical',
      'Eventos corporativos', 'Produtor musical', 'Teatro de improviso', 'Músico acompanhador', 'Eventos',
    ],
    quotesEyebrow: 'Palavras simpáticas',
    quotesTitle: 'De alunos <em>& clientes</em>',
  },
}[lang];

const hasQuotes = published(testimonials).length > 0;
---

<Layout lang={lang} route="home" title={copy.title} description={copy.description}>
  <section class="hero">
    <div class="wrap hero__grid">
      <div class="hero__text">
        <p class="eyebrow hero__in" style="--d:.1s">{copy.hello}</p>
        <h1 class="name" aria-label={site.name}>
          <span class="line">
            {[...'João'].map((c, i) => <span class="ch" style={`--d:${0.25 + i * 0.07}s`}>{c}</span>)}
          </span>
          <span class="line line--gold italic">
            {[...'Eiró'].map((c, i) => <span class="ch" style={`--d:${0.55 + i * 0.07}s`}>{c}</span>)}
          </span>
        </h1>
        <div class="roles hero__in" style="--d:.9s" aria-label={copy.roles.join(', ')}>
          {copy.roles.map((r, i) => <span style={`--n:${i}`}>{r}</span>)}
        </div>
        <p class="lead hero__in" style="--d:1.05s">{copy.intro}</p>
      </div>
      <div class="hero__stage">
        <figure class="portrait hero__in" style="--d:.5s">
          <div class="portrait__frame">
            <Image
              src={photo}
              alt={copy.photoAlt}
              widths={[480, 760, 1100]}
              sizes="(max-width: 700px) 80vw, (max-width: 1080px) 60vw, 520px"
              loading="eager"
              fetchpriority="high"
            />
          </div>
        </figure>
        <div class="hero__piano hero__in" style="--d:1.35s">
          <PlayablePiano lang={lang} />
        </div>
      </div>
    </div>
  </section>

  <Marquee items={copy.marquee} />

  <section class="section">
    <div class="wrap tabs">
      <LessonsTab lang={lang} num={1} />
      <PortfolioTab lang={lang} num={2} />
      <ShowsTab lang={lang} num={3} />
      <EventsTab lang={lang} num={4} />
      <PressTab lang={lang} num={5} />
    </div>
  </section>

  {
    hasQuotes && (
      <section class="section">
        <div class="wrap">
          <SectionHead eyebrow={copy.quotesEyebrow} title={copy.quotesTitle} center />
          <Testimonials lang={lang} />
        </div>
      </section>
    )
  }

</Layout>

<style>
  .hero {
    position: relative;
    min-height: 100svh;
    display: flex;
    align-items: center;
    padding-top: calc(var(--nav-h) + 3rem);
    padding-bottom: 5rem;
  }
  .hero__grid {
    display: grid;
    grid-template-columns: 1fr 1.25fr;
    align-items: end;
    gap: clamp(2rem, 1rem + 4vw, 5rem);
  }
  .hero__in {
    opacity: 0;
    transform: translateY(24px);
    animation: heroIn 1.2s var(--ease) forwards;
    animation-delay: var(--d);
  }
  @keyframes heroIn {
    to {
      opacity: 1;
      transform: none;
    }
  }
  .name {
    display: grid;
    font-size: clamp(4.5rem, 2.5rem + 9vw, 10.5rem);
    line-height: 0.86;
    margin-bottom: 1.6rem;
  }
  /* Extra room inside the clip for accents and descenders (the J, the ó); negative margins keep the spacing. */
  .line {
    display: block;
    overflow: hidden;
    padding: 0.12em 0 0.24em;
    margin: -0.12em 0 -0.16em;
  }
  .line--gold {
    padding-left: 0.6em;
  }
  .ch {
    display: inline-block;
    transform: translateY(140%) rotate(8deg);
    animation: chIn 1.1s var(--ease) forwards;
    animation-delay: var(--d);
  }
  .line--gold .ch {
    background: var(--gold-text-grad);
    background-size: 300% auto;
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
    padding-right: 0.04em;
    animation:
      chIn 1.1s var(--ease) forwards var(--d),
      shimmer 6s linear infinite;
  }
  @keyframes chIn {
    to {
      transform: none;
    }
  }
  .roles {
    position: relative;
    height: 1.6em;
    line-height: 1.6em;
    margin-bottom: 1.1rem;
    overflow: hidden;
    font-family: var(--font-display);
    font-style: italic;
    font-size: clamp(1.35rem, 1.1rem + 0.8vw, 1.8rem);
    color: var(--gold-2);
  }
  .roles span {
    position: absolute;
    inset: 0;
    opacity: 0;
    animation: role 9s infinite;
    animation-delay: calc(var(--n) * 3s);
  }
  @keyframes role {
    0% {
      opacity: 0;
      transform: translateY(100%);
      filter: blur(6px);
    }
    5%,
    28% {
      opacity: 1;
      transform: none;
      filter: none;
    }
    33%,
    100% {
      opacity: 0;
      transform: translateY(-100%);
      filter: blur(6px);
    }
  }
  .hero .lead {
    margin-bottom: 2rem;
  }
  .hero__stage {
    position: relative;
    display: grid;
  }
  .portrait {
    position: relative;
    width: min(74%, 500px);
    margin: 0 4% 0 auto;
  }
  /* Arched "concert hall window". */
  .portrait__frame {
    position: relative;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: 999px 999px 24px 24px;
    background: #111;
    box-shadow: 0 40px 90px -40px rgb(0 0 0 / 0.75);
  }
  .portrait__frame::after {
    content: '';
    position: absolute;
    inset: 0;
    background:
      radial-gradient(ellipse 90% 60% at 70% 0%, rgb(var(--accent-2-rgb) / 0.22), transparent 60%),
      linear-gradient(180deg, transparent 55%, rgb(7 6 10 / 0.75));
    mix-blend-mode: screen;
    pointer-events: none;
  }
  .portrait__frame :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 42% 30%;
    filter: contrast(1.05);
    animation: kenburns 26s ease-in-out infinite alternate;
  }
  @keyframes kenburns {
    from {
      transform: scale(1.04) translate(0, 0);
    }
    to {
      transform: scale(1.16) translate(-2%, 2%);
    }
  }
  .hero__piano {
    position: relative;
    z-index: 2;
    margin-top: -28%;
  }
  @media (max-width: 1080px) {
    .hero__grid {
      grid-template-columns: 1fr;
    }
    .portrait {
      width: min(70%, 420px);
      margin: 1.5rem auto 0;
    }
    .hero__piano {
      margin-top: -22%;
    }
  }

  .tabs {
    border-top: 1px solid var(--line);
  }
</style>
