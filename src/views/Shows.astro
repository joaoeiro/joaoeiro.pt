---
import Layout from '../layouts/Layout.astro';
import PageHero from '../components/PageHero.astro';
import SectionHead from '../components/SectionHead.astro';
import ShowList from '../components/ShowList.astro';
import CtaBand from '../components/CtaBand.astro';
import Icon from '../components/Icon.astro';
import { path, useT, type Lang } from '../i18n';
import { site } from '../config/site';

interface Props {
  lang: Lang;
}
const { lang } = Astro.props;
const t = useT(lang);

const copy = {
  en: {
    title: 'Shows',
    description: 'Upcoming and past concerts by pianist João Eiró — recitals, collaborations and live performances.',
    eyebrow: 'Shows',
    h1: 'Live, <em>on stage</em>',
    lead: 'Solo recitals, collaborations as accompanist and soloist, and improvised evenings. Here’s where the piano is heading — and where it has been.',
    upEyebrow: 'Coming up',
    upTitle: 'Next <em>dates</em>',
    pastEyebrow: 'Archive',
    pastTitle: 'Past <em>shows</em>',
    follow: 'New dates are announced first on social media.',
    ctaTitle: 'Bring the piano <em>to your venue</em>',
    ctaText: 'Programmers, festivals, cultural associations and venues: let’s build a programme for your audience — classical, improvised, or both.',
  },
  pt: {
    title: 'Concertos',
    description: 'Próximos concertos e concertos anteriores do pianista João Eiró — recitais, colaborações e atuações ao vivo.',
    eyebrow: 'Concertos',
    h1: 'Ao vivo, <em>em palco</em>',
    lead: 'Recitais a solo, colaborações como acompanhador e solista, e noites de improvisação. Eis para onde vai o piano — e por onde já passou.',
    upEyebrow: 'Em breve',
    upTitle: 'Próximas <em>datas</em>',
    pastEyebrow: 'Arquivo',
    pastTitle: 'Concertos <em>anteriores</em>',
    follow: 'As novas datas são anunciadas primeiro nas redes sociais.',
    ctaTitle: 'Leve o piano <em>à sua sala</em>',
    ctaText: 'Programadores, festivais, associações culturais e salas: vamos criar um programa para o seu público — clássico, improvisado, ou ambos.',
  },
}[lang];
---

<Layout lang={lang} route="shows" title={copy.title} description={copy.description}>
  <PageHero eyebrow={copy.eyebrow} title={copy.h1} lead={copy.lead}>
    <div class="follow">
      <span>{copy.follow}</span>
      <a href={site.socials.instagram} target="_blank" rel="noopener" aria-label="Instagram"><Icon name="instagram" /></a>
      <a href={site.socials.tiktok} target="_blank" rel="noopener" aria-label="TikTok"><Icon name="tiktok" /></a>
      <a href={site.socials.facebook} target="_blank" rel="noopener" aria-label="Facebook"><Icon name="facebook" /></a>
      <a href={site.socials.youtube} target="_blank" rel="noopener" aria-label="YouTube"><Icon name="youtube" /></a>
    </div>
  </PageHero>

  <section class="section" id="upcoming">
    <div class="wrap">
      <SectionHead eyebrow={copy.upEyebrow} title={copy.upTitle} />
      <ShowList lang={lang} when="upcoming" />
    </div>
  </section>

  <section class="section" id="past">
    <div class="wrap">
      <SectionHead eyebrow={copy.pastEyebrow} title={copy.pastTitle} />
      <ShowList lang={lang} when="past" />
    </div>
  </section>

  <CtaBand title={copy.ctaTitle} text={copy.ctaText}>
    <a class="btn btn--gold" href={path('contact', lang)}>{t('cta.contact')} <Icon name="arrow" /></a>
    <a class="btn" href={path('press', lang)}>{t('nav.press')}</a>
  </CtaBand>
</Layout>

<style>
  .follow {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.6rem 0.9rem;
    color: var(--muted);
    font-size: 0.92rem;
  }
  .follow a {
    display: grid;
    place-items: center;
    width: 42px;
    height: 42px;
    border: 1px solid var(--line);
    border-radius: 50%;
    color: var(--ivory);
    transition: 0.4s var(--ease);
  }
  .follow a:hover {
    border-color: var(--gold);
    color: var(--gold-2);
    transform: translateY(-3px);
  }
</style>
