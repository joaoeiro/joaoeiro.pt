---
import '../styles/global.css';
import Nav from '../components/Nav.astro';
import Footer from '../components/Footer.astro';
import NoteField from '../components/NoteField.astro';
import SideTab from '../components/SideTab.astro';
import { site } from '../config/site';
import { asset, path, routes, locales, type Lang, type RouteKey } from '../i18n';

interface Props {
  lang: Lang;
  route: RouteKey;
  title: string;
  description: string;
  /** Error pages: no canonical, no alternates, no language redirect. */
  noindex?: boolean;
}

const { lang, route, title, description, noindex = false } = Astro.props;
const pageTitle = route === 'home' ? title : `${title} · ${site.name}`;
const origin = Astro.site ?? site.url;
const canonical = new URL(path(route, lang), origin).href;
const alternates = (Object.keys(routes[route]) as Lang[]).map((l) => ({
  lang: locales[l],
  href: new URL(path(route, l), origin).href,
}));
const ogImage = new URL(asset('/og.png'), origin).href;
const sameAs = Object.values(site.socials).filter(Boolean);

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: site.name,
  url: site.url,
  jobTitle: lang === 'pt' ? 'Pianista e Professor de Piano' : 'Pianist and Piano Teacher',
  email: `mailto:${site.email}`,
  address: { '@type': 'PostalAddress', addressCountry: 'PT' },
  sameAs,
  knowsAbout: ['Piano', 'Piano lessons', 'Live music for events'],
};
---

<!doctype html>
<html lang={locales[lang]} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {
      noindex ? (
        <meta name="robots" content="noindex" />
      ) : (
        <>
          <link rel="canonical" href={canonical} />
          {alternates.map((a) => (
            <link rel="alternate" hreflang={a.lang} href={a.href} />
          ))}
          <link rel="alternate" hreflang="x-default" href={new URL(path(route, 'en'), origin).href} />
        </>
      )
    }
    <link rel="icon" href={asset('/favicon.svg')} type="image/svg+xml" />
    <link rel="sitemap" href={asset('/sitemap-index.xml')} />
    <meta name="theme-color" content="#07060a" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={lang === 'pt' ? 'pt_PT' : 'en_GB'} />
    <meta name="twitter:card" content="summary_large_image" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      rel="stylesheet"
      href="https://fonts.googleapis.com/css2?family=Cormorant+Garamond:ital,wght@0,400;0,500;0,600;1,400;1,500&family=Manrope:wght@400;500;600;700&display=swap"
    />

    <script
      is:inline
      set:html={`(function(){var d=document.documentElement;d.classList.remove('no-js');var t;
try{t=localStorage.getItem('theme')}catch(e){}
if(t!=='light'&&t!=='dark')t=matchMedia('(prefers-color-scheme: light)').matches?'light':'dark';
d.dataset.theme=t;
var m=document.querySelector('meta[name=theme-color]');if(m)m.content=t==='light'?'#d7cfc4':'#07060a';})();`}
    />
    {
      lang === 'en' && !noindex && (
        <script
          is:inline
          set:html={`(function(){try{
  if (localStorage.getItem('lang')) return;
  var langs = navigator.languages || [navigator.language || ''];
  if (String(langs[0] || '').toLowerCase().indexOf('pt') === 0) location.replace(${JSON.stringify(path(route, 'pt'))} + location.hash);
}catch(e){}})();`}
        />
      )
    }
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />
  </head>
  <body data-route={route}>
    <a class="skip" href="#main">{lang === 'pt' ? 'Saltar para o conteúdo' : 'Skip to content'}</a>
    <NoteField />
    <Nav lang={lang} route={route} />
    <main id="main">
      <slot />
    </main>
    <Footer lang={lang} route={route} />
    <SideTab lang={lang} route={route} />

    <script>
      // Reveal elements as they scroll into view.
      const io = new IntersectionObserver(
        (entries) => {
          for (const e of entries) {
            if (e.isIntersecting) {
              e.target.classList.add('is-visible');
              io.unobserve(e.target);
            }
          }
        },
        { rootMargin: '0px 0px -8% 0px', threshold: 0.08 },
      );
      document.querySelectorAll('.reveal').forEach((el) => io.observe(el));

      // Remember an explicit language choice so auto-detection never overrides it.
      document.querySelectorAll<HTMLElement>('[data-lang-choice]').forEach((a) =>
        a.addEventListener('click', () => {
          try {
            localStorage.setItem('lang', a.dataset.langChoice!);
          } catch {}
        }),
      );
    </script>

    <style is:global>
      .skip {
        position: fixed;
        top: -100px;
        left: 1rem;
        z-index: 200;
        background: var(--accent-2);
        color: var(--on-accent);
        padding: 0.6rem 1rem;
        border-radius: 8px;
        font-weight: 600;
      }
      .skip:focus {
        top: 1rem;
      }
    </style>
  </body>
</html>
